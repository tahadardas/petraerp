{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Petra ERP",
  "version": "0.1.0",
  "identifier": "com.petraerp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Petra ERP",
        "width": 1366,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "maximized": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: http: https: ws: wss:; connect-src * ipc: http://ipc.localhost https://localhost:17483"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PetraERP": ""
  },
  "Petra": {
    "Api": {
      "ExposeOpenApi": false,
      "RequireHttps": true,
      "MaxRequestBodyBytes": 1048576
    },
    "Database": {
      "CompatibilityLevel": 160,
      "CommandTimeoutSeconds": 30
    },
    "Security": {
      "Tokens": {
        "Issuer": "PetraERP",
        "Audience": "PetraERP.Clients",
        "SigningKey": "",
        "AccessTokenMinutes": 10,
        "RefreshTokenIdleHours": 8,
        "SessionAbsoluteHours": 12,
        "ClockSkewSeconds": 30
      },
      "Lockout": {
        "MaxFailedAttempts": 5,
        "LockoutMinutes": 15
      },
      "Passwords": {
        "Pbkdf2Iterations": 210000
      },
      "RateLimits": {
        "AuthenticationPermitsPerMinute": 10,
        "ApiPermitsPerMinute": 600
      }
    }
  }
}

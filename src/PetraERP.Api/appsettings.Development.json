{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "AllowedHosts": "localhost",
  "Petra": {
    "Api": {
      "ExposeOpenApi": true
    },
    // The approved deployment profile is SQL Server 2022 (major 16, compatibility level 160).
    "Database": {
      "CompatibilityLevel": 160
    }
  }
}

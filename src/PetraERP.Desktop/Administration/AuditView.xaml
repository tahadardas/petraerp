<UserControl x:Class="PetraERP.Desktop.Administration.AuditView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls" xmlns:loc="clr-namespace:PetraERP.Desktop.Localization">
 <UserControl.Resources><loc:StandardLabelConverter x:Key="StandardLabel"/><loc:UtcTextConverter x:Key="UtcText"/></UserControl.Resources>
 <DockPanel><ux:PageHeader DockPanel.Dock="Top" Title="{Binding DataContext.Localization[D_Audit], RelativeSource={RelativeSource AncestorType=Window}}"/> <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
  <StackPanel><TextBlock Text="{Binding DataContext.Localization[D_UserId], RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Width="240" Text="{Binding AuditUser, UpdateSourceTrigger=PropertyChanged}" MaxLength="36"/></StackPanel>
  <StackPanel Margin="6,0"><TextBlock Text="{Binding DataContext.Localization[D_EventType], RelativeSource={RelativeSource AncestorType=Window}}"/><ComboBox Width="190" ItemsSource="{Binding AuditTypes}" SelectedItem="{Binding AuditType}"><ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource StandardLabel}" ConverterParameter="D_Event_"><Binding/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
  <StackPanel><TextBlock Text="{Binding DataContext.Localization[D_FromUtc], RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Width="175" Text="{Binding AuditFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-ddTHH:mm:ssZ"/></StackPanel>
  <StackPanel Margin="6,0"><TextBlock Text="{Binding DataContext.Localization[D_ToUtc], RelativeSource={RelativeSource AncestorType=Window}}"/><TextBox Width="175" Text="{Binding AuditTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="yyyy-MM-ddTHH:mm:ssZ"/></StackPanel><Button Content="{Binding DataContext.Localization[D_Search], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SearchAuditCommand}"/>
<Button Content="{Binding DataContext.Localization[D_ClearFilters], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding ClearAuditFiltersCommand}"/> </WrapPanel>
 <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6"><Button Content="{Binding DataContext.Localization[D_Previous], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding PreviousAuditCommand}"/><TextBlock Text="{Binding AuditPageStatus}" Margin="8,0"/><Button Content="{Binding DataContext.Localization[D_Next], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding NextAuditCommand}"/></StackPanel>
 <TextBox DockPanel.Dock="Bottom" Text="{Binding SelectedAudit.Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,6"/>
 <DataGrid x:Name="AuditGrid" ux:GridLayouts.Key="system.audit" ux:GridLayouts.Store="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType=Window}}" ItemsSource="{Binding Audit}" SelectedItem="{Binding SelectedAudit}" IsReadOnly="True" CanUserSortColumns="False" SelectionUnit="FullRow"><DataGrid.Columns><DataGridTextColumn Binding="{Binding OccurredAtUtc, Converter={StaticResource UtcText}}" Width="190"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="FlowDirection" Value="LeftToRight"/></Style></DataGridTextColumn.ElementStyle><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_OccurredUtc], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTemplateColumn Width="210"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_EventType], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource StandardLabel}" ConverterParameter="D_Event_"><Binding Path="EventType"/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn SortMemberPath="UserNameSnapshot" Binding="{Binding UserNameSnapshot}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_UserName], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="Reason" Binding="{Binding Reason}" Width="230"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Reason], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Visibility="Collapsed" SortMemberPath="ActorUserId" Binding="{Binding ActorUserId}" Width="240"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ActorId], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Visibility="Collapsed" SortMemberPath="CompanyId" Binding="{Binding CompanyId}" Width="240"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_CompanyId], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Visibility="Collapsed" SortMemberPath="BranchId" Binding="{Binding BranchId}" Width="240"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_BranchId], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn Visibility="Collapsed" SortMemberPath="CorrelationId" Binding="{Binding CorrelationId}" Width="200"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Correlation], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
 </DockPanel>
</DockPanel>
</UserControl>

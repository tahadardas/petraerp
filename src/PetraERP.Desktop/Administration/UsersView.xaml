<UserControl x:Class="PetraERP.Desktop.Administration.UsersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <DockPanel><ux:PageHeader DockPanel.Dock="Top" Title="{Binding DataContext.Localization[D_Users], RelativeSource={RelativeSource AncestorType=Window}}"/> <ux:AdaptivePaneGrid><ux:AdaptivePaneGrid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="390" MinWidth="300"/></ux:AdaptivePaneGrid.ColumnDefinitions>
  <DockPanel ux:AdaptivePaneGrid.Label="{Binding DataContext.Localization[D_Users], RelativeSource={RelativeSource AncestorType=Window}}">
   <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"><TextBox ux:SearchTarget.IsTarget="True" Width="200" Text="{Binding UserSearch, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="{Binding DataContext.Localization[D_SearchUsers], RelativeSource={RelativeSource AncestorType=Window}}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchUsersCommand}"/></TextBox.InputBindings></TextBox><Button Content="{Binding DataContext.Localization[D_SearchUsers], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SearchUsersCommand}"/><Button Content="{Binding DataContext.Localization[D_Open], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenUserCommand}"/><Button Content="{Binding DataContext.Localization[D_NewUser], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding NewUserCommand}"/></WrapPanel>
   <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0"><Button Content="{Binding DataContext.Localization[D_Previous], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding PreviousUsersCommand}"/><TextBlock Text="{Binding UserPageStatus}" Margin="8,0"/><Button Content="{Binding DataContext.Localization[D_Next], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding NextUsersCommand}"/></StackPanel>
   <DataGrid x:Name="UsersGrid" ux:GridLayouts.Key="system.users" ux:GridLayouts.Store="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType=Window}}" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" IsReadOnly="True" CanUserSortColumns="False" SelectionUnit="FullRow"><DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenUserCommand}"/></DataGrid.InputBindings><DataGrid.Columns><DataGridTextColumn SortMemberPath="UserName" Binding="{Binding UserName}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_UserName], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="DisplayNameArabic" Binding="{Binding DisplayNameArabic}" Width="200"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ArabicName], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="DisplayNameEnglish" Binding="{Binding DisplayNameEnglish}" Width="170"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_EnglishName], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridCheckBoxColumn SortMemberPath="IsActive" Binding="{Binding IsActive}" Width="70"><DataGridCheckBoxColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Active], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn><DataGridCheckBoxColumn SortMemberPath="IsLockedOut" Binding="{Binding IsLockedOut}" Width="70"><DataGridCheckBoxColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Locked], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn><DataGridCheckBoxColumn SortMemberPath="MustChangePassword" Binding="{Binding MustChangePassword}" Width="100"><DataGridCheckBoxColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_PasswordRequired], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn></DataGrid.Columns></DataGrid>
  </DockPanel>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
  <Border ux:AdaptivePaneGrid.Label="{Binding DataContext.Localization[D_Details], RelativeSource={RelativeSource AncestorType=Window}}" ux:AdaptivePaneGrid.ActivateWhen="{Binding IsUserEditorOpen}" Grid.Column="2" Background="{DynamicResource Input}" Padding="12" CornerRadius="{DynamicResource Radius.Panel}"><ScrollViewer Visibility="{Binding IsUserEditorOpen, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{Binding DataContext.Localization[D_UserDetails], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Text.Section}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding DataContext.Localization[D_UserName], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding LoginName, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" IsReadOnly="{Binding IsExistingUser}"/>
   <TextBlock Text="{Binding DataContext.Localization[D_ArabicName], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding DisplayArabic, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/><TextBlock Text="{Binding DataContext.Localization[D_EnglishName], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding DisplayEnglish, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
   <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource Visible}}"><TextBlock Text="{Binding DataContext.Localization[D_TemporaryPassword], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><PasswordBox ux:PasswordInput.Value="{Binding TemporaryPassword}" MaxLength="128" AutomationProperties.Name="{Binding DataContext.Localization[D_TemporaryPassword], RelativeSource={RelativeSource AncestorType=Window}}"/></StackPanel>
   <Button Content="{Binding DataContext.Localization[D_SaveProfile], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveProfileCommand}"/>
   <StackPanel Visibility="{Binding IsExistingUser, Converter={StaticResource Visible}}">
    <TextBlock Text="{Binding UserState}" TextWrapping="Wrap" Margin="0,8"/>
    <TextBlock Text="{Binding DataContext.Localization[D_AssignedRoles], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,12,0,4"/>
    <ItemsControl ItemsSource="{Binding UserRoles}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,3"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="{Binding DataContext.Localization[D_SaveRoles], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveUserRolesCommand}"/>
    <TextBlock Text="{Binding DataContext.Localization[D_CompanyBranchScopes], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,12,0,4"/>
    <TextBlock Text="{Binding DataContext.Localization[D_ScopeHelp], RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}"/>
    <ItemsControl ItemsSource="{Binding Scopes}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,6">
     <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" FontWeight="SemiBold"/>
     <ItemsControl ItemsSource="{Binding Branches}" IsEnabled="{Binding IsSelected}" Margin="16,2,0,0"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button Content="{Binding DataContext.Localization[D_SaveScopes], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveScopesCommand}"/>
    <TextBlock Text="{Binding DataContext.Localization[D_Reason], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="52"/>
    <WrapPanel><Button Content="{Binding DataContext.Localization[D_ToggleStatus], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SetStatusCommand}"/><Button Content="{Binding DataContext.Localization[D_Unlock], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding UnlockCommand}"/><Button Content="{Binding DataContext.Localization[D_RevokeSessions], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RevokeCommand}"/></WrapPanel>
    <TextBlock Text="{Binding DataContext.Localization[D_TemporaryPassword], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,10,0,4"/><PasswordBox ux:PasswordInput.Value="{Binding TemporaryPassword}" MaxLength="128" AutomationProperties.Name="{Binding DataContext.Localization[D_TemporaryPassword], RelativeSource={RelativeSource AncestorType=Window}}"/><Button Content="{Binding DataContext.Localization[D_ResetPassword], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding ResetPasswordCommand}"/>
   </StackPanel>
  </StackPanel></ScrollViewer></Border>
 </ux:AdaptivePaneGrid>
</DockPanel>
</UserControl>

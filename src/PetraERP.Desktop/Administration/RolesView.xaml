<UserControl x:Class="PetraERP.Desktop.Administration.RolesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Visible"/></UserControl.Resources>
 <DockPanel><ux:PageHeader DockPanel.Dock="Top" Title="{Binding DataContext.Localization[D_Roles], RelativeSource={RelativeSource AncestorType=Window}}"/> <ux:AdaptivePaneGrid><ux:AdaptivePaneGrid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="8"/><ColumnDefinition Width="390" MinWidth="300"/></ux:AdaptivePaneGrid.ColumnDefinitions>
  <DockPanel ux:AdaptivePaneGrid.Label="{Binding DataContext.Localization[D_Roles], RelativeSource={RelativeSource AncestorType=Window}}"><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6"><Button Content="{Binding DataContext.Localization[D_Refresh], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding RefreshRolesCommand}"/><Button Content="{Binding DataContext.Localization[D_Open], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding OpenRoleCommand}"/><Button Content="{Binding DataContext.Localization[D_NewRole], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding NewRoleCommand}"/></WrapPanel>
   <DataGrid x:Name="RolesGrid" ux:GridLayouts.Key="system.roles" ux:GridLayouts.Store="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType=Window}}" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" IsReadOnly="True" SelectionUnit="FullRow"><DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenRoleCommand}"/></DataGrid.InputBindings><DataGrid.Columns><DataGridTextColumn SortMemberPath="Code" Binding="{Binding Code}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Code], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="NameArabic" Binding="{Binding NameArabic}" Width="210"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ArabicName], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="NameEnglish" Binding="{Binding NameEnglish}" Width="180"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_EnglishName], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="PermissionCount" Binding="{Binding PermissionCount}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_PermissionCount], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn><DataGridTextColumn SortMemberPath="UserCount" Binding="{Binding UserCount}" Width="90"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_UserCount], RelativeSource={RelativeSource AncestorType=Window}}"/></DataGridTextColumn.Header></DataGridTextColumn></DataGrid.Columns></DataGrid>
  </DockPanel><GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
  <Border ux:AdaptivePaneGrid.Label="{Binding DataContext.Localization[D_Details], RelativeSource={RelativeSource AncestorType=Window}}" ux:AdaptivePaneGrid.ActivateWhen="{Binding IsRoleEditorOpen}" Grid.Column="2" Style="{StaticResource Panel.Card}"><ScrollViewer Visibility="{Binding IsRoleEditorOpen, Converter={StaticResource Visible}}" VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock Text="{Binding DataContext.Localization[D_RoleDetails], RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource Text.Section}" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding DataContext.Localization[D_Code], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding RoleCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" IsEnabled="{Binding IsNewRole}"/><TextBlock Text="{Binding DataContext.Localization[D_ArabicName], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding RoleArabic, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/><TextBlock Text="{Binding DataContext.Localization[D_EnglishName], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,2"/><TextBox Text="{Binding RoleEnglish, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
   <TextBlock Text="{Binding DataContext.Localization[D_Permissions], RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="SemiBold" Margin="0,12,0,6"/>
   <ItemsControl ItemsSource="{Binding PermissionGroups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Label}" IsExpanded="True" Margin="0,4"><ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="8,3" ToolTip="{Binding Key}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <TextBlock Text="{Binding DataContext.Localization[D_PermissionHelp], RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,12"/><Button Content="{Binding DataContext.Localization[D_SaveRole], RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding SaveRoleCommand}"/>
  </StackPanel></ScrollViewer></Border>
 </ux:AdaptivePaneGrid>
</DockPanel>
</UserControl>

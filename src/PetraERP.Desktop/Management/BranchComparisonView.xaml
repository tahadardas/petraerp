<UserControl x:Class="PetraERP.Desktop.Management.BranchComparisonView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel Margin="16">
  <ux:PageHeader DockPanel.Dock="Top" Title="مقارنة الفروع — ميزان المراجعة">
   <ux:PageHeader.Commands><Button Style="{StaticResource Button.Command}" Content="عرض" Command="{Binding RunCommand}"/></ux:PageHeader.Commands>
  </ux:PageHeader>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0"/><ux:PetraDatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,12,0"/>
   <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0"/><ux:PetraDatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,12,0"/>
   <CheckBox Content="استبعاد التحويلات بين الفروع (يُظهر الفرق غير المتطابق)" IsChecked="{Binding Eliminate}" VerticalAlignment="Center"/>
  </WrapPanel>
  <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Branches}" Margin="0,0,0,8">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" Margin="0,0,16,0"/></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Border DockPanel.Dock="Top" Visibility="{Binding HasResidual, Converter={StaticResource Visible}}" Background="{DynamicResource Warning.Subtle}" Padding="10" Margin="0,0,0,8" CornerRadius="{DynamicResource Radius.Control}">
   <TextBlock Text="{Binding Residual, StringFormat=فرق غير مطابق في حسابات التحويل بين الفروع: {0}}" FontWeight="SemiBold"/>
  </Border>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
   <TextBlock Text="{Binding TotalDebit, StringFormat=إجمالي المدين: {0}}" Margin="0,0,24,0" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding TotalCredit, StringFormat=إجمالي الدائن: {0}}" FontWeight="SemiBold"/>
  </WrapPanel>
  <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" AutomationProperties.Name="ميزان الفروع">
   <DataGrid.Columns>
    <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="110"/>
    <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="*"/>
    <DataGridTextColumn Header="الفرع" Binding="{Binding Branch}" Width="90"/>
    <DataGridTextColumn Header="افتتاحي" Binding="{Binding Opening}" Width="120"/>
    <DataGridTextColumn Header="مدين" Binding="{Binding Debit}" Width="120"/>
    <DataGridTextColumn Header="دائن" Binding="{Binding Credit}" Width="120"/>
    <DataGridTextColumn Header="ختامي" Binding="{Binding Closing}" Width="120"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>

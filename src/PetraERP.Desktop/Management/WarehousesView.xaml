<UserControl x:Class="PetraERP.Desktop.Management.WarehousesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="Am.Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,3"/>
        </Style>
    </UserControl.Resources>
    <DockPanel Margin="6">
        <!-- Top Page Header -->
        <ux:PageHeader DockPanel.Dock="Top" Title="دليل وبطاقة المستودعات" Subtitle="إدارة المستودعات وحسابات المخزون ومراكز التكلفة المرتبطة">
            <ux:PageHeader.Commands>
                <WrapPanel>
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="جديد" Command="{Binding NewCommand}" ToolTip="Ctrl+N" Visibility="{Binding CanManage, Converter={StaticResource Visible}}" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="تحديث" Command="{Binding RefreshCommand}" ToolTip="F5"/>
                </WrapPanel>
            </ux:PageHeader.Commands>
        </ux:PageHeader>

        <!-- Main Body: Directory Grid (Left) + Warehouse Card (Right) -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="420" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Directory Pane (Left) -->
            <Border Grid.Column="0" Style="{StaticResource Panel.Flat}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource SubtleBackground}" Padding="8,6" Margin="0,0,0,6" CornerRadius="{DynamicResource Radius.Control}">
                        <DockPanel>
                            <TextBlock Text="قائمة المستودعات المعرفة" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Warehouses.Count, StringFormat='({0} مستودع)'}" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </DockPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding Warehouses}" SelectedItem="{Binding SelectedWarehouse}"
                              IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False"
                              SelectionUnit="FullRow" BorderThickness="0" ux:GridRowNumbers.Enabled="True"
                              AutomationProperties.Name="دليل المستودعات">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرمز" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="اسم المستودع" Binding="{Binding NameArabic}" Width="*"/>
                            <DataGridTextColumn Header="الموقع" Binding="{Binding Location}" Width="*"/>
                            <DataGridCheckBoxColumn Header="فعّال" Binding="{Binding IsActive, Mode=OneWay}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- Warehouse Card Editor (Right) -->
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="10">
                <DockPanel>
                    <!-- Card Top Header -->
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,0,0,8" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Border Background="{DynamicResource AccentBackground}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2" Visibility="{Binding IsExisting, Converter={StaticResource Visible}}" Margin="0,0,4,0">
                                    <TextBlock Text="مستودع مسجل" Foreground="{DynamicResource AccentForeground}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource SubtleBackground}" CornerRadius="{DynamicResource Radius.Small}" Padding="6,2" Visibility="{Binding IsExisting, Converter={StaticResource Show}, ConverterParameter=invert}">
                                    <TextBlock Text="مستودع جديد" Foreground="{DynamicResource TextMuted}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/>
                                <TextBlock Text="بطاقة المستودع" Style="{StaticResource Text.Section}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Bottom Command Bar (Al-Ameen style) -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="حفظ" Command="{Binding SaveCommand}" Style="{StaticResource Button.Primary}" MinWidth="76" Margin="0,0,6,0" ToolTip="Ctrl+S" Visibility="{Binding CanManage, Converter={StaticResource Visible}}"/>
                                <Button Content="جديد" Command="{Binding NewCommand}" MinWidth="76" Margin="0,0,6,0" ToolTip="Ctrl+N" Visibility="{Binding CanManage, Converter={StaticResource Visible}}"/>
                                <Button Content="تحديث" Command="{Binding RefreshCommand}" MinWidth="76" Margin="0,0,6,0" ToolTip="F5"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Card Body -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Master Fields (Al-Ameen Structured Grid) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="الرمز *" Style="{StaticResource Am.Label}"/>
                                <TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditCode}" MaxLength="32" FlowDirection="LeftToRight" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Text="الاسم العربي *" Style="{StaticResource Am.Label}"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NameArabic, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Text="الاسم اللاتيني" Style="{StaticResource Am.Label}"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NameEnglish, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" FlowDirection="LeftToRight" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Text="المستودع الأب" Style="{StaticResource Am.Label}"/>
                                <ux:LookupPicker Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ParentOptions}" SelectedId="{Binding ParentWarehouseId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="بدون مستودع رئيسي" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Text="الموقع الجغرافي" Style="{StaticResource Am.Label}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" Margin="0,2"/>
                            </Grid>

                            <!-- Accounting & Defaults Tabs -->
                            <TabControl Margin="0,4,0,0" Visibility="{Binding IsExisting, Converter={StaticResource Visible}}">
                                <!-- Tab 1: Accounting Accounts -->
                                <TabItem Header="الحسابات المحاسبية">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="حساب المخزون التابع للمستودع" Style="{StaticResource Text.Label}" Margin="0,4,0,2"/>
                                        <ux:LookupPicker ItemsSource="{Binding Accounts}" SelectedId="{Binding InventoryAccountId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="حساب المخزون (اختياري)" Margin="0,0,0,8"/>

                                        <TextBlock Text="حساب البضاعة في الطريق" Style="{StaticResource Text.Label}" Margin="0,4,0,2"/>
                                        <ux:LookupPicker ItemsSource="{Binding Accounts}" SelectedId="{Binding InTransitAccountId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="حساب البضاعة في الطريق (اختياري)" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- Tab 2: Centers & Policies -->
                                <TabItem Header="مراكز التكلفة">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="مركز التكلفة الافتراضي للمستودع" Style="{StaticResource Text.Label}" Margin="0,4,0,2"/>
                                        <ux:LookupPicker ItemsSource="{Binding CostCenters}" SelectedId="{Binding DefaultCostCenterId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="مركز التكلفة الافتراضي (اختياري)" Margin="0,0,0,8"/>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

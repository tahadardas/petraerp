<UserControl x:Class="PetraERP.Desktop.Management.DocumentNumbersView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel Margin="16">
  <ux:PageHeader DockPanel.Dock="Top" Title="صيانة ترقيم المستندات">
   <ux:PageHeader.Commands><WrapPanel>
    <Button Style="{StaticResource Button.Command}" Content="التحقق من سلسلة التدقيق" Command="{Binding VerifyCommand}" Margin="0,0,8,0"/>
    <Button Style="{StaticResource Button.Command}" Content="تحديث" Command="{Binding RefreshCommand}"/>
   </WrapPanel></ux:PageHeader.Commands>
  </ux:PageHeader>
  <TextBlock DockPanel.Dock="Top" Text="{Binding ChainStatus}" FontWeight="SemiBold" Margin="0,0,0,6"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <GroupBox Header="طلب تغيير رقم (يتطلب موافقة شخص ثانٍ — لا يتغير المعرّف الداخلي ولا القيد)">
    <StackPanel>
     <WrapPanel>
      <StackPanel Margin="4"><TextBlock Text="نوع المستند"/><ComboBox Width="160" ItemsSource="{Binding Families}" SelectedItem="{Binding Family}"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="رقم المستند يحتوي"/><TextBox Width="160" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="من تاريخ"/><ux:PetraDatePicker SelectedDate="{Binding SearchFrom}" Width="120"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="إلى تاريخ"/><ux:PetraDatePicker SelectedDate="{Binding SearchTo}" Width="120"/></StackPanel>
      <Button Style="{StaticResource Button.Command}" Content="بحث عن المستند" Command="{Binding FindCommand}" VerticalAlignment="Bottom" Margin="4"/>
      <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Bottom" Margin="4,0,4,8"/>
      <StackPanel Margin="4"><TextBlock Text="الرقم الجديد"/><TextBox Width="160" Text="{Binding NewNumber, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="السبب / قرار الموافقة"/><TextBox Width="300" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
     </WrapPanel>
     <DataGrid ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedDocument}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="170" Margin="4" EnableRowVirtualization="True" AutomationProperties.Name="نتائج البحث عن المستند">
      <DataGrid.Columns>
       <DataGridTextColumn Header="الرقم" Binding="{Binding Number}" Width="140"/>
       <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="110"/>
       <DataGridTextColumn Header="الطرف" Binding="{Binding Party}" Width="*"/>
       <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="110"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Margin="4">
      <Button Style="{StaticResource Button.Command}" Content="معاينة" Command="{Binding PreviewCommand}" Margin="0,0,8,0"/>
      <Button Style="{StaticResource Button.Command}" Content="إرسال الطلب" Command="{Binding RequestCommand}"/>
     </WrapPanel>
     <StackPanel Visibility="{Binding HasPreview, Converter={StaticResource Visible}}" Margin="4">
      <TextBlock><Run Text="الرقم الحالي: "/><Run Text="{Binding Preview.CurrentNumber, Mode=OneWay}" FontWeight="Bold"/><Run Text="  ←  المقترح: "/><Run Text="{Binding Preview.ProposedNumber, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
      <TextBlock Text="{Binding Preview.BlockingCode, StringFormat=سبب المنع: {0}}" Foreground="{DynamicResource Danger}"/>
      <DataGrid ItemsSource="{Binding Preview.Collisions}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="120">
       <DataGrid.Columns>
        <DataGridTextColumn Header="تعارض مع" Binding="{Binding Family}" Width="140"/>
        <DataGridTextColumn Header="المستند" Binding="{Binding DocumentId}" Width="*"/>
        <DataGridTextColumn Header="النوع" Binding="{Binding Kind}" Width="140"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </StackPanel>
   </GroupBox>
   <GroupBox Header="الطلبات">
    <StackPanel>
     <DataGrid ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="260">
      <DataGrid.Columns>
       <DataGridTextColumn Header="النوع" Binding="{Binding Family}" Width="120"/>
       <DataGridTextColumn Header="القديم" Binding="{Binding OldNumber}" Width="110"/>
       <DataGridTextColumn Header="الجديد" Binding="{Binding NewNumber}" Width="110"/>
       <DataGridTextColumn Header="الحالة" Binding="{Binding State}" Width="90"/>
       <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
       <DataGridTextColumn Header="تاريخ الطلب" Binding="{Binding RequestedAtUtc}" Width="170"/>
      </DataGrid.Columns>
     </DataGrid>
     <WrapPanel Margin="4">
      <Button Style="{StaticResource Button.Financial}" Content="موافقة" Command="{Binding ApproveCommand}" Margin="0,0,8,0"/>
      <Button Style="{StaticResource Button.Command}" Content="رفض" Command="{Binding RejectCommand}" Margin="0,0,8,0"/>
      <Button Style="{StaticResource Button.Command}" Content="إلغاء الطلب" Command="{Binding CancelCommand}"/>
     </WrapPanel>
    </StackPanel>
   </GroupBox>
   <GroupBox Header="سجل التدقيق (سلسلة تجزئة، للقراءة فقط)">
    <DataGrid ItemsSource="{Binding Audit}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="260">
     <DataGrid.Columns>
      <DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="60"/>
      <DataGridTextColumn Header="النوع" Binding="{Binding Family}" Width="120"/>
      <DataGridTextColumn Header="القديم" Binding="{Binding OldNumber}" Width="100"/>
      <DataGridTextColumn Header="الجديد" Binding="{Binding NewNumber}" Width="100"/>
      <DataGridTextColumn Header="التاريخ" Binding="{Binding OccurredAtUtc}" Width="170"/>
      <DataGridTextColumn Header="التجزئة" Binding="{Binding Hash}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </GroupBox>
  </StackPanel></ScrollViewer>
 </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Management.BankReconciliationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.InputBindings>
  <KeyBinding Key="Space" Command="{Binding ToggleCommand}"/>
 </UserControl.InputBindings>
 <DockPanel>
  <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[BKR_Title]}" Subtitle="{Binding AccountTitle}"/>
  <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Filter}" Visibility="{Binding IsOpen, Converter={StaticResource Show}, ConverterParameter=invert}">
   <WrapPanel>
    <StackPanel Margin="0,0,8,0" Width="300"><TextBlock Text="{Binding Localization[D_Account]}" Style="{StaticResource Text.Label}"/>
     <ux:PetraAccountPicker ItemsSource="{Binding Lookups.Accounts}" SelectedId="{Binding AccountId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="{Binding Localization[D_LookupHint]}" AutomationProperties.Name="{Binding Localization[D_Account]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Localization[BKR_StatementDate]}" Style="{StaticResource Text.Label}"/><ux:PetraDatePicker Width="130" SelectedDate="{Binding StatementDate}" AutomationProperties.Name="{Binding Localization[BKR_StatementDate]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Localization[BKR_StatementBalance]}" Style="{StaticResource Text.Label}"/><TextBox Width="150" FlowDirection="LeftToRight" Text="{Binding StatementBalanceText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localization[BKR_StatementBalance]}"/></StackPanel>
    <Button Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE768;" Content="{Binding Localization[BKR_Open]}" Command="{Binding OpenCommand}" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </Border>
  <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="-4,0,-4,8" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
   <Border Style="{StaticResource Panel.Card}" Margin="4" Padding="10,6"><StackPanel><TextBlock Text="{Binding Localization[BKR_StatementBalance]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Statement}" FlowDirection="LeftToRight" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Style="{StaticResource Panel.Card}" Margin="4" Padding="10,6"><StackPanel><TextBlock Text="{Binding Localization[BKR_PriorCleared]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding PriorCleared}" FlowDirection="LeftToRight" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Style="{StaticResource Panel.Card}" Margin="4" Padding="10,6"><StackPanel><TextBlock Text="{Binding Localization[BKR_ClearedNow]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding ClearedNow}" FlowDirection="LeftToRight" FontWeight="SemiBold"/></StackPanel></Border>
   <Border Style="{StaticResource Panel.Card}" Margin="4" Padding="10,6" Background="{DynamicResource Accent.Subtle}" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"><StackPanel><TextBlock Text="{Binding Localization[BKR_Difference]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding Difference}" FlowDirection="LeftToRight" FontWeight="Bold"/></StackPanel></Border>
  </UniformGrid>
  <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[BKR_Toggle]}" Command="{Binding ToggleCommand}" Margin="0,0,8,0"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[BKR_ClearAll]}" Command="{Binding ClearAllCommand}" Margin="0,0,8,0"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[BKR_UnclearAll]}" Command="{Binding UnclearAllCommand}" Margin="0,0,8,0"/>
   <Button Style="{StaticResource Button.Primary}" Content="{Binding Localization[BKR_Complete]}" Command="{Binding CompleteCommand}" Margin="0,0,8,0"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[BKR_Discard]}" Command="{Binding DiscardCommand}" Margin="0,0,8,0"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[BKR_Close]}" Command="{Binding CloseCommand}"/>
   <TextBlock Text="{Binding Localization[BKR_Hint]}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
  </WrapPanel>
  <Border Style="{StaticResource Panel.Flat}">
   <Grid>
    <ux:EmptyState Glyph="&#xE82D;" Title="{Binding Localization[BKR_Empty]}" Visibility="{Binding IsOpen, Converter={StaticResource Show}, ConverterParameter=invert}"/>
    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow" EnableRowVirtualization="True"
              AutomationProperties.Name="{Binding Localization[BKR_Title]}" Visibility="{Binding IsOpen, Converter={StaticResource Visible}}">
     <DataGrid.Columns>
      <DataGridCheckBoxColumn Binding="{Binding Cleared, Mode=OneWay}" IsReadOnly="True" Width="60"><DataGridCheckBoxColumn.Header><TextBlock Text="{Binding DataContext.Localization[BKR_Cleared], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridCheckBoxColumn.Header></DataGridCheckBoxColumn>
      <DataGridTextColumn Binding="{Binding Line.AccountingDate, Converter={StaticResource DateText}}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Date], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Line.PostingSequence}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_JournalNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Line.Description}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Description], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Line.Amount}" Width="130"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[BKR_Amount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Border>
 </DockPanel>
</UserControl>

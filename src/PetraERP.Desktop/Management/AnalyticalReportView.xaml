<UserControl x:Class="PetraERP.Desktop.Management.AnalyticalReportView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel Margin="16">
  <ux:PageHeader DockPanel.Dock="Top" Title="التقارير التحليلية">
   <ux:PageHeader.Commands><WrapPanel>
    <Button Style="{StaticResource Button.Financial}" Content="عرض التقرير" Command="{Binding RunCommand}" Margin="0,0,8,0"/>
    <Button Style="{StaticResource Button.Command}" Content="تصدير (CSV / Excel / PDF)" Click="ExportClicked" Margin="0,0,8,0"/>
    <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[UI_SaveFilter]}" Command="{Binding SaveFilterCommand}" ToolTip="{Binding Localization[UI_SaveFilterHelp]}"/>
   </WrapPanel></ux:PageHeader.Commands>
  </ux:PageHeader>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock Text="التقرير:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ComboBox Width="260" ItemsSource="{Binding Reports}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedReport}" Margin="0,0,16,0"/>
   <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ux:PetraDatePicker SelectedDate="{Binding FromDate}" Width="130" Margin="0,0,16,0"/>
   <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ux:PetraDatePicker SelectedDate="{Binding ToDate}" Width="130" Margin="0,0,16,0"/>
   <TextBlock Text="العملة:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox Width="70" MaxLength="3" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,16,0"/>
   <TextBlock Text="معرّف الحساب (اختياري):" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox Width="300" Text="{Binding AccountIdText, UpdateSourceTrigger=PropertyChanged}"/>
  </WrapPanel>
  <TextBlock DockPanel.Dock="Top" Text="{Binding Validation}" Foreground="Firebrick" Margin="0,0,0,4"/>
  <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="Bold" FontSize="16" Margin="0,0,0,4"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding NotesText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding TotalsText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
  <DataGrid x:Name="ResultGrid" ItemsSource="{Binding Table}" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"
            AutoGeneratingColumn="ColumnGenerating" ux:GridLayouts.Key="reports.analytical" ux:GridLayouts.Store="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="نتيجة التقرير التحليلي"/>
 </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Management.BranchesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel Margin="16">
  <ux:PageHeader DockPanel.Dock="Top" Title="إدارة الفروع">
   <ux:PageHeader.Commands><WrapPanel>
    <Button Style="{StaticResource Button.Command}" Content="جديد" Command="{Binding NewCommand}" Margin="0,0,8,0"/>
    <Button Style="{StaticResource Button.Command}" Content="تحديث" Command="{Binding RefreshCommand}"/>
   </WrapPanel></ux:PageHeader.Commands>
  </ux:PageHeader>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
   <DataGrid Grid.Column="0" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,12,0" AutomationProperties.Name="شجرة الفروع">
    <DataGrid.Columns>
     <DataGridTextColumn Header="الفرع" Binding="{Binding DisplayName}" Width="*"/>
     <DataGridTextColumn Header="الرمز" Binding="{Binding Card.Code}" Width="90"/>
     <DataGridCheckBoxColumn Header="فعّال" Binding="{Binding Card.IsActive, Mode=OneWay}" Width="60"/>
    </DataGrid.Columns>
   </DataGrid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <GroupBox Header="بطاقة الفرع">
     <StackPanel>
      <WrapPanel>
       <StackPanel Margin="4"><TextBlock Text="الرمز"/><TextBox Width="110" MaxLength="32" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="الاسم العربي"/><TextBox Width="220" MaxLength="200" Text="{Binding NameArabic, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="الاسم الإنكليزي"/><TextBox Width="200" MaxLength="200" Text="{Binding NameEnglish, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="الفرع الأب"/>
        <ComboBox Width="220" ItemsSource="{Binding Branches}" DisplayMemberPath="DisplayName" SelectedValuePath="Card.Id" SelectedValue="{Binding ParentBranchId}"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="بادئة الترقيم"/><TextBox Width="90" MaxLength="16" Text="{Binding NumberPrefix, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="الهاتف"/><TextBox Width="140" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="البريد"/><TextBox Width="200" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="العنوان"/><TextBox Width="320" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      </WrapPanel>
      <StackPanel Margin="4"><TextBlock Text="ملاحظات"/><TextBox Height="48" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Margin="4"><TextBlock Text="سبب التعديل (إلزامي عند التعديل أو التفعيل أو الربط)"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <WrapPanel Margin="4">
       <Button Style="{StaticResource Button.Command}" Content="حفظ" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
       <Button Style="{StaticResource Button.Command}" Content="تفعيل / تعطيل" Command="{Binding ToggleActiveCommand}"/>
      </WrapPanel>
     </StackPanel>
    </GroupBox>
    <GroupBox Header="ربط حسابات الفرع (بتاريخ نفاذ، التاريخ السابق محفوظ)">
     <StackPanel>
      <DataGrid ItemsSource="{Binding Links}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200">
       <DataGrid.Columns>
        <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="140"/>
        <DataGridTextColumn Header="الحساب" Binding="{Binding AccountCode}" Width="110"/>
        <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountNameArabic}" Width="*"/>
        <DataGridTextColumn Header="من" Binding="{Binding EffectiveFrom}" Width="100"/>
        <DataGridTextColumn Header="إلى" Binding="{Binding EffectiveTo}" Width="100"/>
       </DataGrid.Columns>
      </DataGrid>
      <WrapPanel Margin="0,6,0,0">
       <ComboBox Width="160" ItemsSource="{Binding Roles}" SelectedItem="{Binding LinkRole}" Margin="0,0,8,0"/>
       <ux:LookupPicker Width="260" ItemsSource="{Binding Accounts}" SelectedId="{Binding LinkAccountId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="الحساب" Margin="0,0,8,0"/>
       <ux:PetraDatePicker SelectedDate="{Binding LinkEffectiveFrom}" Width="130" Margin="0,0,8,0"/>
       <Button Style="{StaticResource Button.Command}" Content="حفظ الربط" Command="{Binding SaveLinkCommand}" Margin="0,0,8,0"/>
      </WrapPanel>
      <WrapPanel Margin="0,6,0,0">
       <TextBlock Text="الفرع النموذجي:" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <ComboBox Width="220" ItemsSource="{Binding Branches}" DisplayMemberPath="DisplayName" SelectedValuePath="Card.Id" SelectedValue="{Binding ModelBranchId}" Margin="0,0,8,0"/>
       <Button Style="{StaticResource Button.Command}" Content="معاينة الحسابات الفرعية" Command="{Binding PreviewSubAccountsCommand}" Margin="0,0,8,0"/>
       <Button Style="{StaticResource Button.Financial}" Content="إنشاء الحسابات الفرعية وربطها" Command="{Binding ApplySubAccountsCommand}"/>
      </WrapPanel>
      <TextBlock Text="{Binding ApplyResult}" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <DataGrid ItemsSource="{Binding SubAccountPlan}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="180" Margin="0,6,0,0">
       <DataGrid.Columns>
        <DataGridTextColumn Header="الدور" Binding="{Binding Role}" Width="140"/>
        <DataGridTextColumn Header="الحساب الأم" Binding="{Binding ParentCode}" Width="110"/>
        <DataGridTextColumn Header="الرمز المقترح" Binding="{Binding SuggestedCode}" Width="120"/>
        <DataGridTextColumn Header="الاسم" Binding="{Binding NameArabic}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </StackPanel>
    </GroupBox>
   </StackPanel></ScrollViewer>
  </Grid>
 </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Management.InterCompanyView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel Margin="16">
  <ux:PageHeader DockPanel.Dock="Top" Title="مطابقة الحسابات بين الشركات">
   <ux:PageHeader.Commands><Button Style="{StaticResource Button.Command}" Content="تحديث" Command="{Binding RefreshCommand}"/></ux:PageHeader.Commands>
  </ux:PageHeader>
  <GroupBox DockPanel.Dock="Top" Header="روابط الشركات (مطابقة برمز الحساب لا بالمعرّف)">
   <StackPanel>
    <DataGrid ItemsSource="{Binding Links}" SelectedItem="{Binding SelectedLink}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="150">
     <DataGrid.Columns>
      <DataGridTextColumn Header="الشركة المقابلة" Binding="{Binding CounterpartyCompanyName}" Width="*"/>
      <DataGridTextColumn Header="حسابنا" Binding="{Binding AccountCode}" Width="110"/>
      <DataGridTextColumn Header="حسابهم" Binding="{Binding CounterpartyAccountCode}" Width="110"/>
      <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyCode}" Width="80"/>
      <DataGridCheckBoxColumn Header="فعّال" Binding="{Binding IsActive, Mode=OneWay}" Width="60"/>
     </DataGrid.Columns>
    </DataGrid>
    <WrapPanel Margin="0,6,0,0">
     <TextBox Width="300" ux:Watermark.Text="معرّف الشركة المقابلة (GUID)" Text="{Binding CounterpartyCompanyIdText, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,8,0"/>
     <TextBox Width="110" ux:Watermark.Text="حسابنا" Text="{Binding AccountCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,8,0"/>
     <TextBox Width="110" ux:Watermark.Text="حسابهم" Text="{Binding CounterpartyAccountCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,8,0"/>
     <TextBox Width="70" ux:Watermark.Text="العملة" Text="{Binding CurrencyCode, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="0,0,8,0"/>
     <TextBox Width="200" ux:Watermark.Text="ملاحظة" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
     <Button Style="{StaticResource Button.Command}" Content="حفظ الرابط" Command="{Binding SaveCommand}" Margin="0,0,8,0"/>
     <Button Style="{StaticResource Button.Command}" Content="تفعيل / تعطيل" Command="{Binding ToggleActiveCommand}"/>
    </WrapPanel>
   </StackPanel>
  </GroupBox>
  <WrapPanel DockPanel.Dock="Top" Margin="0,8">
   <TextBlock Text="حتى تاريخ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <ux:PetraDatePicker SelectedDate="{Binding AsOf}" Width="130" Margin="0,0,12,0"/>
   <Button Style="{StaticResource Button.Financial}" Content="مطابقة" Command="{Binding ReconcileCommand}" Margin="0,0,16,0"/>
   <TextBlock Text="{Binding DifferenceLabel}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
   <TextBlock Text="{Binding MatchingLabel}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
  </WrapPanel>
  <Grid Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <GroupBox Header="{Binding Result.ThisSide.Balance, StringFormat=شركتنا — الرصيد: {0}}" Margin="0,0,6,0">
    <DataGrid ItemsSource="{Binding ThisMovements}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="100"/>
      <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
      <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="120"/>
     </DataGrid.Columns>
    </DataGrid>
   </GroupBox>
   <GroupBox Grid.Column="1" Header="{Binding Result.CounterpartySide.Balance, StringFormat=الشركة المقابلة — الرصيد: {0}}" Margin="6,0,0,0">
    <DataGrid ItemsSource="{Binding CounterpartyMovements}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="التاريخ" Binding="{Binding Date}" Width="100"/>
      <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
      <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount}" Width="120"/>
     </DataGrid.Columns>
    </DataGrid>
   </GroupBox>
  </Grid>
 </DockPanel>
</UserControl>

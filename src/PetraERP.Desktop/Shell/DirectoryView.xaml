<UserControl x:Class="PetraERP.Desktop.Shell.DirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.InputBindings>
  <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
  <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
 </UserControl.InputBindings>
 <DockPanel>
  <!-- Al-Ameen directory: search line, then the group tree beside the cards of the selected group. -->
  <ux:PetraSearchBox DockPanel.Dock="Top" Margin="0,0,0,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Placeholder="{Binding SearchHint}" AutomationProperties.Name="{Binding SearchHint}"/>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
   <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}" ToolTip="F5"/>
   <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE8A7;" Content="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}" ToolTip="Enter"/>
   <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0"/>
  </StackPanel>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Panel.Flat}">
    <TreeView x:Name="GroupTree" ItemsSource="{Binding Roots}" BorderThickness="0" SelectedItemChanged="GroupSelected"
              AutomationProperties.Name="{Binding Title}">
     <TreeView.ItemContainerStyle>
      <Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style>
     </TreeView.ItemContainerStyle>
     <TreeView.ItemTemplate>
      <HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding Caption}"/></HierarchicalDataTemplate>
     </TreeView.ItemTemplate>
    </TreeView>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Panel.Flat}">
    <ListBox x:Name="CardList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" BorderThickness="0"
             MouseDoubleClick="CardOpened" AutomationProperties.Name="{Binding RowsCaption}">
     <ListBox.ContextMenu>
      <ContextMenu>
       <MenuItem Header="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}" InputGestureText="Enter"/>
       <MenuItem Header="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}" InputGestureText="F5"/>
      </ContextMenu>
     </ListBox.ContextMenu>
     <ListBox.ItemTemplate>
      <DataTemplate><TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis"/></DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Shell.ItemLimitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.InputBindings>
  <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
  <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
 </UserControl.InputBindings>
 <DockPanel>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <RadioButton Content="{Binding Localization[D_All]}" IsChecked="{Binding Filter, Converter={StaticResource Equal}, ConverterParameter=all, Mode=TwoWay}"
                Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" Margin="0,0,4,0"/>
   <RadioButton Content="{Binding Localization[D_ItemLimitsBelow]}" IsChecked="{Binding Filter, Converter={StaticResource Equal}, ConverterParameter=below, Mode=TwoWay}"
                Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" Margin="0,0,4,0"/>
   <RadioButton Content="{Binding Localization[D_ItemLimitsAbove]}" IsChecked="{Binding Filter, Converter={StaticResource Equal}, ConverterParameter=above, Mode=TwoWay}"
                Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" Margin="0,0,12,0"/>
   <ux:PetraSearchBox Width="200" Margin="0,0,8,0" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Placeholder="{Binding Localization[D_Search]}"/>
   <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}" ToolTip="F5"/>
   <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE8A7;" Content="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}" ToolTip="Enter"/>
  </WrapPanel>
  <TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="4,6,4,0"/>
  <Border Style="{StaticResource Panel.Flat}">
   <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" IsReadOnly="True" SelectionUnit="FullRow" AutoGenerateColumns="False" BorderThickness="0"
             MouseDoubleClick="RowOpened" AutomationProperties.Name="{Binding Localization[D_ItemLimits]}">
    <DataGrid.Columns>
     <DataGridTextColumn Binding="{Binding Code}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Code], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     <DataGridTextColumn Binding="{Binding Name}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Name], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     <DataGridTextColumn Binding="{Binding StockText}" Width="100" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ItemLimitsStock], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     <DataGridTextColumn Binding="{Binding MinimumText}" Width="90" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ItemLimitsMin], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     <DataGridTextColumn Binding="{Binding MaximumText}" Width="90" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ItemLimitsMax], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    </DataGrid.Columns>
    <DataGrid.RowStyle>
     <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
      <Style.Triggers>
       <DataTrigger Binding="{Binding BelowMinimum}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Error}"/></DataTrigger>
       <DataTrigger Binding="{Binding AboveMaximum}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
      </Style.Triggers>
     </Style>
    </DataGrid.RowStyle>
   </DataGrid>
  </Border>
 </DockPanel>
</UserControl>

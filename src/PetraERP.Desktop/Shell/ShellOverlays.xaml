<UserControl x:Class="PetraERP.Desktop.Shell.ShellOverlays" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls" xmlns:shell="clr-namespace:PetraERP.Desktop.Shell" xmlns:workspaces="clr-namespace:PetraERP.Desktop.Workspaces">
 <Grid PreviewKeyDown="OverlayKeyDown">
  <!-- Notifications: non-blocking; success/info dismiss themselves, warnings/errors stay until dismissed. -->
  <ItemsControl ItemsSource="{Binding Notifications.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16,16,16,36" Width="380" Focusable="False">
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border Style="{StaticResource Panel.Card}" Background="{DynamicResource Surface.Raised}" Margin="0,6,0,0" Padding="12,10" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="{Binding Message}" Effect="{StaticResource Elevation.1}">
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="{DynamicResource Font.Caption}" VerticalAlignment="Top" AutomationProperties.Name="{Binding DataContext.Localization[D_Dismiss], RelativeSource={RelativeSource AncestorType=UserControl}}"
              Command="{Binding DataContext.Notifications.DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
      <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,1,10,0" Text="&#xE946;" Foreground="{DynamicResource Info}"/>
      <StackPanel>
       <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
        <Border Background="{DynamicResource Neutral.Subtle}" CornerRadius="{DynamicResource Radius.Badge}" Padding="6,0" Margin="6,0,0,0" Visibility="{Binding IsRepeated, Converter={StaticResource Visible}}">
         <TextBlock Text="{Binding CountText}" FontSize="{DynamicResource Font.Caption}" FlowDirection="LeftToRight"/></Border></StackPanel>
       <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"/>
       <Button Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Margin="-6,4,0,0" Content="{Binding ActionLabel}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}"
               Command="{Binding DataContext.Notifications.InvokeActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
       <Expander Header="{Binding DataContext.Localization[D_TechnicalDetails], RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,4,0,0" FontSize="{DynamicResource Font.Caption}"
                 Visibility="{Binding HasDetails, Converter={StaticResource Visible}}">
        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FlowDirection="LeftToRight" BorderThickness="0" Background="Transparent"/>
       </Expander>
      </StackPanel>
     </DockPanel>
    </Border>
    <DataTemplate.Triggers>
     <DataTrigger Binding="{Binding Kind}" Value="Success"><Setter TargetName="Glyph" Property="Text" Value="&#xE930;"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Success}"/></DataTrigger>
     <DataTrigger Binding="{Binding Kind}" Value="Warning"><Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
     <DataTrigger Binding="{Binding Kind}" Value="Error"><Setter TargetName="Glyph" Property="Text" Value="&#xEA39;"/><Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Error}"/></DataTrigger>
    </DataTemplate.Triggers>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>

  <!-- Notification history panel (bell in the top bar). Newest first; nothing here is sent anywhere. -->
  <Border Style="{StaticResource Panel.Card}" Background="{DynamicResource Surface.Raised}" Effect="{StaticResource Elevation.2}" Width="380" MaxHeight="460" Padding="0" Margin="12,52,12,12"
          HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding Notifications.IsPanelOpen, Converter={StaticResource Visible}}" AutomationProperties.Name="{Binding Localization[UI_Notifications]}">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="12,8">
     <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="{DynamicResource Font.Caption}" Command="{Binding Notifications.TogglePanelCommand}" AutomationProperties.Name="{Binding Localization[D_Dismiss]}"/>
     <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="{Binding Localization[UI_ClearHistory]}" Command="{Binding Notifications.ClearHistoryCommand}"/>
     <TextBlock Text="{Binding Localization[UI_Notifications]}" Style="{StaticResource Text.Section}" Margin="0"/>
    </DockPanel>
    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}"/>
    <Grid>
     <ux:EmptyState Glyph="&#xEA8F;" Title="{Binding Localization[UI_NoNotifications]}" Visibility="{Binding Notifications.History.Count, Converter={StaticResource Show}, ConverterParameter=invert}"/>
     <ListBox ItemsSource="{Binding Notifications.History}" Background="Transparent" Margin="4" AutomationProperties.Name="{Binding Localization[UI_Notifications]}">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4,4">
       <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" Margin="8,0,0,0" VerticalAlignment="Top"/>
       <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}"/></StackPanel>
      </DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </DockPanel>
  </Border>

  <!-- Command palette -->
  <Grid Background="{DynamicResource Overlay}" Visibility="{Binding Palette.IsOpen, Converter={StaticResource Visible}}" MouseLeftButtonDown="PaletteScrimClicked">
   <Border Style="{StaticResource Panel.Card}" Background="{DynamicResource Surface.Raised}" MaxWidth="640" MaxHeight="480" VerticalAlignment="Top" Margin="12,56,12,12" Padding="0" KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="StopClick" Effect="{StaticResource Elevation.2}">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="12,10">
      <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="&#xE721;" Margin="0,0,10,0"/>
      <TextBlock DockPanel.Dock="Right" Text="Esc" Style="{StaticResource Text.Caption}"/>
      <TextBox x:Name="PaletteBox" Text="{Binding Palette.Query, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontSize="{StaticResource Font.Subtitle}"
               AutomationProperties.Name="{Binding Localization[D_SearchPlaceholder]}" PreviewKeyDown="PaletteKeyDown"/>
     </DockPanel>
     <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}"/>
     <TextBlock DockPanel.Dock="Bottom" Text="{Binding Localization[D_PaletteHelp]}" Style="{StaticResource Text.Caption}" Margin="12,6"/>
     <ListBox x:Name="PaletteList" PreviewKeyDown="PaletteKeyDown" ItemsSource="{Binding Palette.Entries}" SelectedItem="{Binding Palette.Selected}" Margin="4" MouseDoubleClick="PaletteInvoked" AutomationProperties.Name="{Binding Localization[D_Palette]}">
      <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="4,3">
       <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" Text="{Binding Glyph}" Width="26"/>
       <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="12,0,0,0"/>
       <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{DynamicResource Dirty}" Margin="6,0,0,0" Visibility="{Binding IsDirty, Converter={StaticResource Visible}}"/>
       <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
      </DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
  </Grid>

  <!-- Structured confirmation for destructive and financial actions (Cancel is the default). -->
  <shell:DialogHost/>

  <!-- Workspace file selection dialog -->
  <workspaces:WorkspaceSelectionView Visibility="{Binding DataContext.ShowWorkspaceSelection, RelativeSource={RelativeSource AncestorType=shell:ShellOverlays}, Converter={StaticResource Visible}}" DataContext="{Binding WorkspaceSelection}"/>
 </Grid>
</UserControl>

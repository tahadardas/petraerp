 <!-- Document views by view-model type. Shared by the main tab host and detached document windows, so a document renders
      the same view wherever it is hosted (and only in one host at a time). -->
 <DataTemplate DataType="{x:Type ledger:GeneralLedgerViewModel}">
  <!-- The "journals" route page shows the list; a journal document shows one journal without the list. -->
  <ContentControl Content="{Binding}" Focusable="False">
   <ContentControl.Style><Style TargetType="ContentControl">
    <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><ledger:JournalsView/></DataTemplate></Setter.Value></Setter>
    <Style.Triggers><DataTrigger Binding="{Binding IsDocument}" Value="True">
     <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><ledger:JournalDocumentView/></DataTemplate></Setter.Value></Setter>
    </DataTrigger></Style.Triggers>
   </Style></ContentControl.Style>
  </ContentControl>
 </DataTemplate>

<UserControl x:Class="PetraERP.Desktop.Shell.DailyVoucherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <!-- Al-Ameen "سند يومية": cash account header, one row per counter account (pay / receive), blue totals, bottom button row. -->
 <UserControl.InputBindings>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
  <KeyBinding Key="B" Modifiers="Control" Command="{Binding AutoBalanceCommand}"/>
  <KeyBinding Key="Insert" Command="{Binding AddRowCommand}"/>
  <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
  <KeyBinding Key="Home" Modifiers="Control" Command="{Binding FirstVoucherCommand}"/>
  <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousVoucherCommand}"/>
  <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextVoucherCommand}"/>
  <KeyBinding Key="End" Modifiers="Control" Command="{Binding LastVoucherCommand}"/>
 </UserControl.InputBindings>
 <DockPanel>
  <!-- Al-Ameen Top Bar: Navigator + Secrecy Indicator -->
  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
    <TextBlock Text="درجة السرية" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7A3,3 0 0,1 15,10A3,3 0 0,1 12,13A3,3 0 0,1 9,10A3,3 0 0,1 12,7M12,15C14.67,15 20,16.33 20,19V20H4V19C4,16.33 9.33,15 12,15Z"
          Fill="{DynamicResource Success}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,6,0"/>
    <ComboBox Width="65" SelectedIndex="0">
        <ComboBoxItem Content="1"/>
        <ComboBoxItem Content="2"/>
        <ComboBoxItem Content="3"/>
    </ComboBox>
   </StackPanel>
   <ux:RecordNavigator RecordNumber="{Binding VoucherNumber}" StatusText="{Binding StatusText}"
                       FirstCommand="{Binding FirstVoucherCommand}" PreviousCommand="{Binding PreviousVoucherCommand}"
                       NextCommand="{Binding NextVoucherCommand}" LastCommand="{Binding LastVoucherCommand}"
                       JumpCommand="{Binding JumpCommand}"/>
  </DockPanel>
  <TextBlock DockPanel.Dock="Top" Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorSurface}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="2,0,2,6"
             Visibility="{Binding ValidationMessage, Converter={StaticResource Visible}}"/>
  <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="150"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,4"><TextBlock Text="{Binding Localization[D_DV_Cash]}" Style="{StaticResource Text.Label}"/>
    <ux:LookupPicker ItemsSource="{Binding Lookups.PostingAccounts}" SelectedId="{Binding CashAccountId}" IsEnabled="{Binding IsEditable}" IsArabic="{Binding Localization.IsRightToLeft}"
                     Placeholder="{Binding Localization[D_LookupHint]}" AutomationProperties.Name="{Binding Localization[D_DV_Cash]}"/></StackPanel>
   <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,4"><TextBlock Text="{Binding Localization[D_DV_Date]}" Style="{StaticResource Text.Label}"/>
    <ux:PetraDatePicker SelectedDate="{Binding VoucherDate}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding Localization[D_DV_Date]}"/></StackPanel>
   <StackPanel Grid.Row="0" Grid.Column="4" Margin="0,0,0,4"><TextBlock Text="{Binding Localization[D_DV_Currency]}" Style="{StaticResource Text.Label}"/>
    <ComboBox FlowDirection="LeftToRight" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding CurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" IsEditable="False" Height="26"
             AutomationProperties.Name="{Binding Localization[D_DV_Currency]}"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,4"><TextBlock Text="{Binding Localization[D_DV_Description]}" Style="{StaticResource Text.Label}"/>
    <TextBox MaxLength="1000" Text="{Binding VoucherDescription, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding Localization[D_DV_Description]}"/></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,4"><TextBlock Text="{Binding Localization[D_DV_PreviousBalance]}" Style="{StaticResource Text.Label}"/>
    <Border Background="{DynamicResource Brand.Navy}" Padding="6,3"><TextBlock Text="{Binding PreviousBalance, Converter={StaticResource Number}}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontWeight="SemiBold"/></Border></StackPanel>
   <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,0,0,4"><TextBlock Text="{Binding Localization[D_DV_Rate]}" Style="{StaticResource Text.Label}"/>
    <ux:PetraNumericTextBox Kind="Rate" MaximumScale="8" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditable}" AutomationProperties.Name="{Binding Localization[D_DV_Rate]}"/></StackPanel>
  </Grid>

  <!-- Button row, as in Al-Ameen: add / new / save / post / delete / refresh -->
  <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.CommandBar}" Margin="0,6,0,0">
   <WrapPanel>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="{Binding Localization[D_DV_AddRow]}" Command="{Binding AddRowCommand}" ToolTip="Insert"/>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE7C3;" Content="{Binding Localization[D_DV_New]}" Command="{Binding NewCommand}" ToolTip="Ctrl+N"/>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE74E;" Content="{Binding Localization[D_DV_Save]}" Command="{Binding SaveCommand}" ToolTip="Ctrl+S"/>
    <Button Style="{StaticResource Button.Financial}" ux:Icon.Glyph="&#xE8D4;" Content="موازنة القيد" Command="{Binding AutoBalanceCommand}" ToolTip="موازنة السند تلقائياً (Ctrl+B)"/>
    <Button Style="{StaticResource Button.Financial}" ux:Icon.Glyph="&#xE8C8;" Content="{Binding Localization[D_DV_Post]}" Command="{Binding PostCommand}" ToolTip="Ctrl+Shift+P"/>
    <Button Style="{StaticResource Button.Danger}" ux:Icon.Glyph="&#xE74D;" Content="{Binding Localization[D_DV_Delete]}" Command="{Binding DeleteCommand}"/>
    <Button Style="{StaticResource Button.Danger}" ux:Icon.Glyph="&#xE7A7;" Content="{Binding Localization[D_DV_Reverse]}" Command="{Binding ReverseCommand}" ToolTip="إنشاء قيد عكسي مرحَّل للسند المرحَّل (لا يُعدَّل الأصل)"/>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}" ToolTip="F5"/>
   </WrapPanel>
  </Border>

  <!-- Totals: distinctive Al-Ameen blue pills (pay, receive, final cash balance, difference, row count) + Live Tafqeet Banner. -->
  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Accent.Subtle}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,2,0,0" Padding="8,4" Margin="0,6,0,0">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding Localization[D_DV_Pay]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <Border Background="{DynamicResource Brand.Navy}" Padding="8,3" Margin="0,0,12,0" MinWidth="110" CornerRadius="{DynamicResource Radius.Small}">
      <TextBlock Text="{Binding TotalPayText}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" FontWeight="SemiBold"/>
     </Border>
     <TextBlock Text="{Binding Localization[D_DV_Receive]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <Border Background="{DynamicResource Brand.Navy}" Padding="8,3" Margin="0,0,16,0" MinWidth="110" CornerRadius="{DynamicResource Radius.Small}">
      <TextBlock Text="{Binding TotalReceiveText}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" FontWeight="SemiBold"/>
     </Border>
     <TextBlock Text="{Binding Localization[D_DV_FinalBalance]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
     <Border Background="{DynamicResource Brand.Navy}" Padding="8,3" Margin="0,0,8,0" MinWidth="130" CornerRadius="{DynamicResource Radius.Small}">
      <TextBlock Text="{Binding FinalBalance}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" FontWeight="SemiBold"/>
     </Border>
     <TextBlock Text="{Binding CurrencyCode}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="4,0,12,0"/>
     <TextBlock Text="الفرق:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0,6,0"/>
     <Border Background="{DynamicResource Error.Subtle}" Padding="8,3" Margin="0,0,12,0" MinWidth="90" CornerRadius="{DynamicResource Radius.Small}">
      <TextBlock Text="{Binding DifferenceText}" Foreground="{DynamicResource Error}" FlowDirection="LeftToRight" FontWeight="Bold"/>
     </Border>
     <TextBlock Text="الأسطر المكتملة:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="8,0,6,0"/>
     <TextBlock Text="{Binding FilledRowCount}" FontWeight="Bold" VerticalAlignment="Center"/>
    </WrapPanel>
    <Border Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,4,0,0">
     <DockPanel>
      <TextBlock Text="التفقيط:" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding TafqeetText}" Foreground="{DynamicResource Text.Primary}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
   </StackPanel>
  </Border>

  <ux:PetraAccountingDataGrid EntryMode="True" ShowRowNumbers="True" ux:GridRowNumbers.Enabled="True" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" CanUserAddRows="False" SelectionUnit="CellOrRowHeader"
            AlternatingRowBackground="{DynamicResource Grid.Alternate}" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Divider}" VerticalGridLinesBrush="{DynamicResource Divider}"
            CanUserSortColumns="False" IsReadOnly="{Binding IsEditable, Converter={StaticResource Show}, ConverterParameter=invert}" MinHeight="160" AutomationProperties.Name="{Binding Localization[D_DV_Rows]}"
            AutoGrowCommand="{Binding AutoGrowCommand}">
   <DataGrid.ContextMenu>
    <ContextMenu>
     <MenuItem Header="موازنة السند تلقائياً" Command="{Binding AutoBalanceCommand}" InputGestureText="Ctrl+B"/>
     <MenuItem Header="إضافة 10 أسطر جديدة" Command="{Binding AutoGrowCommand}"/>
     <MenuItem Header="{Binding Localization[D_DV_AddRow]}" Command="{Binding AddRowCommand}" InputGestureText="Insert"/>
     <MenuItem Header="حذف السطر المحدد" Command="{Binding RemoveRowCommand}" CommandParameter="{Binding SelectedRow}" InputGestureText="Ctrl+Del"/>
    </ContextMenu>
   </DataGrid.ContextMenu>
   <DataGrid.InputBindings>
    <KeyBinding Key="Insert" Command="{Binding AddRowCommand}"/>
    <KeyBinding Key="Delete" Modifiers="Control" Command="{Binding RemoveRowCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
   </DataGrid.InputBindings>
   <DataGrid.Columns>
    <DataGridTextColumn Binding="{Binding Pay, Converter={StaticResource Number}, ConverterParameter='blank,zeroifempty', UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="110" ElementStyle="{StaticResource Text.Numeric}">
     <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DV_Pay], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Receive, Converter={StaticResource Number}, ConverterParameter='blank,zeroifempty', UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="110" ElementStyle="{StaticResource Text.Numeric}">
     <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DV_Receive], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTemplateColumn Width="220">
     <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DV_Account], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ux:LookupPicker ItemsSource="{Binding DataContext.Lookups.PostingAccounts, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedId="{Binding AccountId}"
                       IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       IsReadOnly="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Show}, ConverterParameter=invert}"
                       Placeholder="{Binding DataContext.Localization[D_LookupHint], RelativeSource={RelativeSource AncestorType=UserControl}}"
                       AutomationProperties.Name="{Binding DataContext.Localization[D_DV_Account], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTextColumn Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="100">
     <DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DV_RowDescription], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTemplateColumn Width="110">
     <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_CostCenter], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ux:LookupPicker ItemsSource="{Binding DataContext.Lookups.CostCenters, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedId="{Binding CostCenterId}"
                       IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       IsReadOnly="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Show}, ConverterParameter=invert}"
                       AutomationProperties.Name="{Binding DataContext.Localization[D_CostCenter], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
    <DataGridTemplateColumn Width="32">
     <DataGridTemplateColumn.CellTemplate><DataTemplate>
      <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontSize="11" MinHeight="22" Padding="2" Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding DataContext.Localization[D_DV_RemoveRow], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </ux:PetraAccountingDataGrid>
 </DockPanel>
</UserControl>

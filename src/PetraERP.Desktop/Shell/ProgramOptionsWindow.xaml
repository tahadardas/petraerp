<Window x:Class="PetraERP.Desktop.Shell.ProgramOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
 Title="{Binding Localization[OPT_Title]}" Width="{StaticResource Dialog.Large}" Height="640" MinWidth="760" MinHeight="480"
 Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner" FlowDirection="{Binding Localization.FlowDirection}" Language="{Binding Localization.XmlLanguage}" PreviewKeyDown="OnPreviewKeyDown">
 <!-- Program options: categories on the reading-start side, Ctrl+F search on top, editor in the middle, OK / Apply / Cancel / Default below.
      Local preferences preview immediately and Cancel restores them; company financial policies are saved only by Apply / OK, through the API. -->
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,8">
   <TextBlock DockPanel.Dock="Left" Text="{Binding Localization[OPT_Search]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
   <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="{Binding Localization[OPT_Search]}" ToolTip="Ctrl+F"/>
  </DockPanel>

  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <Grid Grid.Column="0">
    <ListBox x:Name="CategoryList" DisplayMemberPath="Title" SelectionChanged="OnCategoryChanged" AutomationProperties.Name="{Binding Localization[OPT_Categories]}"/>
    <DockPanel x:Name="ResultPanel" Visibility="Collapsed" Background="{DynamicResource Surface}">
     <TextBlock x:Name="NoResults" DockPanel.Dock="Bottom" Text="{Binding Localization[OPT_NoResults]}" Style="{StaticResource Text.Caption}" Margin="8" Visibility="Collapsed"/>
     <ListBox x:Name="ResultList" DisplayMemberPath="Display" SelectionChanged="OnResultChanged" AutomationProperties.Name="{Binding Localization[OPT_Results]}"/>
    </DockPanel>
   </Grid>

   <Border Grid.Column="2" Style="{StaticResource Panel.Card}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock x:Name="SectionTitle" Style="{StaticResource Text.Section}" AutomationProperties.HeadingLevel="Level2"/>
      <TextBlock x:Name="ScopeNote" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
     </StackPanel>

     <!-- Company policies: the reason is required by the audit trail; changes are sent only by Apply / OK. -->
     <Border x:Name="CompanyFooter" DockPanel.Dock="Bottom" Style="{StaticResource Panel.Summary}" Margin="0,10,0,0" Padding="10" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="{Binding PolicyPrecedence}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
       <TextBlock Text="{Binding Localization[OPT_Reason]}" Style="{StaticResource Text.Label}"/>
       <TextBox Text="{Binding PolicyReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="250" IsReadOnly="{Binding CanManageCompanyPolicy, Converter={StaticResource Show}, ConverterParameter=invert}"
                AutomationProperties.Name="{Binding Localization[OPT_Reason]}"/>
       <TextBlock Text="{Binding PolicyStatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
     </Border>

     <ScrollViewer x:Name="SectionScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>

               <!-- Addition Policies (سياسات الإضافة) -->
        <StackPanel x:Name="Section_addition_policies" Visibility="Collapsed">
         <TextBlock Text="{Binding Localization[OPT_Addition_Help]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
         <CheckBox x:Name="AutoGenerateCodeField" Content="{Binding Localization[OPT_E_AutoGenerateCode]}" IsChecked="{Binding EntryAutoGenerateCodeOnAdd}" Margin="0,0,0,8"/>
         <CheckBox x:Name="AddSalesCreditField" Content="{Binding Localization[OPT_E_SalesCredit]}" IsChecked="{Binding EntrySalesStartsOnCredit}" Margin="0,0,0,8"/>
         <CheckBox x:Name="AddPurchaseCreditField" Content="{Binding Localization[OPT_E_PurchaseCredit]}" IsChecked="{Binding EntryPurchasesStartOnCredit}" Margin="0,0,0,8"/>
         <CheckBox x:Name="AddDuplicateItemField" Content="{Binding Localization[OPT_E_DuplicateItem]}" IsChecked="{Binding EntryDuplicateItemWarning}" Margin="0,0,0,8"/>
         <CheckBox x:Name="AddMaxStockField" Content="{Binding Localization[OPT_E_MaxStock]}" IsChecked="{Binding EntryMaxStockWarning}" Margin="0,0,0,8"/>
         <CheckBox x:Name="AddPastDateField" Content="{Binding Localization[OPT_E_PastDate]}" IsChecked="{Binding EntryPastDateWarning}" Margin="0,0,0,8"/>
         <CheckBox x:Name="ConfirmAddField" Content="{Binding Localization[OPT_E_ConfirmAdd]}" IsChecked="{Binding EntryConfirmOnAdd}" Margin="0,0,0,8"/>
         <StackPanel x:Name="AddInvoiceRowsField" Style="{StaticResource Field}" Margin="0,4,0,0">
          <TextBlock Text="{Binding Localization[OPT_E_InvoiceRows]}" Style="{StaticResource Text.Label}"/>
          <ComboBox ItemsSource="{Binding InvoiceRowChoices}" SelectedItem="{Binding EntryInvoiceRows}" Width="120" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Localization[OPT_E_InvoiceRows]}"/>
         </StackPanel>
        </StackPanel>

        <!-- Editing Policies (سياسات التعديل) -->
        <StackPanel x:Name="Section_editing_policies" Visibility="Collapsed">
         <TextBlock Text="{Binding Localization[OPT_Editing_Help]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>
         <CheckBox x:Name="PreventPostedEditField" Content="{Binding Localization[OPT_E_PreventPostedEdit]}" IsChecked="{Binding EntryPreventEditingPostedDocuments}" Margin="0,0,0,8"/>
         <CheckBox x:Name="PreventCodeModField" Content="{Binding Localization[OPT_E_PreventCodeMod]}" IsChecked="{Binding EntryPreventModifyingCodeWithMovements}" Margin="0,0,0,8"/>
         <CheckBox x:Name="WarnBelowCostField" Content="{Binding Localization[OPT_E_WarnBelowCost]}" IsChecked="{Binding EntryWarnOnBelowCost}" Margin="0,0,0,8"/>
         <CheckBox x:Name="WarnPriceChangeField" Content="{Binding Localization[OPT_E_WarnPriceChange]}" IsChecked="{Binding EntryWarnOnPriceChange}" Margin="0,0,0,8"/>
         <CheckBox x:Name="ConfirmEditField" Content="{Binding Localization[OPT_E_ConfirmEdit]}" IsChecked="{Binding EntryConfirmOnEdit}" Margin="0,0,0,8"/>
         <CheckBox x:Name="ConfirmDiscardField" Content="{Binding Localization[OPT_E_ConfirmDiscard]}" IsChecked="{Binding EntryConfirmOnDiscard}" Margin="0,0,0,8"/>
        </StackPanel>

       <StackPanel x:Name="Section_appearance" Visibility="Collapsed">
        <StackPanel x:Name="ThemeField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[UI_Theme]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[UI_Theme]}"/></StackPanel>
        <StackPanel x:Name="SkinField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[UI_Skin]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding Skins}" SelectedItem="{Binding Skin}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[UI_Skin]}"/>
         <TextBlock Text="{Binding Localization[UI_SkinHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <StackPanel x:Name="DensityField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[UI_Density]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[UI_Density]}"/>
         <TextBlock Text="{Binding Localization[UI_DensityHelp]}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"/></StackPanel>
        <StackPanel x:Name="WindowModeField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[UI_WindowMode]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding WindowModes}" SelectedItem="{Binding WindowMode}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[UI_WindowMode]}"/>
         <TextBlock Text="{Binding Localization[UI_WindowModeHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_language" Visibility="Collapsed">
        <StackPanel x:Name="LanguageField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[UX_Language]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[UX_Language]}"/></StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_numbers" Visibility="Collapsed">
        <StackPanel x:Name="NumbersField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[UI_NumberDisplay]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding NumberModes}" SelectedItem="{Binding NumberMode}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[UI_NumberDisplay]}"/>
         <TextBlock Text="{Binding Localization[UI_NumberDisplayHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <StackPanel x:Name="DecimalField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_E_Decimal]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding DecimalModes}" SelectedItem="{Binding DecimalMode}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[OPT_E_Decimal]}"/>
         <Border Style="{StaticResource Panel.Summary}" Margin="0,6,0,0"><TextBlock Text="{Binding NumberSample}" Style="{StaticResource Text.Numeric}" HorizontalAlignment="Left" AutomationProperties.Name="{Binding NumberSample}"/></Border></StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_posting" Visibility="Collapsed">
        <Border Style="{StaticResource Panel.Summary}" Padding="12" Margin="0,0,0,10">
         <StackPanel x:Name="PostingModeField">
          <TextBlock Text="{Binding Localization[OPT_E_PostingMode]}" Style="{StaticResource Text.Label}" Margin="0,0,0,6"/>
          <RadioButton GroupName="OptionsPostingMode" Content="{Binding Localization[OPT_PostingApproveOnly]}" IsChecked="{Binding PolicyApproveOnlySelected}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,6"/>
          <RadioButton GroupName="OptionsPostingMode" Content="{Binding Localization[OPT_PostingApproveAndPost]}" IsChecked="{Binding PolicyApproveAndPostSelected}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding PolicyPostingModeExplanation}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
         </StackPanel>
        </Border>
        <CheckBox x:Name="DraftField" Content="{Binding Localization[OPT_E_Draft]}" IsChecked="{Binding PolicyAllowSaveAsDraft}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,8"/>
        <CheckBox x:Name="ApprovalField" Content="{Binding Localization[OPT_E_Approval]}" IsChecked="{Binding PolicyRequireDocumentApproval}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,8"/>
       </StackPanel>

       <StackPanel x:Name="Section_numbering" Visibility="Collapsed">
        <StackPanel x:Name="NumberingScopeField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_E_NumberingScope]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding NumberingScopeOptions}" SelectedValue="{Binding PolicyDefaultNumberingScope}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding CanManageCompanyPolicy}"
                   AutomationProperties.Name="{Binding Localization[OPT_E_NumberingScope]}"/></StackPanel>
        <StackPanel x:Name="InitialSeqField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_E_InitialSeq]}" Style="{StaticResource Text.Label}"/>
         <TextBox Text="{Binding PolicyInitialNumberSequence}" MaxLength="12" IsReadOnly="{Binding CanManageCompanyPolicy, Converter={StaticResource Show}, ConverterParameter=invert}"
                  AutomationProperties.Name="{Binding Localization[OPT_E_InitialSeq]}"/></StackPanel>
        <CheckBox x:Name="ManualNumberingField" Content="{Binding Localization[OPT_E_ManualNumbering]}" IsChecked="{Binding PolicyAllowManualNumbering}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,8"/>
        <CheckBox x:Name="PatternOverrideField" Content="{Binding Localization[OPT_E_PatternOverride]}" IsChecked="{Binding PolicyAllowPatternNumberingOverrides}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,8"/>
       </StackPanel>

       <StackPanel x:Name="Section_documents" Visibility="Collapsed">
        <StackPanel x:Name="PatternsField">
         <TextBlock Text="{Binding Localization[OPT_E_DefaultPatterns]}" Style="{StaticResource Text.Label}" Margin="0,0,0,4"/>
         <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_P_Sales]}" Style="{StaticResource Text.Caption}"/>
          <ComboBox ItemsSource="{Binding CompanyPolicyPatterns}" SelectedValue="{Binding PolicyDefaultSalesPatternId}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding CanManageCompanyPolicy}"/></StackPanel>
         <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_P_Purchase]}" Style="{StaticResource Text.Caption}"/>
          <ComboBox ItemsSource="{Binding CompanyPolicyPatterns}" SelectedValue="{Binding PolicyDefaultPurchasePatternId}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding CanManageCompanyPolicy}"/></StackPanel>
         <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_P_Receipt]}" Style="{StaticResource Text.Caption}"/>
          <ComboBox ItemsSource="{Binding CompanyPolicyPatterns}" SelectedValue="{Binding PolicyDefaultReceiptPatternId}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding CanManageCompanyPolicy}"/></StackPanel>
         <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_P_Payment]}" Style="{StaticResource Text.Caption}"/>
          <ComboBox ItemsSource="{Binding CompanyPolicyPatterns}" SelectedValue="{Binding PolicyDefaultPaymentPatternId}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding CanManageCompanyPolicy}"/></StackPanel>
        </StackPanel>
        <StackPanel x:Name="PartyAccountsField">
         <TextBlock Text="حسابات الزبائن والموردين" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
         <TextBlock Text="الحساب الرئيسي الذي يُنشأ تحته حساب كل زبون أو مورد جديد لا يُختار له حساب. الحساب المختار يجب أن يكون حسابًا رئيسيًا لا يقبل الترحيل." Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4"/>
         <StackPanel Style="{StaticResource Field}"><TextBlock Text="الحساب الرئيسي للزبائن" Style="{StaticResource Text.Caption}"/>
          <ComboBox ItemsSource="{Binding CompanyPolicyHeadingAccounts}" SelectedValue="{Binding PolicyCustomersParentAccountId}" SelectedValuePath="Id" DisplayMemberPath="Caption" IsEnabled="{Binding CanManageCompanyPolicy}"/></StackPanel>
         <StackPanel Style="{StaticResource Field}"><TextBlock Text="الحساب الرئيسي للموردين" Style="{StaticResource Text.Caption}"/>
          <ComboBox ItemsSource="{Binding CompanyPolicyHeadingAccounts}" SelectedValue="{Binding PolicySuppliersParentAccountId}" SelectedValuePath="Id" DisplayMemberPath="Caption" IsEnabled="{Binding CanManageCompanyPolicy}"/></StackPanel>
        </StackPanel>
        <CheckBox x:Name="CreditSalesField" Content="{Binding Localization[OPT_E_CreditSales]}" IsChecked="{Binding PolicyAllowCreditSales}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,8,0,8"/>
        <CheckBox x:Name="CreditPurchasesField" Content="{Binding Localization[OPT_E_CreditPurchases]}" IsChecked="{Binding PolicyAllowCreditPurchases}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,8"/>
       </StackPanel>

       <StackPanel x:Name="Section_accounts" Visibility="Collapsed">
        <CheckBox x:Name="CostCenterField" Content="{Binding Localization[OPT_E_CostCenterPL]}" IsChecked="{Binding PolicyRequireProfitLossCostCenter}" IsEnabled="{Binding CanManageCompanyPolicy}" Margin="0,0,0,8"/>
       </StackPanel>

       <StackPanel x:Name="Section_items" Visibility="Collapsed">
        <StackPanel x:Name="NegativeIssueField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_E_NegativeIssue]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding NegativeIssuePolicyOptions}" SelectedValue="{Binding PolicyNegativeIssuePolicy}" SelectedValuePath="Value" DisplayMemberPath="Label" IsEnabled="{Binding CanManageCompanyPolicy}"
                   AutomationProperties.Name="{Binding Localization[OPT_E_NegativeIssue]}"/></StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_entry" Visibility="Collapsed">
        <TextBlock Text="{Binding Localization[OPT_Entry_Help]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <CheckBox x:Name="SalesCreditField" Content="{Binding Localization[OPT_E_SalesCredit]}" IsChecked="{Binding EntrySalesStartsOnCredit}" Margin="0,0,0,8"/>
        <CheckBox x:Name="PurchaseCreditField" Content="{Binding Localization[OPT_E_PurchaseCredit]}" IsChecked="{Binding EntryPurchasesStartOnCredit}" Margin="0,0,0,8"/>
        <StackPanel x:Name="InvoiceRowsField" Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[OPT_E_InvoiceRows]}" Style="{StaticResource Text.Label}"/>
         <ComboBox ItemsSource="{Binding InvoiceRowChoices}" SelectedItem="{Binding EntryInvoiceRows}" Width="120" HorizontalAlignment="Left"
                   AutomationProperties.Name="{Binding Localization[OPT_E_InvoiceRows]}"/></StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_warnings" Visibility="Collapsed">
        <TextBlock Text="{Binding Localization[OPT_Warnings_Help]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <CheckBox x:Name="MaxStockField" Content="{Binding Localization[OPT_E_MaxStock]}" IsChecked="{Binding EntryMaxStockWarning}" Margin="0,0,0,8"/>
        <CheckBox x:Name="PastDateField" Content="{Binding Localization[OPT_E_PastDate]}" IsChecked="{Binding EntryPastDateWarning}" Margin="0,0,0,8"/>
        <CheckBox x:Name="DuplicateItemField" Content="{Binding Localization[OPT_E_DuplicateItem]}" IsChecked="{Binding EntryDuplicateItemWarning}" Margin="0,0,0,8"/>
        <CheckBox x:Name="ConfirmSaveField" Content="{Binding Localization[OPT_E_ConfirmSave]}" IsChecked="{Binding EntryConfirmOnSave}" Margin="0,0,0,8"/>
        <CheckBox x:Name="ConfirmExitField" Content="{Binding Localization[OPT_E_ConfirmExit]}" IsChecked="{Binding EntryConfirmOnExit}" Margin="0,0,0,8"/>
       </StackPanel>

       <StackPanel x:Name="Section_layouts" Visibility="Collapsed">
        <StackPanel x:Name="LayoutsField">
         <TextBlock Text="{Binding Localization[UI_LayoutsHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <WrapPanel>
          <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[UI_ResetLayouts]}" Command="{Binding ResetLayoutsCommand}"/>
          <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE777;" Content="{Binding Localization[UI_ResetAppearance]}" Command="{Binding ResetAppearanceCommand}"/>
         </WrapPanel>
        </StackPanel>
        <StackPanel x:Name="FiltersField" Margin="0,16,0,0">
         <TextBlock Text="{Binding Localization[UI_SavedFilters]}" Style="{StaticResource Text.Label}"/>
         <TextBlock Text="{Binding Localization[UI_SavedFiltersHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
         <TextBlock Text="{Binding Localization[UI_NoSavedFilters]}" Style="{StaticResource Text.Caption}" Visibility="{Binding HasFilters, Converter={StaticResource Show}, ConverterParameter=invert}"/>
         <ItemsControl ItemsSource="{Binding Filters}" Focusable="False">
          <ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,2">
           <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontSize="12"
                   Command="{Binding DataContext.DeleteFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                   ToolTip="{Binding DataContext.Localization[UI_DeleteFilter], RelativeSource={RelativeSource AncestorType=Window}}"
                   AutomationProperties.Name="{Binding DataContext.Localization[UI_DeleteFilter], RelativeSource={RelativeSource AncestorType=Window}}"/>
           <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
          </DockPanel></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_shortcuts" Visibility="Collapsed">
        <StackPanel x:Name="ShortcutsField">
         <TextBlock Text="{Binding Localization[UI_KeyboardTitle]}" Style="{StaticResource Text.Label}"/>
         <TextBlock Text="{Binding Localization[UI_KeyboardHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
       </StackPanel>

       <StackPanel x:Name="Section_users" Visibility="Collapsed">
        <TextBlock Text="{Binding Localization[OPT_LinkUsers]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Style="{StaticResource Button.Command}" Tag="users" Click="OnOpenRoute" Content="{Binding Localization[OPT_OpenScreen]}" HorizontalAlignment="Left"/>
       </StackPanel>

       <StackPanel x:Name="Section_branches" Visibility="Collapsed">
        <TextBlock Text="{Binding Localization[OPT_LinkBranches]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Button Style="{StaticResource Button.Command}" Tag="branches" Click="OnOpenRoute" Content="{Binding Localization[OPT_OpenScreen]}" HorizontalAlignment="Left"/>
       </StackPanel>

      </Grid>
     </ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>

  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
   <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Content="{Binding Localization[OPT_Ok]}" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk"/>
   <Button x:Name="ApplyButton" Style="{StaticResource Button.Command}" Content="{Binding Localization[OPT_Apply]}" MinWidth="90" Margin="0,0,8,0" Click="OnApply"/>
   <Button x:Name="CancelButton" Style="{StaticResource Button.Command}" Content="{Binding Localization[OPT_Cancel]}" IsCancel="True" MinWidth="90" Margin="0,0,8,0" Click="OnCancel"/>
   <Button x:Name="DefaultButton" Style="{StaticResource Button.Command}" Content="{Binding Localization[OPT_Default]}" MinWidth="90" Click="OnDefault"/>
  </StackPanel>
 </Grid>
</Window>

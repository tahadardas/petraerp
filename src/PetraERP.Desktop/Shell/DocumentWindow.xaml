<Window x:Class="PetraERP.Desktop.Shell.DocumentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
 Width="1100" Height="720" MinWidth="{StaticResource Window.MinimumWidth}" MinHeight="{StaticResource Window.MinimumHeight}" WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}"
 FlowDirection="{Binding Localization.FlowDirection}" Language="{Binding Localization.XmlLanguage}" PreviewKeyDown="OnShortcut">
 <!-- A detached document: DataContext is the shell (window-level bindings such as Localization and Workspace keep working);
      the host renders the document's view model with the same templates as the tab host. -->
 <Window.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DocumentTemplates.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
 </Window.Resources>
 <Grid>
 <DockPanel Background="{DynamicResource Surface}">
  <Border DockPanel.Dock="Top" Style="{StaticResource Panel.CommandBar}" Margin="8,8,8,0">
   <DockPanel LastChildFill="False">
    <TextBlock x:Name="DocumentTitle" DockPanel.Dock="Left" Style="{StaticResource Text.Section}" Margin="4,0,12,0" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
    <TextBlock x:Name="DirtyMarker" DockPanel.Dock="Left" Text="●" Foreground="{DynamicResource Warning}" Visibility="Collapsed" ToolTip="{Binding Localization[D_UnsavedChanges]}"/>
    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE711;"
            Content="{Binding Localization[D_CloseTab]}" ToolTip="Ctrl+W" Click="CloseClicked"/>
    <Button x:Name="AttachButton" DockPanel.Dock="Right" Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE8A0;"
            Content="{Binding Localization[D_AttachTab]}" Click="AttachClicked"/>
   </DockPanel>
  </Border>
  <Grid Margin="{StaticResource Space.Page}">
   <ContentControl x:Name="Host" Focusable="False"/>
  </Grid>
 </DockPanel>
 <!-- Confirmations raised from this document are answered here (the same request is also shown in the main window). -->
 <shell:DialogHost xmlns:shell="clr-namespace:PetraERP.Desktop.Shell"/>
 </Grid>
</Window>

<UserControl x:Class="PetraERP.Desktop.Workspaces.WorkspaceSelectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             Background="{DynamicResource Overlay}">
    <Grid Margin="24">
        <Border Style="{StaticResource Panel.Card}" Width="600" MaxHeight="620" VerticalAlignment="Center" HorizontalAlignment="Center"
                Padding="24,20" KeyboardNavigation.TabNavigation="Cycle">
            <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.3"/></Border.Effect>
            <Grid>
                <!-- Company files -->
                <Grid Visibility="{Binding IsWizardOpen, Converter={StaticResource Show}, ConverterParameter=invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Accent}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Text.OnAccent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding Localization[D_SelectWorkspace]}" Style="{StaticResource Text.Section}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Localization[D_SelectWorkspaceHelp]}" Style="{StaticResource Text.Caption}"/>
                            </StackPanel>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;"
                                Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="{StaticResource Control.Height}"
                                 Margin="0,0,8,0" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Localization[D_SearchPlaceholder]}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="{Binding Localization[D_NewCompany]}"
                                    Command="{Binding StartCreateCompanyCommand}" Margin="0,0,6,0"/>
                            <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE823;" Content="{Binding Localization[D_NewFiscalYear]}"
                                    Command="{Binding StartCreateFiscalYearCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" Style="{StaticResource Panel.Flat}" MinHeight="190" Margin="0,0,0,8">
                        <Grid>
                            <ListBox x:Name="Files" ItemsSource="{Binding FilteredWorkspaces}" SelectedItem="{Binding SelectedWorkspace}"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="{Binding Localization[D_SelectWorkspace]}">
                                <ListBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding OpenWorkspaceCommand}"/>
                                </ListBox.InputBindings>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" Background="Transparent"
                                                ToolTip="{Binding DataContext.Localization[D_OpenWorkspace], RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftDoubleClick" CommandParameter="{Binding}"
                                                              Command="{Binding DataContext.OpenWorkspaceItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Border.InputBindings>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock>
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource NameLabel}">
                                                            <Binding Path="CompanyNameArabic"/>
                                                            <Binding Path="CompanyNameEnglish"/>
                                                            <Binding Path="DataContext.Localization.IsRightToLeft" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding YearNumber, Mode=OneWay}" Margin="8,0,0,0" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Localization[D_NoWorkspaces]}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Visibility="{Binding HasNoWorkspaces, Converter={StaticResource Visible}}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="3" Style="{StaticResource Panel.Flat}" Padding="10,6" Margin="0,0,0,8" DataContext="{Binding SelectedWorkspace}"
                            Visibility="{Binding Converter={StaticResource Show}}">
                        <StackPanel>
                            <TextBlock Text="{Binding DataContext.Localization[D_WorkspaceInfo], RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource Text.Label}"/>
                            <TextBlock Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left">
                                <Run Text="{Binding CompanyCode, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding YearNumber, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding BaseCurrencyCode, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding State, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Operation.Error}" Style="{StaticResource Text.Error}" Visibility="{Binding Operation.Error, Converter={StaticResource Show}}"/>
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0" Visibility="{Binding Operation.IsBusy, Converter={StaticResource Visible}}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[D_Cancel]}" Command="{Binding CancelCommand}"
                                    Visibility="{Binding CanCancel, Converter={StaticResource Visible}}" MinWidth="90" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE8FB;" Content="{Binding Localization[D_OpenWorkspace]}"
                                    Command="{Binding OpenWorkspaceCommand}" MinWidth="130"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Step-by-step wizard (replaces the list while open) -->
                <Grid Visibility="{Binding IsWizardOpen, Converter={StaticResource Visible}}" MinHeight="460">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.Panel}" Background="{DynamicResource Accent}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icons}" Foreground="{DynamicResource Text.OnAccent}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WizardTitle}" Style="{StaticResource Text.Section}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding StepCounter}" Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Step indicator -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Steps}" Margin="0,0,0,18" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,0">
                                    <Border x:Name="Bar" Height="4" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource Border}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="Dot" Width="22" Height="22" CornerRadius="{DynamicResource Radius.Dialog}" Background="{DynamicResource Surface.Sunken}" Margin="0,0,6,0">
                                            <TextBlock x:Name="Num" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Text.Secondary}"/>
                                        </Border>
                                        <TextBlock x:Name="Label" Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Accent}"/>
                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text}"/>
                                        <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Step content -->
                    <Border Grid.Row="2" Style="{StaticResource Panel.Flat}" Padding="20,16">
                        <Grid>
                            <StackPanel Visibility="{Binding ShowCompanyInfo, Converter={StaticResource Visible}}" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[UX_Code]}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewCompanyCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[D_NameArabic]}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewCompanyNameArabic, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[D_NameEnglish]}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewCompanyNameEnglish, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowCompanyDatabase, Converter={StaticResource Visible}}" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="اسم قاعدة البيانات — SQL database name" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewDatabaseName, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" FlowDirection="LeftToRight"/>
                                <TextBlock Text="يتم الإنشاء على الخادم فقط. لا يسمح باستبدال قاعدة موجودة." TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowAdministratorConfirmation, Converter={StaticResource Visible}}" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="كلمة مرور المدير الحالي — current administrator password" Style="{StaticResource Text.Label}"/>
                                <PasswordBox PasswordChanged="AdministratorPasswordChanged" MaxLength="256"/>
                                <TextBlock Text="تُراجع الهوية المركزية ولا تُنسخ كلمة المرور إلى قاعدة الشركة." TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowAccountTemplate, Converter={StaticResource Visible}}">
                                <ComboBox ItemsSource="{Binding AccountTemplates}" SelectedItem="{Binding SelectedAccountTemplate}" DisplayMemberPath="TemplateNameArabic"/>
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding TemplatePreview}" TextWrapping="Wrap"/></ScrollViewer>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowCompanyCurrency, Converter={StaticResource Visible}}" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[UX_Currency]}" Style="{StaticResource Text.Label}"/>
                                <ComboBox ItemsSource="{Binding Currencies}" SelectedItem="{Binding NewCompanyCurrency}" MinHeight="{StaticResource Control.Height}" IsEditable="False">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Code}" FontWeight="SemiBold" Width="48" FlowDirection="LeftToRight"/>
                                                <TextBlock Text="{Binding NameArabic}" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding NameEnglish}" Margin="8,0,0,0" Foreground="{DynamicResource Text.Secondary}" FlowDirection="LeftToRight"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding Localization[D_BaseCurrencyHint]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowCompanyYear, Converter={StaticResource Visible}}" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[D_FiscalYear]}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewCompanyYear, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="120" HorizontalAlignment="Left" FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[D_FiscalYearStart]}" Style="{StaticResource Text.Label}"/>
                                <DatePicker SelectedDate="{Binding NewCompanyStart}" FlowDirection="LeftToRight" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[D_FiscalYearEnd]}" Style="{StaticResource Text.Label}"/>
                                <DatePicker SelectedDate="{Binding NewCompanyEnd}" FlowDirection="LeftToRight" Width="200" HorizontalAlignment="Left"/>
                                <ScrollViewer MaxHeight="140"><TextBlock Text="{Binding PeriodPreview}" TextWrapping="Wrap"/></ScrollViewer>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowYearInfo, Converter={StaticResource Visible}}" MaxWidth="460" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding SelectedWorkspace.CompanyNameArabic}" Style="{StaticResource Text.Caption}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding Localization[D_FiscalYear]}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewYearNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" Width="120" HorizontalAlignment="Left" FlowDirection="LeftToRight" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding Localization[D_PeriodCode]}" Style="{StaticResource Text.Label}"/>
                                <TextBox Text="{Binding NewYearCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" Width="200" HorizontalAlignment="Left" FlowDirection="LeftToRight"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowYearCopy, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                                <CheckBox Content="{Binding Localization[D_CopyAccounts]}" IsChecked="{Binding CopyChartOfAccounts}" Margin="0,0,0,10"/>
                                <CheckBox Content="{Binding Localization[D_CopyWarehouses]}" IsChecked="{Binding CopyWarehouses}" Margin="0,0,0,10"/>
                                <CheckBox Content="{Binding Localization[D_CopyPatterns]}" IsChecked="{Binding CopyPatterns}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding ShowReview, Converter={StaticResource Visible}}">
                                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,12"/>
                                <TextBlock Text="{Binding ReviewText}" TextWrapping="Wrap" LineHeight="24"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="{Binding StepError}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding StepError, Converter={StaticResource Show}}"/>
                        <TextBlock Text="{Binding Operation.Error}" Style="{StaticResource Text.Error}" TextWrapping="Wrap" Visibility="{Binding Operation.Error, Converter={StaticResource Show}}"/>
                        <ProgressBar IsIndeterminate="True" Height="3" Margin="0,4,0,0" Visibility="{Binding Operation.IsBusy, Converter={StaticResource Visible}}"/>
                    </StackPanel>

                    <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Command}" Content="{Binding Localization[D_Cancel]}" Command="{Binding CancelWizardCommand}" MinWidth="90"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE73E;" Content="{Binding Localization[D_WizardFinish]}"
                                Command="{Binding FinishCommand}" MinWidth="120" Visibility="{Binding IsLastStep, Converter={StaticResource Visible}}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="{Binding Localization[D_WizardNext]}"
                                Command="{Binding NextCommand}" MinWidth="110" IsDefault="True" Visibility="{Binding IsLastStep, Converter={StaticResource Show}, ConverterParameter=invert}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Command}" Content="{Binding Localization[D_WizardBack]}" Command="{Binding BackCommand}" MinWidth="90" Margin="0,0,8,0"/>
                    </DockPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

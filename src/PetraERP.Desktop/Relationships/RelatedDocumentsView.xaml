<UserControl x:Class="PetraERP.Desktop.Relationships.RelatedDocumentsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Visibility="{Binding IsAvailable, Converter={StaticResource Visible}}">
 <DockPanel Margin="8">
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock Style="{StaticResource Text.Section}" VerticalAlignment="Center" Margin="0,0,12,0">
    <TextBlock.Text><MultiBinding Converter="{StaticResource EnumLabel}" ConverterParameter="D_"><Binding Path="HeadingToken"/><Binding Path="Localization.Language"/></MultiBinding></TextBlock.Text>
   </TextBlock>
   <Button Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}"/>
   <Button Content="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}" Margin="8,0"/>
   <Button Content="{Binding Localization[D_Previous]}" Command="{Binding PreviousCommand}"/>
   <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center" Margin="8,0"/>
   <Button Content="{Binding Localization[D_Next]}" Command="{Binding NextCommand}"/>
  </WrapPanel>
  <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" IsReadOnly="True" AutoGenerateColumns="False"
   CanUserAddRows="False" MaxHeight="300" MinHeight="120" AutomationProperties.Name="{Binding Heading}">
   <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenCommand}"/></DataGrid.InputBindings>
   <DataGrid.Columns>
    <DataGridTextColumn Binding="{Binding Number}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Col_Number], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding DateUtc, StringFormat=yyyy-MM-dd}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Col_Date], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Amount}" Width="160"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Amount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding CurrencyCode}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Currency], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTemplateColumn Width="*"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Col_State], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
     <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource EnumLabel}" ConverterParameter="D_State_"><Binding Path="State"/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>

<Window x:Class="PetraERP.Desktop.Reporting.ReportOptionsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding Localization[REP_Title]}" Width="{StaticResource Dialog.Medium}" Height="600" MinWidth="620" MinHeight="480"
 Style="{StaticResource Window.Dialog}" WindowStartupLocation="CenterOwner" FlowDirection="{Binding Localization.FlowDirection}" Language="{Binding Localization.XmlLanguage}">
 <!-- Report options: presentation of report results and of the report request window, per user on this computer.
      Nothing here can change a query, a filter, a total or a balance. -->
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TabControl Grid.Row="0">
   <TabItem Header="{Binding Localization[REP_Tab_General]}">
    <StackPanel Margin="12">
     <TextBlock Text="{Binding Localization[REP_General_Scope]}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding Localization[REP_General_NoEffect]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>
     <TextBlock Text="{Binding Localization[REP_General_InViewer]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
    </StackPanel>
   </TabItem>

   <TabItem Header="{Binding Localization[REP_Tab_Appearance]}">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[REP_FontSize]}" Style="{StaticResource Text.Label}"/>
       <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding FontSize}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[REP_FontSize]}"/></StackPanel>
      <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[REP_RowDensity]}" Style="{StaticResource Text.Label}"/>
       <ComboBox ItemsSource="{Binding Densities}" SelectedItem="{Binding Density}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[REP_RowDensity]}"/></StackPanel>
      <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[REP_GridLines]}" Style="{StaticResource Text.Label}"/>
       <ComboBox ItemsSource="{Binding GridLineModes}" SelectedItem="{Binding GridLines}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[REP_GridLines]}"/></StackPanel>
      <CheckBox Content="{Binding Localization[REP_Alternating]}" IsChecked="{Binding AlternatingRows}" Margin="0,4,0,10"/>
      <TextBlock Text="{Binding Localization[REP_Sample]}" Style="{StaticResource Text.Label}" Margin="0,4,0,4"/>
     </StackPanel>
     <DataGrid x:Name="Sample" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" IsHitTestVisible="False" Focusable="False"
               AlternatingRowBackground="{DynamicResource Grid.Alternate}" AutomationProperties.Name="{Binding Localization[REP_Sample]}">
      <DataGrid.Columns>
       <DataGridTextColumn Binding="{Binding Account}" Width="*"/>
       <DataGridTextColumn Binding="{Binding Debit}" Width="120"/>
       <DataGridTextColumn Binding="{Binding Credit}" Width="120"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>

   <TabItem Header="{Binding Localization[REP_Tab_Layout]}">
    <StackPanel Margin="12">
     <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[REP_ParametersLayout]}" Style="{StaticResource Text.Label}"/>
      <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding ParametersLayout}" DisplayMemberPath="Label" AutomationProperties.Name="{Binding Localization[REP_ParametersLayout]}"/>
      <TextBlock Text="{Binding Localization[REP_ParametersLayoutHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
    </StackPanel>
   </TabItem>
  </TabControl>

  <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
   <Button Style="{StaticResource Button.Primary}" Content="{Binding Localization[OPT_Ok]}" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[OPT_Apply]}" MinWidth="90" Margin="0,0,8,0" Click="OnApply"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[OPT_Cancel]}" IsCancel="True" MinWidth="90" Margin="0,0,8,0" Click="OnCancel"/>
   <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[OPT_Default]}" MinWidth="90" Click="OnDefault"/>
  </StackPanel>
 </Grid>
</Window>

<UserControl x:Class="PetraERP.Desktop.Treasury.VouchersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.InputBindings>
  <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
  <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
  <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewReceiptCommand}"/>
  <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditCommand}"/>
 </UserControl.InputBindings>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Visibility="{Binding CanUseManualNumber, Converter={StaticResource Visible}}">
   <TextBlock Text="رقم يدوي عند الترحيل — يخضع لسماح الشركة والنمط" VerticalAlignment="Center"/>
   <TextBox Text="{Binding ManualDocumentNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" MinWidth="150" FlowDirection="LeftToRight"/>
  </StackPanel>
  <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_RequiredEntryHelp]}" Style="{StaticResource Text.Caption}" Margin="4,0,4,8"/>
  <WrapPanel DockPanel.Dock="Top" Margin="4,0,4,8"><TextBlock Text="{Binding Localization[D_DocumentNumber]}" Style="{StaticResource Text.Label}" Margin="0,0,8,0"/>
   <TextBlock Style="{StaticResource Text.Value}"><TextBlock.Text><MultiBinding Converter="{StaticResource DocumentNumberCaption}"><Binding Path="Current.VoucherNumber"/><Binding Path="Localization[D_AutomaticNumberAtPosting]"/></MultiBinding></TextBlock.Text></TextBlock>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0"
               Visibility="{Binding HasNumberPreview, Converter={StaticResource Visible}}"
               ToolTip="{Binding Localization[D_ExpectedNumberHint]}">
    <TextBlock Text="{Binding Localization[D_ExpectedNumber]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
    <TextBlock Text="{Binding NumberPreview}" FlowDirection="LeftToRight" VerticalAlignment="Center" FontWeight="SemiBold"/>
   </StackPanel>
  </WrapPanel>
  <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[D_Vouchers]}">
   <ux:PageHeader.Status><ux:StatusBadge Text="{Binding StatusText}" Kind="{Binding DocumentStatusKind}" Visibility="{Binding HasDocumentStatus, Converter={StaticResource Visible}}"/></ux:PageHeader.Status>
   <ux:PageHeader.Commands>
    <WrapPanel>
     <ux:DocumentCommandBar Screen="{Binding}"/>
     <ItemsControl ItemsSource="{Binding PatternButtons}" Focusable="False">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Style="{StaticResource Button.Command}" Content="{Binding Pattern.Name}" Margin="0,0,8,0"
                Command="{Binding DataContext.NewByPatternCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
     <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}" ToolTip="F5" Margin="8,0,0,0"/>
    </WrapPanel>
   </ux:PageHeader.Commands>
  </ux:PageHeader>
  <TabControl SelectedIndex="{Binding WorkspaceTab}">
   <TabItem Header="{Binding Localization[D_Vouchers]}">
   <DockPanel Margin="0,8,0,0">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
     <TextBlock Text="{Binding TotalCount}" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
     <ComboBox ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding KindFilter}" IsEnabled="{Binding IsWorkspaceIdle}" MinWidth="160"
               HorizontalAlignment="Left"/>
    </DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
     <TextBlock Text="{Binding Localization[D_VoucherParty]}"/>
     <ux:LookupPicker ItemsSource="{Binding FilterParties, Converter={StaticResource EntryLookups}}" SelectedId="{Binding FilterPartyId}" IsEnabled="{Binding IsWorkspaceIdle}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="{Binding Localization[D_PrefixSearchHelp]}"/>
    </StackPanel>
    <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0"><Button Content="{Binding Localization[ARP_Previous]}" Command="{Binding PreviousVouchersCommand}"/><TextBlock Text="{Binding VoucherPageStatus}" Margin="6"/><Button Content="{Binding Localization[ARP_Next]}" Command="{Binding NextVouchersCommand}"/></WrapPanel>
    <ux:PetraAccountingDataGrid ux:GridRowContext.Enabled="True" ux:GridRowNumbers.Enabled="True" ItemsSource="{Binding Vouchers}" SelectedItem="{Binding SelectedVoucher}" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" SelectionMode="Single">
     <DataGrid.InputBindings>
      <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}"/>
      <KeyBinding Key="Enter" Command="{Binding OpenCommand}"/>
     </DataGrid.InputBindings>
     <DataGrid.ContextMenu><ContextMenu><MenuItem Header="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}"/></ContextMenu></DataGrid.ContextMenu>
     <DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding VoucherNumber}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_VoucherNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Kind}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_VoucherKind], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding VoucherDateUtc, StringFormat=yyyy-MM-dd}" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DateTime], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding PartyName}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_VoucherParty], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Amount, Converter={StaticResource Number}}" Width="100" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Amount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Status}" Width="80"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_VoucherStatus], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
     </DataGrid.Columns>
    </ux:PetraAccountingDataGrid>
   </DockPanel>
   </TabItem>

      <TabItem Header="{Binding Localization[D_Details]}">
    <DockPanel Margin="8,0,0,0">
     <!-- Al-Ameen Unified Bottom Command Bar -->
     <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.CommandBar}" Margin="0,6,0,0">
      <DockPanel LastChildFill="False">
       <WrapPanel DockPanel.Dock="Right">
        <Button Style="{StaticResource Button.Command}" Content="رجوع للقائمة" Command="{Binding CancelCommand}" Margin="4,0"/>
       </WrapPanel>
      </DockPanel>
     </Border>

     <!-- Al-Ameen Signature Blue Totals Bar -->
     <Border DockPanel.Dock="Bottom" Background="{DynamicResource Accent.Subtle}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,2,0,0" Padding="8,4" Margin="0,6,0,0">
      <DockPanel LastChildFill="False">
       <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
        <TextBlock Text="{Binding Localization[D_Amount]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <Border Background="{DynamicResource Brand.Navy}" Padding="10,3" Margin="0,0,16,0" MinWidth="120" CornerRadius="{DynamicResource Radius.Small}">
         <TextBlock Text="{Binding DraftAmount, Converter={StaticResource Number}}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" FontWeight="Bold" FontSize="13"/>
        </Border>
        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowPartyBalance, Converter={StaticResource Visible}}">
         <TextBlock Text="{Binding Localization[D_BalanceBefore]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <Border Background="{DynamicResource Brand.Navy}" Padding="10,3" Margin="0,0,16,0" MinWidth="110" CornerRadius="{DynamicResource Radius.Small}">
          <TextBlock Text="{Binding PreviousBalanceDisplay}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" FontWeight="SemiBold"/>
         </Border>
         <TextBlock Text="{Binding Localization[D_BalanceAfter]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,6,0"/>
         <Border Background="{DynamicResource Brand.Navy}" Padding="10,3" Margin="0,0,16,0" MinWidth="110" CornerRadius="{DynamicResource Radius.Small}">
          <TextBlock Text="{Binding FinalBalanceDisplay}" Foreground="{DynamicResource Text.OnBrand}" FlowDirection="LeftToRight" FontWeight="SemiBold"/>
         </Border>
        </StackPanel>
        <TextBlock Text="{Binding DraftCurrency}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="4,0,0,0"/>
       </WrapPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <ux:StatusBadge Text="{Binding StatusText}"/>
       </StackPanel>
      </DockPanel>
     </Border>

     <!-- Scrollable Body for Master Fields, Allocations & Distribution -->
     <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <!-- Validation Summary Banner -->
       <Border Background="{DynamicResource SubtleErrorBackground}"
               BorderBrush="{DynamicResource ErrorSurface}"
               BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="8,4" Margin="0,0,0,6"
               Visibility="{Binding HasValidationErrors, Converter={StaticResource Visible}}">
        <DockPanel>
         <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorSurface}"
                    VerticalAlignment="Center" Margin="0,0,8,0"/>
         <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorSurface}"
                    FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
       </Border>
       <Border Background="{DynamicResource SubtleInfoBackground}" BorderBrush="{DynamicResource InfoSurface}"
               BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="8,4" Margin="0,0,0,6"
               Visibility="{Binding HasSaveOutcome, Converter={StaticResource Visible}}">
        <TextBlock Text="{Binding SaveOutcomeMessage}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center">
         <TextBlock.Style>
          <Style TargetType="TextBlock">
           <Style.Triggers>
            <DataTrigger Binding="{Binding SaveOutcomeIsWarning}" Value="True">
             <Setter Property="Foreground" Value="{DynamicResource Warning}"/>
            </DataTrigger>
           </Style.Triggers>
          </Style>
         </TextBlock.Style>
        </TextBlock>
       </Border>

       <!-- Al-Ameen Structured Master Header Fields (3 Rows) -->
       <Border Style="{StaticResource Panel.Card}" Padding="12" Margin="0,0,0,8">
        <StackPanel>
         <ux:RecordNavigator Margin="0,0,0,8"
                             RecordNumber="{Binding Current.VoucherNumber}"
                             StatusText="{Binding StatusText}"
                             FirstCommand="{Binding FirstVoucherCommand}"
                             PreviousCommand="{Binding PreviousVoucherCommand}"
                             NextCommand="{Binding NextVoucherCommand}"
                             LastCommand="{Binding LastVoucherCommand}"/>
         <!-- Row 1: Pattern, Date, Settlement Method, Source Date -->
         <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="2*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <TextBlock Text="{Binding Localization[D_VoucherPattern], StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
           <ux:LookupPicker ItemsSource="{Binding Patterns, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftPatternRevisionId}" IsEnabled="{Binding PatternPickerEnabled}" Placeholder="{Binding DataContext.Localization[D_PrefixSearchHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="{Binding Localization[D_DateTime], StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
           <ux:PetraDatePicker SelectedDate="{Binding DraftDate}" IsEnabled="{Binding DateEnabled}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
           <TextBlock Text="{Binding Localization[D_SettlementMethod], StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
           <ComboBox ItemsSource="{Binding SettlementOptions}" DisplayMemberPath="Label" SelectedValuePath="Method" SelectedValue="{Binding DraftSettlement}" IsEnabled="{Binding CanEnterFields}"/>
          </StackPanel>
          <StackPanel Grid.Column="6">
           <TextBlock Text="{Binding Localization[D_SourceDate]}" Style="{StaticResource Text.Label}"/>
           <ux:PetraDatePicker SelectedDate="{Binding DraftSourceDate}" IsEnabled="{Binding CanEnterFields}"/>
          </StackPanel>
         </Grid>

         <!-- Row 2: Counterparty / Account, Source Number, Currency, Rate -->
         <Grid Margin="0,0,0,6">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="2*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <TextBlock Style="{StaticResource Text.Label}"><TextBlock.Text><MultiBinding Converter="{StaticResource RequiredCaption}"><Binding Path="Localization[D_VoucherParty]"/><Binding Path="IsReceipt"/></MultiBinding></TextBlock.Text></TextBlock>
           <ux:LookupPicker ItemsSource="{Binding Parties, Converter={StaticResource EntryLookups}}" AsyncSearchProvider="{Binding SearchPartiesAsync}" SelectedId="{Binding DraftPartyId}" IsEnabled="{Binding CanEnterFields}" Placeholder="{Binding DataContext.Localization[D_PrefixSearchHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="{Binding Localization[D_SourceNumber]}" Style="{StaticResource Text.Label}"/>
           <TextBox Text="{Binding DraftSourceNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" IsEnabled="{Binding CanEnterFields}" AutomationProperties.Name="{Binding Localization[D_SourceNumber]}"/>
          </StackPanel>
          <StackPanel Grid.Column="4">
           <TextBlock Text="{Binding Localization[CUR_DocumentCurrency]}" Style="{StaticResource Text.Label}"/>
           <ComboBox ItemsSource="{Binding CurrencyOptions}" IsEditable="False" SelectedItem="{Binding DraftCurrency, Mode=TwoWay}"
                     IsEnabled="{Binding CanEnterFields}" FlowDirection="LeftToRight" ToolTip="{Binding Localization[CUR_AutoCurrency]}"
                     AutomationProperties.Name="{Binding Localization[CUR_DocumentCurrency]}"/>
          </StackPanel>
          <StackPanel Grid.Column="6">
           <TextBlock Text="{Binding Localization[CUR_DocumentRate]}" Style="{StaticResource Text.Label}"/>
           <ux:PetraNumericTextBox Kind="Rate" MaximumScale="8" Text="{Binding DraftRate, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEnterFields}"
                                   ToolTip="{Binding Localization[CUR_RateHelp]}"/>
          </StackPanel>
         </Grid>

         <!-- Row 3: Amount, Notes, Audit Text (if any) -->
         <Grid Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="2*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="3*"/>
           <ColumnDefinition Width="8"/>
           <ColumnDefinition Width="1.5*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <TextBlock Text="{Binding HeaderAmount, StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
           <ux:PetraMoneyBox Text="{Binding DraftAmount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEnterFields}"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="{Binding Localization[D_Notes]}" Style="{StaticResource Text.Label}"/>
           <TextBox Text="{Binding DraftNotes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" IsEnabled="{Binding CanEnterFields}"/>
          </StackPanel>
          <StackPanel Grid.Column="4" Visibility="{Binding HasAudit, Converter={StaticResource Visible}}">
           <TextBlock Text="{Binding Localization[D_VoucherAudit]}" Style="{StaticResource Text.Label}"/>
           <TextBlock Text="{Binding AuditText}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}"/>
          </StackPanel>
         </Grid>
        </StackPanel>
       </Border>

       <!-- Invoice Allocations (Party Settlement) -->
       <Border Style="{StaticResource Panel.Card}" Padding="12" Margin="0,0,0,8" Visibility="{Binding IsPartySettlement, Converter={StaticResource Visible}}">
        <DockPanel>
         <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Command}" Content="{Binding Localization[D_LoadOutstanding]}" Command="{Binding LoadOutstandingCommand}"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Command}" Content="{Binding Localization[D_OpenInvoice]}" Command="{Binding OpenInvoiceCommand}" Margin="0,0,8,0"/>
          <TextBlock Text="{Binding Localization[D_InvoiceAllocations]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
         </DockPanel>
         <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
          <TextBlock Text="{Binding Localization[D_Allocated]}" Margin="0,0,4,0"/><TextBlock Text="{Binding AllocatedDisplay}" FontWeight="SemiBold" Margin="0,0,16,0"/>
          <TextBlock Text="{Binding Localization[ARP_UnallocatedAdvance]}" Margin="0,0,4,0"/><TextBlock Text="{Binding AdvanceDisplay}" FontWeight="SemiBold"/>
         </WrapPanel>
         <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="{Binding Localization[ARP_AllocationHelp]}" TextWrapping="Wrap" Margin="0,4,0,8"/>
          <WrapPanel>
           <StackPanel Margin="0,0,8,6"><TextBlock Text="{Binding Localization[ARP_InvoiceState]}"/><ComboBox ItemsSource="{Binding InvoiceStateOptions}" DisplayMemberPath="Label" SelectedValuePath="State" SelectedValue="{Binding InvoiceStateFilter}" IsEnabled="{Binding IsWorkspaceIdle}" MinWidth="140"/></StackPanel>
           <StackPanel Margin="0,0,8,6"><TextBlock Text="{Binding Localization[ARP_InvoiceCurrencyFilter]}"/><TextBox Text="{Binding InvoiceCurrencyFilter, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWorkspaceIdle}" Width="100" MaxLength="3"/></StackPanel>
           <Button Content="{Binding Localization[ARP_Previous]}" Command="{Binding PreviousInvoicesCommand}" Margin="4"/>
           <TextBlock Text="{Binding InvoicePageStatus}" VerticalAlignment="Center"/>
           <Button Content="{Binding Localization[ARP_Next]}" Command="{Binding NextInvoicesCommand}" Margin="4"/>
          </WrapPanel>
          <WrapPanel Visibility="{Binding IsApplyingAdvance, Converter={StaticResource Visible}}">
           <TextBlock Text="{Binding Localization[ARP_ApplicationDate], StringFormat='{}{0} *'}" Margin="0,0,8,0" VerticalAlignment="Center"/>
           <ux:PetraDatePicker SelectedDate="{Binding ApplicationDate}" IsEnabled="{Binding IsWorkspaceIdle}"/>
           <TextBlock Text="{Binding Localization[ARP_SelectedSettlement]}" Margin="8,0" VerticalAlignment="Center"/>
           <TextBlock Text="{Binding SelectionTotalDisplay}" VerticalAlignment="Center" FontWeight="SemiBold"/>
          </WrapPanel>
         </StackPanel>
         <ux:PetraAccountingDataGrid ux:GridRowNumbers.Enabled="True" ux:GridRowContext.Enabled="True" ux:GridEntry.Enabled="True" ItemsSource="{Binding AllocationRows}" SelectedItem="{Binding SelectedAllocation}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="260" IsReadOnly="{Binding IsAllocationReadOnly}">
          <DataGrid.ContextMenu><ContextMenu>
           <MenuItem Header="{Binding Localization[D_OpenInvoice]}" Command="{Binding OpenInvoiceCommand}"/>
           <MenuItem Header="{Binding Localization[ARP_CopyPrevious]}" Command="{x:Static ux:GridEntry.CopyPreviousCell}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
          </ContextMenu></DataGrid.ContextMenu>
          <DataGrid.Columns>
           <DataGridTextColumn Binding="{Binding InvoiceNumber}" IsReadOnly="True" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_LinkNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding DateDisplay}" IsReadOnly="True" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DateTime], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding OutstandingDisplay, Converter={StaticResource Number}}" IsReadOnly="True" Width="110" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Outstanding], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding CurrencyCode}" IsReadOnly="True" Width="70"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[CUR_Currency], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding StateDisplay}" IsReadOnly="True" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_InvoiceState], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn ux:GridEntry.CopyPath="Amount" Binding="{Binding Amount, Converter={StaticResource Number}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_InvoiceAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn ux:GridEntry.CopyPath="SettlementAmount" Binding="{Binding SettlementAmount, Converter={StaticResource Number}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="120" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_SettlementAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn ux:GridEntry.CopyPath="CrossRate" Binding="{Binding CrossRate, Converter={StaticResource Number}, ConverterParameter=rate, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="110" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_CrossRate], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns>
         </ux:PetraAccountingDataGrid>
        </DockPanel>
       </Border>

       <!-- Distribution Payment Lines -->
       <Border Style="{StaticResource Panel.Card}" Padding="12" Margin="0,0,0,8" Visibility="{Binding ShowDistributionPanel, Converter={StaticResource Visible}}">
        <DockPanel>
         <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
           <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[D_AddLine]}" Command="{Binding AddLineCommand}"/>
           <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[D_RemoveLine]}" Command="{Binding RemoveLineCommand}" Margin="8,0,0,0"/>
          </StackPanel>
          <TextBlock Text="{Binding Localization[D_PaymentLines]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
         </DockPanel>
         <ux:DocumentTotalsBar DockPanel.Dock="Bottom" Margin="0,8,0,0" GrandTotal="{Binding LinesTotalDisplay}"/>
         <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="{Binding Localization[ARP_PaymentModeHelp]}" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <Button Content="{Binding Localization[ARP_ClearDistribution]}" Command="{Binding ClearDistributionCommand}" Visibility="{Binding HasDistributionConflict, Converter={StaticResource Visible}}"/>
         </StackPanel>
         <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_DistributionRequiredHelp]}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
         <ux:PetraAccountingDataGrid ux:GridRowNumbers.Enabled="True" ux:GridRowContext.Enabled="True" ux:GridEntry.Enabled="True" ItemsSource="{Binding LineRows}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False" MinHeight="260" IsEnabled="{Binding CanEditDistribution}">
          <DataGrid.InputBindings>
           <KeyBinding Key="Insert" Command="{Binding AddLineCommand}"/>
           <KeyBinding Key="Delete" Modifiers="Control" Command="{Binding RemoveLineCommand}"/>
           <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
          </DataGrid.InputBindings>
          <DataGrid.ContextMenu><ContextMenu>
           <MenuItem Header="{Binding Localization[D_AddLine]}" Command="{Binding AddLineCommand}"/>
           <MenuItem Header="{Binding Localization[D_RemoveLine]}" Command="{Binding RemoveLineCommand}"/>
           <MenuItem Header="{Binding Localization[ARP_CopyPrevious]}" Command="{x:Static ux:GridEntry.CopyPreviousCell}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
          </ContextMenu></DataGrid.ContextMenu>
          <DataGrid.Columns>
           <DataGridTemplateColumn Width="*">
            <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.HeaderParty, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
             <ux:LookupPicker ItemsSource="{Binding DataContext.Suppliers, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EntryLookups}}" AsyncSearchProvider="{Binding DataContext.SearchPartiesAsync, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedId="{Binding PartyId, UpdateSourceTrigger=PropertyChanged}" Placeholder="{Binding DataContext.Localization[D_PrefixSearchHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
           </DataGridTemplateColumn>
           <DataGridTemplateColumn Width="*">
            <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.HeaderAccount, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
             <ux:LookupPicker ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EntryLookups}}" SelectedId="{Binding AccountId, UpdateSourceTrigger=PropertyChanged}" Placeholder="{Binding DataContext.Localization[D_PrefixSearchHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
           </DataGridTemplateColumn>
           <DataGridTemplateColumn Width="140">
            <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.HeaderCostCenter, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
            <DataGridTemplateColumn.CellTemplate><DataTemplate>
             <ux:LookupPicker ItemsSource="{Binding DataContext.CostCenters, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EntryLookups}}" SelectedId="{Binding CostCenterId, UpdateSourceTrigger=PropertyChanged}" Placeholder="{Binding DataContext.Localization[D_PrefixSearchHelp], RelativeSource={RelativeSource AncestorType=UserControl}}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </DataTemplate></DataGridTemplateColumn.CellTemplate>
           </DataGridTemplateColumn>
           <DataGridTextColumn ux:GridEntry.CopyPath="Amount" Binding="{Binding Amount, Converter={StaticResource Number}, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" Width="110" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.HeaderAmount, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn ux:GridEntry.CopyPath="Description" Binding="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.HeaderDescription, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns>
         </ux:PetraAccountingDataGrid>
        </DockPanel>
       </Border>

       <!-- Allocation History -->
       <Border Style="{StaticResource Panel.Card}" Padding="12" Margin="0,0,0,8" Visibility="{Binding HasAllocationHistory, Converter={StaticResource Visible}}">
        <StackPanel>
         <TextBlock Text="{Binding Localization[ARP_OriginalAllocations]}" Style="{StaticResource Text.Label}"/>
         <ux:PetraAccountingDataGrid ItemsSource="{Binding OriginalAllocations}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" MaxHeight="180" ux:GridRowNumbers.Enabled="True">
          <DataGrid.Columns>
           <DataGridTextColumn Binding="{Binding InvoiceNumber}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_LinkNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding CurrencyCode}" Width="75"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[CUR_Currency], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding Amount, Converter={StaticResource Number}}" Width="115" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_InvoiceAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding SettlementAmount, Converter={StaticResource Number}}" Width="115" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_SettlementAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns>
         </ux:PetraAccountingDataGrid>
         <TextBlock Text="{Binding Localization[ARP_SettlementHistory]}" Style="{StaticResource Text.Label}" Margin="0,8,0,4"/>
         <ux:PetraAccountingDataGrid ItemsSource="{Binding SettlementBatches}" SelectedItem="{Binding SelectedBatch}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" MaxHeight="180" ux:GridRowContext.Enabled="True" ux:GridRowNumbers.Enabled="True">
          <DataGrid.ContextMenu><ContextMenu>
           <MenuItem Header="{Binding Localization[D_OpenJournal]}" Command="{Binding OpenSettlementJournalCommand}"/>
           <MenuItem Header="{Binding Localization[ARP_OpenReversalJournal]}" Command="{Binding OpenSettlementReversalJournalCommand}"/>
           <MenuItem Header="{Binding Localization[ARP_ReverseApplication]}" Command="{Binding ReverseSettlementCommand}"/>
          </ContextMenu></DataGrid.ContextMenu>
          <DataGrid.Columns>
           <DataGridTextColumn Binding="{Binding Date}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DateTime], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding ApplicationKind}" Width="150"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_ApplicationKind], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding State}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_VoucherStatus], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding Amount, Converter={StaticResource Number}}" Width="110" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_SettlementAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding Reason}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_ActionReason], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding ReversalDate}" Width="125"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_ReversalDate], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding ReversalReason}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_ReversalReason], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding ReversedBy}" Width="200"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_ReversedBy], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns>
         </ux:PetraAccountingDataGrid>
         <ux:PetraAccountingDataGrid ItemsSource="{Binding SelectedBatchApplications}" SelectedItem="{Binding SelectedHistoryAllocation}" IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" MaxHeight="180" ux:GridRowContext.Enabled="True" ux:GridRowNumbers.Enabled="True">
          <DataGrid.ContextMenu><ContextMenu><MenuItem Header="{Binding Localization[D_OpenInvoice]}" Command="{Binding OpenHistoryInvoiceCommand}"/></ContextMenu></DataGrid.ContextMenu>
          <DataGrid.Columns>
           <DataGridTextColumn Binding="{Binding InvoiceNumber}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_LinkNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding InvoiceCurrency}" Width="75"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[CUR_Currency], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding InvoiceAmount, Converter={StaticResource Number}}" Width="115" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_InvoiceAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding SettlementAmount, Converter={StaticResource Number}}" Width="115" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_SettlementAmount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
           <DataGridTextColumn Binding="{Binding CrossRate, Converter={StaticResource Number}, ConverterParameter=rate}" Width="100" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[ARP_CrossRate], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
          </DataGrid.Columns>
         </ux:PetraAccountingDataGrid>
         <WrapPanel Margin="0,6,0,0"><Button Content="{Binding Localization[D_OpenInvoice]}" Command="{Binding OpenHistoryInvoiceCommand}" Margin="4"/><Button Content="{Binding Localization[D_OpenJournal]}" Command="{Binding OpenSettlementJournalCommand}" Margin="4"/><Button Content="{Binding Localization[ARP_OpenReversalJournal]}" Command="{Binding OpenSettlementReversalJournalCommand}" Margin="4"/><Button Content="{Binding Localization[ARP_ReverseApplication]}" Command="{Binding ReverseSettlementCommand}" Margin="4"/></WrapPanel>
        </StackPanel>
       </Border>

       <!-- Advances & Reversal Action Card -->
       <Border Style="{StaticResource Panel.Card}" Padding="12" Margin="0,0,0,8">
        <StackPanel>
         <WrapPanel Margin="0,0,0,6" Visibility="{Binding IsPartySettlement, Converter={StaticResource Visible}}">
          <Button Content="{Binding Localization[ARP_StartAdvance]}" Command="{Binding StartAdvanceCommand}" Margin="4,0"/>
          <Button Content="{Binding Localization[ARP_ApplyAdvance]}" Command="{Binding ApplyAdvanceCommand}" Margin="4,0"/>
         </WrapPanel>
         <DockPanel>
          <TextBlock Text="{Binding Localization[ARP_ActionReason]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Text="{Binding ReverseReason, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWorkspaceIdle}" MaxLength="500"/>
         </DockPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Migration.AlAmeenMigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.Resources><ux:BindingProxy x:Key="Proxy" Data="{Binding}"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
 <StackPanel>
  <ux:PageHeader Title="{Binding Localization[AMM_Title]}">
   <ux:PageHeader.Commands>
    <WrapPanel>
     <Button Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE721;" Content="{Binding Localization[AMM_Preview]}" Command="{Binding PreviewCommand}"/>
     <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE896;" Content="{Binding Localization[AMM_Execute]}" Command="{Binding ExecuteCommand}" Margin="8,0,0,0"/>
     <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE73E;" Content="{Binding Localization[AMM_Reconcile]}" Command="{Binding ReconcileCommand}" Margin="8,0,0,0"/>
     <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE930;" Content="{Binding Localization[AMM_Activate]}" Command="{Binding ActivateCommand}" Margin="8,0,0,0"/>
    </WrapPanel>
   </ux:PageHeader.Commands>
  </ux:PageHeader>

  <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="8">
   <WrapPanel>
    <StackPanel Style="{StaticResource Field}" Width="560" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_Source], StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
     <TextBox Text="{Binding SourceConnectionString, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localization[AMM_Source]}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="150" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_FiscalYear], StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
     <TextBox Text="{Binding TargetFiscalYearCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Localization[AMM_FiscalYear]}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="150" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_Start]}" Style="{StaticResource Text.Label}"/>
     <DatePicker SelectedDate="{Binding TargetFiscalYearStart}" AutomationProperties.Name="{Binding Localization[AMM_Start]}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="150" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_End]}" Style="{StaticResource Text.Label}"/>
     <DatePicker SelectedDate="{Binding TargetFiscalYearEnd}" AutomationProperties.Name="{Binding Localization[AMM_End]}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="120" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_BaseCurrency], StringFormat='{}{0} *'}" Style="{StaticResource Text.Label}"/>
     <TextBox Text="{Binding TargetBaseCurrencyCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" AutomationProperties.Name="{Binding Localization[AMM_BaseCurrency]}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="260" Margin="0,0,12,6">
     <CheckBox Content="{Binding Localization[AMM_FullHistory]}" IsChecked="{Binding IsFullHistory}"/>
     <CheckBox Content="{Binding Localization[AMM_UseCutoff]}" IsChecked="{Binding UseCutoffDate}" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="150" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_Cutoff]}" Style="{StaticResource Text.Label}"/>
     <DatePicker SelectedDate="{Binding CutoffDate}" IsEnabled="{Binding UseCutoffDate}" AutomationProperties.Name="{Binding Localization[AMM_Cutoff]}"/>
    </StackPanel>
    <StackPanel Style="{StaticResource Field}" Width="260" Margin="0,0,12,6">
     <TextBlock Text="{Binding Localization[AMM_AdminPassword]}" Style="{StaticResource Text.Label}"/>
     <PasswordBox ux:PasswordInput.Value="{Binding AdministratorPassword, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" MinHeight="{StaticResource Control.Height}" AutomationProperties.Name="{Binding Localization[AMM_AdminPassword]}"/>
    </StackPanel>
    <TextBlock Text="{Binding Localization[AMM_Help]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="620" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
   </WrapPanel>
  </Border>

  <Border Style="{StaticResource Panel.Summary}" Margin="0,0,0,8" Visibility="{Binding HasStatus, Converter={StaticResource Visible}}">
   <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="10,6"/>
  </Border>

  <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="8" Visibility="{Binding IsPreviewCompleted, Converter={StaticResource Visible}}">
   <WrapPanel>
    <StackPanel Width="150" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_Accounts]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding AccountsCount}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="150" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_Parties]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding PartiesCount}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="150" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_Items]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding ItemsCount}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="150" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_Warehouses]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding WarehousesCount}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="150" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_Currencies]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding CurrenciesCount}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="220" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_OpenDebit]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding OpeningBalanceDebit}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="220" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_OpenCredit]}" Style="{StaticResource Text.Label}"/><TextBlock Text="{Binding OpeningBalanceCredit}" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Width="220" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_CustOpen]}" Style="{StaticResource Text.Label}"/><TextBlock FontWeight="SemiBold"><Run Text="{Binding CustomerOpenItemsCount, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding CustomerOpenItemsTotal, Mode=OneWay}"/></TextBlock></StackPanel>
    <StackPanel Width="220" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_SuppOpen]}" Style="{StaticResource Text.Label}"/><TextBlock FontWeight="SemiBold"><Run Text="{Binding SupplierOpenItemsCount, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding SupplierOpenItemsTotal, Mode=OneWay}"/></TextBlock></StackPanel>
    <StackPanel Width="220" Margin="0,0,12,6"><TextBlock Text="{Binding Localization[AMM_InvValue]}" Style="{StaticResource Text.Label}"/><TextBlock FontWeight="SemiBold"><Run Text="{Binding InventoryItemsCount, Mode=OneWay}"/><Run Text=" | "/><Run Text="{Binding InventoryValuation, Mode=OneWay}"/></TextBlock></StackPanel>
   </WrapPanel>
  </Border>

  <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="8" Visibility="{Binding HasFindings, Converter={StaticResource Visible}}">
   <StackPanel>
    <TextBlock Text="{Binding Localization[AMM_Findings]}" Style="{StaticResource Text.Label}"/>
    <ItemsControl ItemsSource="{Binding ValidationMessages}">
     <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>

  <Border Style="{StaticResource Panel.Flat}" Visibility="{Binding HasChecks, Converter={StaticResource Visible}}">
   <DataGrid ItemsSource="{Binding Checks}" IsReadOnly="True" SelectionUnit="FullRow" AutoGenerateColumns="False"
             CanUserSortColumns="False" BorderThickness="0" MaxHeight="420">
    <DataGrid.Columns>
     <DataGridTextColumn Header="{Binding Data.Localization[AMM_Check], Source={StaticResource Proxy}}" Binding="{Binding Name}" Width="220"/>
     <DataGridTextColumn Header="{Binding Data.Localization[AMM_SourceVal], Source={StaticResource Proxy}}" Binding="{Binding Source}" Width="160"/>
     <DataGridTextColumn Header="{Binding Data.Localization[AMM_TargetVal], Source={StaticResource Proxy}}" Binding="{Binding Target}" Width="160"/>
     <DataGridTextColumn Header="{Binding Data.Localization[AMM_Diff], Source={StaticResource Proxy}}" Binding="{Binding Difference}" Width="120"/>
     <DataGridTextColumn Header="{Binding Data.Localization[AMM_Result], Source={StaticResource Proxy}}" Binding="{Binding Result}" Width="90"/>
     <DataGridTextColumn Header="{Binding Data.Localization[AMM_Details], Source={StaticResource Proxy}}" Binding="{Binding Details}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Border>
 </StackPanel>
 </ScrollViewer>
</UserControl>

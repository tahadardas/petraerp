  <!-- Canonical semantic palette. -->
  <SolidColorBrush x:Key="App.Background" Color="#0E171C"/>
  <SolidColorBrush x:Key="Surface.Primary" Color="#152229"/>
  <SolidColorBrush x:Key="Surface.Secondary" Color="#19282F"/>
  <SolidColorBrush x:Key="Surface.Recessed" Color="#0A1216"/>
  <SolidColorBrush x:Key="Brand.Navy" Color="#1E3A57"/>
  <SolidColorBrush x:Key="Brand.NavyHover" Color="#284B6E"/>
  <SolidColorBrush x:Key="Brand.Teal" Color="#7DBCE6"/>
  <SolidColorBrush x:Key="Brand.TealHover" Color="#9ACDEE"/>
  <SolidColorBrush x:Key="Brand.TealSubtle" Color="#16314A"/>
  <SolidColorBrush x:Key="Text.Primary" Color="#F0F4F5"/>
  <SolidColorBrush x:Key="Text.Secondary" Color="#B3C0C5"/>
  <SolidColorBrush x:Key="Text.Muted" Color="#8FA0A7"/>
  <SolidColorBrush x:Key="Border.Normal" Color="#31434B"/>
  <SolidColorBrush x:Key="Border.Strong" Color="#5E747E"/>

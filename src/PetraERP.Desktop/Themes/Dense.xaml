<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <!--
    PetraERP design tokens (non-color): typography, spacing, control heights, radii, focus and validation, and the
    dense base styles for standard controls. Colors live in Light.xaml / Dark.xaml. Segoe UI renders Arabic and Latin
    correctly; icons use the Windows system icon font (not bundled).
  -->
  <FontFamily x:Key="Font.Family">Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
  <FontFamily x:Key="Font.Numeric">Segoe UI</FontFamily>
  <Color x:Key="Elevation.Color">#0B1220</Color>
  <sys:Double x:Key="Font.Caption">11</sys:Double>
  <sys:Double x:Key="Font.Small">12</sys:Double>
  <sys:Double x:Key="Font.Body">13</sys:Double>
  <sys:Double x:Key="Font.Subtitle">15</sys:Double>
  <sys:Double x:Key="Font.Heading">18</sys:Double>
  <sys:Double x:Key="Font.Display">24</sys:Double>
  <sys:Double x:Key="Font.Icon">14</sys:Double>

  <sys:Double x:Key="Density.Row">28</sys:Double>
  <sys:Double x:Key="Control.Height">30</sys:Double>
  <sys:Double x:Key="Control.Compact">26</sys:Double>
  <sys:Double x:Key="Grid.RowHeight">28</sys:Double>
  <sys:Double x:Key="Grid.ColumnHeaderHeight">32</sys:Double>
  <sys:Double x:Key="CommandBar.Height">38</sys:Double>
  <sys:Double x:Key="Dialog.Width">520</sys:Double>
  <!-- Window standard (design system "Windows and opening"): dialog-s / dialog-m / dialog-l, document, tool. -->
  <sys:Double x:Key="Dialog.Small">480</sys:Double>
  <sys:Double x:Key="Dialog.Medium">760</sys:Double>
  <sys:Double x:Key="Dialog.Large">980</sys:Double>
  <sys:Double x:Key="Window.DocumentWidth">1100</sys:Double>
  <sys:Double x:Key="Window.DocumentHeight">720</sys:Double>
  <sys:Double x:Key="Window.ToolWidth">1280</sys:Double>
  <sys:Double x:Key="Window.ToolHeight">820</sys:Double>
  <sys:Double x:Key="Window.MinimumWidth">640</sys:Double>
  <sys:Double x:Key="Window.MinimumHeight">350</sys:Double>
  <sys:Double x:Key="Window.CompactNavigationWidth">1180</sys:Double>
  <sys:Double x:Key="Workspace.MinimumHeight">520</sys:Double>
  <sys:Double x:Key="TopBar.Height">48</sys:Double>
  <GridLength x:Key="TopBar.RowHeight">48</GridLength>
  <sys:Double x:Key="Rail.Width">232</sys:Double>
  <sys:Double x:Key="Rail.Collapsed">52</sys:Double>
  <sys:Double x:Key="StatusBar.Height">26</sys:Double>

  <Thickness x:Key="Space.Control">8,3</Thickness>
  <Thickness x:Key="Space.Section">12</Thickness>
  <Thickness x:Key="Space.Page">16,12,16,12</Thickness>
  <Thickness x:Key="Space.DocumentHeader">12,8</Thickness>
  <Thickness x:Key="Space.Window">12</Thickness>
  <Thickness x:Key="Space.Field">0,0,0,10</Thickness>
  <Thickness x:Key="Space.Label">0,0,0,3</Thickness>

  <CornerRadius x:Key="Radius.Panel">8</CornerRadius>
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Badge">10</CornerRadius>
  <CornerRadius x:Key="Radius.Small">2</CornerRadius>
  <CornerRadius x:Key="Radius.Dialog">12</CornerRadius>

  <!-- Petra Design System scales. Spacing is a 4 px grid; use these instead of literal margins in new XAML. -->
  <sys:Double x:Key="Space.1">4</sys:Double>
  <sys:Double x:Key="Space.2">8</sys:Double>
  <sys:Double x:Key="Space.3">12</sys:Double>
  <sys:Double x:Key="Space.4">16</sys:Double>
  <sys:Double x:Key="Space.6">24</sys:Double>
  <Thickness x:Key="Gap.Inline">0,0,8,0</Thickness>
  <Thickness x:Key="Gap.Stack">0,0,0,8</Thickness>
  <Thickness x:Key="Gap.Card">4</Thickness>
  <Thickness x:Key="Pad.Card">12,10</Thickness>
  <Thickness x:Key="Pad.Dialog">22,18</Thickness>
  <sys:Double x:Key="Font.Title">20</sys:Double>
  <sys:Double x:Key="Font.Kpi">22</sys:Double>
  <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>

  <!-- Density tokens. Standard values below; WpfThemeService overrides Density.* at the application level for the
       Compact (24) and Comfortable (34) modes. Styles that must follow density use DynamicResource. -->
  <sys:Double x:Key="Density.Compact.Row">24</sys:Double>
  <sys:Double x:Key="Density.Comfortable.Row">34</sys:Double>
  <Thickness x:Key="Density.CellPadding">6,1</Thickness>

  <!-- Elevation: 1 = toasts and popups, 2 = palette, 3 = modal dialogs. Shadows never carry meaning. -->
  <DropShadowEffect x:Key="Elevation.1" BlurRadius="10" ShadowDepth="1" Opacity="0.14" Color="{StaticResource Elevation.Color}"/>
  <DropShadowEffect x:Key="Elevation.2" BlurRadius="18" ShadowDepth="3" Opacity="0.2" Color="{StaticResource Elevation.Color}"/>
  <DropShadowEffect x:Key="Elevation.3" BlurRadius="28" ShadowDepth="5" Opacity="0.26" Color="{StaticResource Elevation.Color}"/>

  <Style x:Key="KeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource Focus}" BorderThickness="2" CornerRadius="4" Margin="-2"/></ControlTemplate></Setter.Value></Setter></Style>
  <ControlTemplate x:Key="InputValidation"><DockPanel><TextBlock DockPanel.Dock="Bottom" Foreground="{DynamicResource Error}" FontSize="{StaticResource Font.Caption}" Text="{Binding [0].ErrorContent}"/><Border BorderBrush="{DynamicResource Error}" BorderThickness="1" CornerRadius="4"><AdornedElementPlaceholder/></Border></DockPanel></ControlTemplate>

  <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource Font.Family}"/><Setter Property="FontSize" Value="{StaticResource Font.Body}"/><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><!-- One numeral set everywhere: Latin digits in both Arabic and English UI (inherited by every element of the window). --><Setter Property="NumberSubstitution.Substitution" Value="European"/></Style>
  <!-- Secondary windows. Every modal dialog uses Window.Dialog, every non-modal tool window (report viewer, print preview,
       template designer) Window.Tool; both are opened through Shell/PetraWindows, which also sets the owner and copies the
       owner's FlowDirection and Language when the window does not bind its own. -->
  <Style x:Key="Window.Dialog" TargetType="Window" BasedOn="{StaticResource {x:Type Window}}">
    <!-- WindowStartupLocation is not a dependency property: windows declare CenterOwner themselves, PetraWindows enforces it. -->
    <Setter Property="ShowInTaskbar" Value="False"/>
    <Setter Property="ResizeMode" Value="CanResizeWithGrip"/><Setter Property="Background" Value="{DynamicResource App.Background}"/>
  </Style>
  <Style x:Key="Window.Tool" TargetType="Window" BasedOn="{StaticResource Window.Dialog}">
    <Setter Property="ShowInTaskbar" Value="True"/>
  </Style>
  <Style TargetType="UserControl"><Setter Property="FontFamily" Value="{StaticResource Font.Family}"/><Setter Property="FontSize" Value="{StaticResource Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Style>
  <Style TargetType="Control"><Setter Property="FontSize" Value="{StaticResource Font.Body}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Input}"/></Style>
  <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Padding" Value="{StaticResource Space.Control}"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="{DynamicResource Density.Row}"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidation}"/><Setter Property="Padding" Value="{StaticResource Space.Control}"/><Setter Property="MinHeight" Value="{DynamicResource Density.Row}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/></Style>
  <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidation}"/><Setter Property="Padding" Value="{StaticResource Space.Control}"/><Setter Property="MinHeight" Value="{DynamicResource Density.Row}"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Validation.ErrorTemplate" Value="{StaticResource InputValidation}"/><Setter Property="MinHeight" Value="{DynamicResource Density.Row}"/><Setter Property="Margin" Value="2"/><Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/></Style>
  <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/><Setter Property="Margin" Value="0,3"/></Style>
  <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="MinHeight" Value="{DynamicResource Density.Row}"/><Setter Property="Margin" Value="2"/></Style>
  <!-- Use the localized field label above the picker; do not expose the framework's English-only watermark. -->
  <Style TargetType="primitives:DatePickerTextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>
  <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Setter Property="Background" Value="{DynamicResource Input}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/></Style>
  <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
    <Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="CanUserResizeColumns" Value="True"/><Setter Property="CanUserReorderColumns" Value="True"/>
    <Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="RowHeight" Value="{DynamicResource Density.Row}"/><Setter Property="ColumnHeaderHeight" Value="{DynamicResource Grid.ColumnHeaderHeight}"/><Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="RowHeaderWidth" Value="0"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Divider}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="RowBackground" Value="{DynamicResource Surface.Primary}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource Grid.Alternate}"/>
    <Setter Property="ClipboardCopyMode" Value="IncludeHeader"/><Setter Property="SelectionUnit" Value="CellOrRowHeader"/>
  </Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="8,5"/><Setter Property="Background" Value="{DynamicResource Grid.Header}"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="{StaticResource Font.Small}"/><Setter Property="BorderBrush" Value="{DynamicResource Divider}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridRowHeader"><Setter Property="Background" Value="{DynamicResource Alternate}"/><Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{DynamicResource Divider}"/><Setter Property="BorderThickness" Value="0,0,1,1"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="{DynamicResource Density.CellPadding}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Grid.Selection}"/><Setter Property="Foreground" Value="{DynamicResource Text}"/></Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Grid.ActiveCell}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>

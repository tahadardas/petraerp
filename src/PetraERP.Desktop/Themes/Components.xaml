<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls" xmlns:loc="clr-namespace:PetraERP.Desktop.Localization">
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <ux:VisibilityConverter x:Key="Show"/>
  <ux:EqualityConverter x:Key="Equal"/>
  <ux:FavoriteStateConverter x:Key="FavoriteState"/>
  <ux:GuidOrNullConverter x:Key="GuidOrNull"/>
  <ux:MoneyConverter x:Key="Money"/>
  <ux:EntryLookupConverter x:Key="EntryLookups"/>
  <ux:RequiredCaptionConverter x:Key="RequiredCaption"/>
  <ux:DocumentNumberCaptionConverter x:Key="DocumentNumberCaption"/>
  <ux:MoneyOrBlankConverter x:Key="MoneyBlank"/>
  <ux:DateTextConverter x:Key="DateText"/>
  <ux:IndentConverter x:Key="Indent"/>
  <loc:LocalizedLabelConverter x:Key="NameLabel"/>
  <loc:StandardLabelConverter x:Key="EnumLabel"/>
  <ux:NumberConverter x:Key="Number"/>
  <ux:NegativeNumberConverter x:Key="IsNegative"/>
  <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.PageTitle}"/>
  <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FontSize" Value="{StaticResource Font.Body}"/>
    <Setter Property="NumberSubstitution.Substitution" Value="European"/>
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource Font.Heading}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
  </Style>
  <Style x:Key="Text.Section" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource Font.Subtitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="Text.Subheading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Section}"/>
  <Style x:Key="Text.Heading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.PageTitle}"/>
  <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
    <Setter Property="Margin" Value="{StaticResource Space.Label}"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>
  <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Text.Value" TargetType="{x:Type TextBlock}">
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="Text.Numeric" TargetType="{x:Type TextBlock}">
    <Setter Property="TextBlock.Padding" Value="4,0"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="FrameworkElement.ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="FlowDirection" Value="LeftToRight"/>
    <Setter Property="TextBlock.TextAlignment" Value="Right"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    <Setter Property="Typography.NumeralStyle" Value="Lining"/>
    <Setter Property="NumberSubstitution.Substitution" Value="European"/>
    <Style.Triggers>
      <DataTrigger Value="True" Binding="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource IsNegative}}">
        <Setter Property="Foreground" Value="{DynamicResource Numeric.Negative}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Text.NumericEditor" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FlowDirection" Value="LeftToRight"/>
    <Setter Property="TextBox.TextAlignment" Value="Right"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Numeric}"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    <Setter Property="NumberSubstitution.Substitution" Value="European"/>
  </Style>
  <Style x:Key="Text.NumericTotal" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Numeric}">
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="Text.Icon" TargetType="{x:Type TextBlock}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
    <Setter Property="FontSize" Value="{StaticResource Font.Icon}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="Text.Error" TargetType="{x:Type TextBlock}">
    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="FontSize" Value="{StaticResource Font.Small}"/>
  </Style>
  <Style x:Key="Panel.Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Border.CornerRadius" Value="{StaticResource Radius.Panel}"/>
    <Setter Property="Border.Padding" Value="{StaticResource Space.Section}"/>
  </Style>
  <Style x:Key="Panel.Flat" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Border.CornerRadius" Value="{StaticResource Radius.Panel}"/>
  </Style>
  <Style x:Key="Panel.CommandBar" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Input}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Border.CornerRadius" Value="{StaticResource Radius.Panel}"/>
    <Setter Property="Border.Padding" Value="4,2"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="Panel.Filter" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.CommandBar}">
    <Setter Property="Border.Padding" Value="8,4,8,6"/>
  </Style>
  <Style x:Key="Panel.Summary" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource Alternate}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Border.CornerRadius" Value="{StaticResource Radius.Control}"/>
    <Setter Property="Border.Padding" Value="10,6"/>
  </Style>
  <Style x:Key="Field" TargetType="{x:Type StackPanel}">
    <Setter Property="Margin" Value="{StaticResource Space.Field}"/>
  </Style>
  <Style x:Key="Button.Command" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="{DynamicResource Control.Height}"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,6,0" Style="{StaticResource Text.Icon}" Text="{Binding (ux:Icon.Glyph), RelativeSource={RelativeSource AncestorType=Button}}"/>
            <TextBlock Text="{Binding}"/>
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Surface.Recessed}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brand.TealSubtle}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="UIElement.Opacity" Value="0.45"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Command}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.OnAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Accent.Hover}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brand.Navy}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Button.Financial" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Command}">
    <Setter Property="Background" Value="{DynamicResource Brand.Navy}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text.OnBrand}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Brand.Teal}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brand.NavyHover}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brand.Teal}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Command}">
    <Setter Property="Foreground" Value="{DynamicResource Error}"/>
  </Style>
  <Style x:Key="Button.Subtle" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Command}"/>
  <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinWidth" Value="{DynamicResource Control.Height}"/>
    <Setter Property="MinHeight" Value="{DynamicResource Control.Height}"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="FontFamily" Value="{StaticResource Font.Icons}"/>
    <Setter Property="FontSize" Value="{StaticResource Font.Icon}"/>
  </Style>
  <Style x:Key="Button.TopBar" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Icon}">
    <Setter Property="Foreground" Value="{DynamicResource TopBar.Text}"/>
  </Style>
  <Style x:Key="Separator.Command" TargetType="{x:Type Border}">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Margin" Value="6,6"/>
    <Setter Property="Background" Value="{DynamicResource Divider}"/>
  </Style>
  <Style x:Key="NavItem" TargetType="{x:Type RadioButton}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
    <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    <Setter Property="FrameworkElement.Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border Name="Root" Background="Transparent" Margin="6,1" Padding="0" MinHeight="34" CornerRadius="{StaticResource Radius.Control}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Name="Indicator" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,8" Visibility="Hidden"/>
              <TextBlock Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource Text.Icon}" Text="{Binding (ux:Icon.Glyph), RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter Name="Label" Grid.Column="2" VerticalAlignment="Center" TextElement.FontWeight="Normal"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Value="{DynamicResource Alternate}" Property="Border.Background"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Root" Value="{DynamicResource Accent.Subtle}" Property="Border.Background"/>
              <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Label" Property="TextElement.FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ux:StatusBadge}" TargetType="{x:Type ux:StatusBadge}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="AutomationProperties.Name" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:StatusBadge}">
          <Border Name="Chip" Padding="8,1,10,2" Background="{DynamicResource Neutral.Subtle}" CornerRadius="{StaticResource Radius.Badge}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="Glyph" FontSize="10" Text="" Foreground="{DynamicResource Neutral}" Margin="0,0,5,0" Style="{StaticResource Text.Icon}"/>
              <TextBlock Name="Label" Text="{TemplateBinding ux:StatusBadge.Text}" FontWeight="SemiBold" Foreground="{DynamicResource Neutral}" FontSize="{StaticResource Font.Small}"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ux:StatusBadge.Kind" Value="Info">
              <Setter TargetName="Chip" Value="{DynamicResource Info.Subtle}" Property="Border.Background"/>
              <Setter TargetName="Glyph" Value="{DynamicResource Info}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Label" Value="{DynamicResource Info}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Glyph" Property="TextBlock.Text" Value=""/>
            </Trigger>
            <Trigger Property="ux:StatusBadge.Kind" Value="Accent">
              <Setter TargetName="Chip" Value="{DynamicResource Accent.Subtle}" Property="Border.Background"/>
              <Setter TargetName="Glyph" Value="{DynamicResource Accent}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Label" Value="{DynamicResource Accent}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Glyph" Property="TextBlock.Text" Value=""/>
            </Trigger>
            <Trigger Property="ux:StatusBadge.Kind" Value="Success">
              <Setter TargetName="Chip" Value="{DynamicResource Success.Subtle}" Property="Border.Background"/>
              <Setter TargetName="Glyph" Value="{DynamicResource Success}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Label" Value="{DynamicResource Success}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Glyph" Property="TextBlock.Text" Value=""/>
            </Trigger>
            <Trigger Property="ux:StatusBadge.Kind" Value="Warning">
              <Setter TargetName="Chip" Value="{DynamicResource Warning.Subtle}" Property="Border.Background"/>
              <Setter TargetName="Glyph" Value="{DynamicResource Warning}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Label" Value="{DynamicResource Warning}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Glyph" Property="TextBlock.Text" Value=""/>
            </Trigger>
            <Trigger Property="ux:StatusBadge.Kind" Value="Error">
              <Setter TargetName="Chip" Value="{DynamicResource Error.Subtle}" Property="Border.Background"/>
              <Setter TargetName="Glyph" Value="{DynamicResource Error}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Label" Value="{DynamicResource Error}" Property="TextBlock.Foreground"/>
              <Setter TargetName="Glyph" Property="TextBlock.Text" Value=""/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ux:RecordNavigator}" TargetType="{x:Type ux:RecordNavigator}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:RecordNavigator}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="" Command="{TemplateBinding ux:RecordNavigator.FirstCommand}" ToolTip="السجل الأول (Ctrl+Home)" MinWidth="26" MinHeight="26" Padding="2" Margin="1,0" Style="{StaticResource Button.Icon}"/>
            <Button Content="" Command="{TemplateBinding ux:RecordNavigator.PreviousCommand}" ToolTip="السجل السابق (Ctrl+PageUp)" MinWidth="26" MinHeight="26" Padding="2" Margin="1,0" Style="{StaticResource Button.Icon}"/>
            <Border Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" MinWidth="80" Height="26" Margin="2,0" VerticalAlignment="Center" Padding="4,0">
              <TextBox x:Name="PART_RecordInput" Text="{Binding RecordNumber, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextAlignment="Center"
                       FlowDirection="LeftToRight" FontSize="{StaticResource Font.Small}" Background="Transparent" BorderThickness="0"
                       ToolTip="انتقال مباشر برقم السند/الفاتورة (أدخل الرقم ثم اضغط Enter)"/>
            </Border>
            <Button Content="" Command="{TemplateBinding ux:RecordNavigator.JumpCommand}" CommandParameter="{Binding Text, ElementName=PART_RecordInput}"
                    ToolTip="انتقال مباشر برقم السند/الفاتورة" MinWidth="24" MinHeight="26" Padding="2" Margin="1,0" Style="{StaticResource Button.Icon}"
                    Visibility="{Binding JumpCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Show}}"/>
            <Button Content="" Command="{TemplateBinding ux:RecordNavigator.NextCommand}" ToolTip="السجل التالي (Ctrl+PageDown)" MinWidth="26" MinHeight="26" Padding="2" Margin="1,0" Style="{StaticResource Button.Icon}"/>
            <Button Content="" Command="{TemplateBinding ux:RecordNavigator.LastCommand}" ToolTip="السجل الأخير (Ctrl+End)" MinWidth="26" MinHeight="26" Padding="2" Margin="1,0" Style="{StaticResource Button.Icon}"/>
            <ux:StatusBadge Text="{TemplateBinding ux:RecordNavigator.StatusText}" Kind="{TemplateBinding ux:RecordNavigator.StatusKind}" Margin="6,0,0,0" Visibility="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Show}}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ux:DocumentTotalsBar}" TargetType="{x:Type ux:DocumentTotalsBar}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:DocumentTotalsBar}">
          <Border Padding="8,4" Margin="0,4,0,0" Style="{StaticResource Panel.Summary}">
            <DockPanel LastChildFill="True">
              <!-- Live Tafqeet Banner -->
              <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Sunken}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,4,0,0"
                      Visibility="{Binding ShowTafqeet, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                <DockPanel>
                  <TextBlock Text="التفقيط:" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.TafqeetText}" Foreground="{DynamicResource Text.Primary}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                <Border Background="{DynamicResource Accent}" CornerRadius="4" Padding="12,4" MinWidth="130" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.GrandTotal}" Foreground="{DynamicResource Text.OnAccent}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" Style="{StaticResource Text.NumericTotal}"/>
                    <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.CurrencyCode}" Foreground="{DynamicResource Text.OnAccent}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="مجموع جزئي:" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.SubTotal}" Style="{StaticResource Text.NumericTotal}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="الكميات:" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.TotalQuantity}" Style="{StaticResource Text.Numeric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="الحسم:" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.DiscountTotal}" Style="{StaticResource Text.Numeric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                  <TextBlock Text="الضريبة:" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.TaxTotal}" Style="{StaticResource Text.Numeric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding AdditionsTotal, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Show}}">
                  <TextBlock Text="الإضافات:" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.AdditionsTotal}" Style="{StaticResource Text.Numeric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding HasSettlement, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                  <TextBlock Text="المسدد:" Margin="0,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.SettledTotal}" Style="{StaticResource Text.Numeric}"/>
                  <TextBlock Text="المرتجع:" Margin="8,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.ReturnedTotal}" Style="{StaticResource Text.Numeric}"/>
                  <TextBlock Text="المتبقي:" FontWeight="Bold" Margin="8,0,4,0" VerticalAlignment="Center" Style="{StaticResource Text.Label}"/>
                  <TextBlock Text="{TemplateBinding ux:DocumentTotalsBar.OutstandingTotal}" FontWeight="Bold" Style="{StaticResource Text.NumericTotal}"/>
                </StackPanel>
                <ContentPresenter Content="{TemplateBinding ux:DocumentTotalsBar.ExtraContent}" VerticalAlignment="Center"/>
              </WrapPanel>
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ux:EmptyState}" TargetType="{x:Type ux:EmptyState}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:EmptyState}">
          <StackPanel MaxWidth="360" Margin="16">
            <TextBlock FontSize="28" Text="{TemplateBinding ux:EmptyState.Glyph}" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,0,0,8" Style="{StaticResource Text.Icon}"/>
            <TextBlock Text="{TemplateBinding ux:EmptyState.Title}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="{StaticResource Font.Subtitle}"/>
            <TextBlock Text="{TemplateBinding ux:EmptyState.Message}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" Style="{StaticResource Text.Caption}"/>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ux:PageHeader}" TargetType="{x:Type ux:PageHeader}">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:PageHeader}">
          <WrapPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{TemplateBinding ux:PageHeader.Title}" AutomationProperties.HeadingLevel="Level1" Style="{StaticResource Text.PageTitle}"/>
              <ContentPresenter Content="{TemplateBinding ux:PageHeader.Status}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Text="{TemplateBinding ux:PageHeader.Subtitle}" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
            </StackPanel>
            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding ux:PageHeader.Commands}" VerticalAlignment="Center"/>
          </WrapPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ux:LookupPicker}" TargetType="{x:Type ux:LookupPicker}">
    <Setter Property="MinHeight" Value="{DynamicResource Density.Row}"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:LookupPicker}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="28"/>
            </Grid.ColumnDefinitions>
            <TextBox Name="PART_Text" IsReadOnly="{TemplateBinding ux:LookupPicker.IsReadOnly}" MinHeight="{TemplateBinding FrameworkElement.MinHeight}" Margin="0" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" ToolTip="{TemplateBinding ux:LookupPicker.Placeholder}"/>
            <Button Name="PART_Open" Grid.Column="1" Content="" FontSize="11" MinWidth="28" Padding="2" Focusable="False" ToolTip="{TemplateBinding ux:LookupPicker.Placeholder}" AutomationProperties.Name="{TemplateBinding ux:LookupPicker.Placeholder}" Style="{StaticResource Button.Icon}"/>
            <Popup Name="PART_Popup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=PART_Text}" MinWidth="{Binding ActualWidth, ElementName=PART_Text}">
              <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource Border}" BorderThickness="1" MaxHeight="280" MinWidth="320" CornerRadius="{StaticResource Radius.Control}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="{DynamicResource Info.Subtle}" Padding="8,4" Visibility="{Binding IsSearching, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                    <DockPanel>
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Info}"/>
                      <TextBlock Text="جاري البحث في السجلات... / Searching records..." Foreground="{DynamicResource Info}" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                    </DockPanel>
                  </Border>
                  <Border Grid.Row="0" Background="{DynamicResource Error.Subtle}" Padding="8,4" Visibility="{Binding HasSearchError, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Visible}}">
                    <DockPanel>
                      <TextBlock Text="" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource ErrorSurface}"/>
                      <TextBlock Foreground="{DynamicResource ErrorSurface}" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding SearchErrorMessage, FallbackValue=فشل البحث / Search failed, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </DockPanel>
                  </Border>
                  <ListBox Name="PART_List" Grid.Row="1" ItemsSource="{TemplateBinding ux:LookupPicker.Results}" Background="Transparent" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <TextBlock FontWeight="SemiBold" MinWidth="90" FlowDirection="LeftToRight" TextAlignment="Left" Text="{Binding Code}"/>
                          <TextBlock Margin="8,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding NameArabic}"/>
                          <TextBlock Margin="8,0,0,0" Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" Text="{Binding NameEnglish}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ListBox>
                  <Border Grid.Row="2" Padding="12,8" HorizontalAlignment="Center">
                    <FrameworkElement.Style>
                      <Style TargetType="{x:Type Border}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Value="0" Binding="{Binding Results.Count, RelativeSource={RelativeSource TemplatedParent}}"/>
                              <Condition Value="False" Binding="{Binding IsSearching, RelativeSource={RelativeSource TemplatedParent}}"/>
                              <Condition Value="False" Binding="{Binding HasSearchError, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </FrameworkElement.Style>
                    <TextBlock Text="لا توجد نتائج مطابقة / No matching results" Foreground="{DynamicResource Text.Secondary}" Style="{StaticResource Text.Caption}"/>
                  </Border>
                </Grid>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="Petra.TextBoxTemplate" TargetType="{x:Type ux:PetraTextBox}">
    <Border Name="Frame" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" CornerRadius="{StaticResource Radius.Control}">
      <Grid>
        <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        <TextBlock Name="Hint" Text="{TemplateBinding ux:PetraTextBox.Placeholder}" Foreground="{DynamicResource Text.Muted}" Margin="{TemplateBinding Control.Padding}" Padding="2,0" IsHitTestVisible="False" Visibility="Collapsed" TextAlignment="{TemplateBinding TextBox.TextAlignment}" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="TextBox.Text" Value="">
        <Setter TargetName="Hint" Property="UIElement.Visibility" Value="Visible"/>
      </Trigger>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter TargetName="Frame" Value="{DynamicResource Border.Strong}" Property="Border.BorderBrush"/>
      </Trigger>
      <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
        <Setter TargetName="Frame" Value="{DynamicResource Focus}" Property="Border.BorderBrush"/>
        <Setter TargetName="Hint" Property="UIElement.Visibility" Value="Collapsed"/>
      </Trigger>
      <Trigger Property="TextBoxBase.IsReadOnly" Value="True">
        <Setter TargetName="Frame" Value="{DynamicResource Surface.Sunken}" Property="Border.Background"/>
      </Trigger>
      <Trigger Property="UIElement.IsEnabled" Value="False">
        <Setter Value="{DynamicResource Text.Disabled}" Property="Control.Foreground"/>
        <Setter TargetName="Frame" Property="UIElement.Opacity" Value="0.7"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

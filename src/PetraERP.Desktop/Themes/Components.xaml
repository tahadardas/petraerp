  <Style x:Key="{x:Type ux:LoadingHost}" TargetType="{x:Type ux:LoadingHost}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ux:LoadingHost}">
          <DockPanel>
            <Border Name="Unknown" DockPanel.Dock="Top" Background="{DynamicResource Warning.Subtle}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" Padding="10,6" Margin="0,0,0,6" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{TemplateBinding ux:LoadingHost.UnknownText}" CornerRadius="{StaticResource Radius.Control}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="" Foreground="{DynamicResource Warning}" Margin="0,0,8,0" Style="{StaticResource Text.Icon}"/>
                <StackPanel>
                  <TextBlock Text="{TemplateBinding ux:LoadingHost.UnknownText}" FontWeight="SemiBold" Foreground="{DynamicResource Warning}"/>
                  <TextBlock Text="{TemplateBinding ux:LoadingHost.UnknownHelpText}" Style="{StaticResource Text.Caption}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Grid>
              <ContentPresenter/>
              <ProgressBar Name="RefreshBar" IsIndeterminate="False" Height="2" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
              <Border Name="RefreshStatic" Height="2" Width="48" HorizontalAlignment="Center" VerticalAlignment="Top" Background="{DynamicResource Brand.Teal}" Visibility="Collapsed" IsHitTestVisible="False"/>
              <Border Name="Skeleton" Background="{DynamicResource App.Background}" Visibility="Collapsed" AutomationProperties.Name="{TemplateBinding ux:LoadingHost.StatusText}" AutomationProperties.LiveSetting="Polite">
                <Grid Margin="4,8">
                  <Grid Name="ListSkeleton">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ux:SkeletonBlock Height="24" Width="250" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                      <ux:SkeletonBlock Height="30" Margin="2"/>
                      <ux:SkeletonBlock Height="30" Margin="2"/>
                      <ux:SkeletonBlock Height="30" Margin="2"/>
                      <ux:SkeletonBlock Height="30" Margin="2"/>
                    </UniformGrid>
                    <StackPanel Grid.Row="2">
                      <ux:SkeletonBlock Height="32"/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                    </StackPanel>
                  </Grid>
                  <Grid Name="DocumentSkeleton" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="4" Margin="0,0,0,10">
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                      <ux:SkeletonBlock Height="48" Margin="3"/>
                    </UniformGrid>
                    <StackPanel Grid.Row="1">
                      <ux:SkeletonBlock Height="32"/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                    </StackPanel>
                    <UniformGrid Grid.Row="2" Columns="5" Margin="0,8,0,0">
                      <ux:SkeletonBlock Height="38" Margin="3"/>
                      <ux:SkeletonBlock Height="38" Margin="3"/>
                      <ux:SkeletonBlock Height="38" Margin="3"/>
                      <ux:SkeletonBlock Height="38" Margin="3"/>
                      <ux:SkeletonBlock Height="38" Margin="3"/>
                    </UniformGrid>
                  </Grid>
                  <Grid Name="TreeSkeleton" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*"/>
                      <ColumnDefinition Width="12"/>
                      <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <ux:SkeletonBlock Height="30"/>
                      <ux:SkeletonBlock Width="260" HorizontalAlignment="Left"/>
                      <ux:SkeletonBlock Width="230" HorizontalAlignment="Left"/>
                      <ux:SkeletonBlock Width="200" HorizontalAlignment="Left"/>
                      <ux:SkeletonBlock Width="245" HorizontalAlignment="Left"/>
                      <ux:SkeletonBlock Width="180" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <ux:SkeletonBlock Height="26" Width="240" HorizontalAlignment="Left"/>
                      <ux:SkeletonBlock Height="70"/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock Width="360" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Grid>
                  <Grid Name="ReportSkeleton" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="5">
                      <ux:SkeletonBlock Height="46" Margin="3"/>
                      <ux:SkeletonBlock Height="46" Margin="3"/>
                      <ux:SkeletonBlock Height="46" Margin="3"/>
                      <ux:SkeletonBlock Height="46" Margin="3"/>
                      <ux:SkeletonBlock Height="46" Margin="3"/>
                    </UniformGrid>
                    <ux:SkeletonBlock Grid.Row="1" Height="28" Margin="0,12,0,4"/>
                    <StackPanel Grid.Row="2">
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                      <ux:SkeletonBlock/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <Grid Name="Submitting" Background="{DynamicResource Overlay}" Visibility="Collapsed" Cursor="Wait">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,12" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{TemplateBinding ux:LoadingHost.StatusText}" Style="{StaticResource Panel.Card}" Effect="{StaticResource Elevation.2}">
                  <StackPanel Orientation="Horizontal">
                    <ProgressBar Name="SubmitBar" IsIndeterminate="False" Width="60" Height="4" Margin="0,0,12,0"/>
                    <TextBlock Name="SubmitStatic" Text="●" Foreground="{DynamicResource Brand.Teal}" Margin="0,0,12,0" Visibility="Collapsed"/>
                    <TextBlock Text="{TemplateBinding ux:LoadingHost.StatusText}" FontWeight="SemiBold"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ux:LoadingHost.IsOutcomeUnknown" Value="True">
              <Setter TargetName="Unknown" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ux:LoadingHost.IsRefreshing" Value="True">
              <Setter TargetName="RefreshBar" Property="Visibility" Value="Visible"/>
              <Setter TargetName="RefreshBar" Property="ProgressBar.IsIndeterminate" Value="True"/>
            </Trigger>
            <Trigger Property="ux:LoadingHost.ShowSkeleton" Value="True">
              <Setter TargetName="Skeleton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ux:LoadingHost.SkeletonProfile" Value="Document">
              <Setter TargetName="ListSkeleton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="DocumentSkeleton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ux:LoadingHost.SkeletonProfile" Value="Tree">
              <Setter TargetName="ListSkeleton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="TreeSkeleton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ux:LoadingHost.SkeletonProfile" Value="Report">
              <Setter TargetName="ListSkeleton" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="ReportSkeleton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="ux:LoadingHost.IsSubmitting" Value="True">
              <Setter TargetName="Submitting" Property="Visibility" Value="Visible"/>
              <Setter TargetName="SubmitBar" Property="ProgressBar.IsIndeterminate" Value="True"/>
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding IsRefreshing, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Condition Value="False" Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="RefreshBar" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="RefreshStatic" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Value="True" Binding="{Binding IsSubmitting, RelativeSource={RelativeSource TemplatedParent}}"/>
                <Condition Value="False" Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}"/>
              </MultiDataTrigger.Conditions>
              <Setter TargetName="SubmitBar" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="SubmitStatic" Property="Visibility" Value="Visible"/>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="PetraERP.Desktop.Sales.SalesInvoiceCardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls" Background="{DynamicResource Surface.Secondary}" xmlns:sales="clr-namespace:PetraERP.Desktop.Sales" ux:ValidationFocus.Target="{Binding ValidationFocusTarget}" ux:ValidationFocus.Request="{Binding ValidationFocusRequest}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ux:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <UIElement.InputBindings>
    <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
    <KeyBinding Key="Escape" Command="{Binding CancelCardCommand}"/>
    <KeyBinding Key="E" Modifiers="Control" Command="{Binding BeginEditCommand}"/>
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCardCommand}"/>
    <KeyBinding Key="N" Modifiers="Control" Command="{Binding BeginNewCommand}"/>
    <KeyBinding Key="F8" Command="{Binding ToggleInvoiceInfoCommand}"/>
    <KeyBinding Key="Home" Modifiers="Control" Command="{Binding FirstCommand}"/>
    <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousCommand}"/>
    <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextCommand}"/>
    <KeyBinding Key="End" Modifiers="Control" Command="{Binding LastCommand}"/>
  </UIElement.InputBindings>
  <Grid>
    <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Danger}" BorderThickness="0,0,0,2" Padding="8,6" Visibility="{Binding HasLookupsError, Converter={StaticResource Visible}}">
      <DockPanel>
        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Command}" Content="إعادة المحاولة" Command="{Binding RetryLookupsCommand}"/>
        <TextBlock Text="{Binding LookupsError}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="8,0"/>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,2">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,2,0,2">
          <TextBlock Text="العميل" Width="70" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ux:LookupPicker Grid.Row="0" ux:ValidationFocus.Key="customer" Placeholder="🔍  ابحث بالاسم أو الرمز..." IsArabic="True" ItemsSource="{Binding CustomerLookups, Converter={StaticResource EntryLookups}}" AsyncSearchProvider="{Binding SearchCustomersAsync}" SelectedId="{Binding DraftCustomerId}" IsEnabled="{Binding IsEditing}"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,0" Visibility="{Binding HasSelectedCustomer, Converter={StaticResource Visible}}">
              <Border Background="{DynamicResource Accent.Subtle}" CornerRadius="{DynamicResource Radius.Small}" Padding="4,1" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="الرصيد: " Style="{StaticResource Text.Caption}"/>
                  <TextBlock Text="{Binding CustomerCurrentBalanceDisplay}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" FlowDirection="LeftToRight"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource Info.Subtle}" CornerRadius="{DynamicResource Radius.Small}" Padding="4,1" Margin="0,0,4,0" Visibility="{Binding HasCustomerCreditLimit, Converter={StaticResource Visible}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="سقف الائتمان: " Style="{StaticResource Text.Caption}"/>
                  <TextBlock Text="{Binding CustomerCreditLimitDisplay}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" FlowDirection="LeftToRight"/>
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource Error.Subtle}" CornerRadius="{DynamicResource Radius.Small}" Padding="4,1" Visibility="{Binding IsCustomerCreditBlocked, Converter={StaticResource Visible}}">
                <TextBlock Text="⛔ ائتمان موقوف" Style="{StaticResource Text.Caption}" FontWeight="Bold" Foreground="{DynamicResource Error}"/>
              </Border>
            </StackPanel>
          </Grid>
        </DockPanel>
        <DockPanel Grid.Row="0" Grid.Column="2" Margin="0,2,0,2" LastChildFill="False">
          <ux:RecordNavigator DockPanel.Dock="Left" VerticalAlignment="Center" RecordNumber="{Binding RecordReference}" StatusText="{Binding StatusText}" FirstCommand="{Binding FirstCommand}" PreviousCommand="{Binding PreviousCommand}" NextCommand="{Binding NextCommand}" LastCommand="{Binding LastCommand}" JumpCommand="{Binding JumpCommand}"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0">
            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Success}" FontSize="15" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBlock Text="درجة السرية" Style="{StaticResource Am.Label}" Foreground="{DynamicResource Text.Primary}"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,2,0,2">
          <TextBlock Text="العملة" Width="70" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ux:ValidationFocus.Key="currency" IsEditable="False" Height="24" BorderBrush="{DynamicResource Border.Strong}" ItemsSource="{Binding CurrencyOptions}" SelectedItem="{Binding DraftCurrencyCode, Mode=TwoWay}" IsEnabled="{Binding IsEditing}"/>
            <TextBlock Grid.Column="1" Text="التعادل" Style="{StaticResource Am.Label}" Margin="8,0,6,0" VerticalAlignment="Center"/>
            <Grid Column="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ux:PetraNumericTextBox Grid.Column="0" ux:ValidationFocus.Key="rate" Kind="Rate" MaximumScale="5" Height="24" HorizontalContentAlignment="Center" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" Text="{Binding DraftExchangeRate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}"/>
              <TextBox Grid.Column="2" IsReadOnly="True" Height="24" HorizontalContentAlignment="Center" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" Text="{Binding DraftExchangeRate, Mode=OneWay}"/>
            </Grid>
          </Grid>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="0,2,0,2">
          <TextBlock Text="المستودع" Width="75" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <ux:LookupPicker ux:ValidationFocus.Key="warehouse" Placeholder="🔍  01-المستودع الرئيسي" IsArabic="True" ItemsSource="{Binding WarehouseLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftWarehouseId}" IsEnabled="{Binding IsEditing}"/>
        </DockPanel>
        <DockPanel Grid.Row="2" Grid.Column="0" Margin="0,2,0,2">
          <TextBlock Text="التاريخ" Width="70" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ux:PetraDatePicker Grid.Column="0" ux:ValidationFocus.Key="date" Height="24" SelectedDate="{Binding DraftInvoiceDate}" IsEnabled="{Binding IsEditing}"/>
            <TextBlock Grid.Column="1" Text="الدفع" Style="{StaticResource Am.Label}" Margin="8,0,6,0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="2" SelectedValuePath="Value" DisplayMemberPath="Label" Height="24" BorderBrush="{DynamicResource Border.Strong}" ItemsSource="{Binding PaymentMethodOptions}" SelectedValue="{Binding DraftPaymentMethod}" IsEnabled="{Binding IsEditing}"/>
          </Grid>
        </DockPanel>
        <DockPanel Grid.Row="2" Grid.Column="2" Margin="0,2,0,2">
          <TextBlock Text="حساب العميل" Width="75" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <ux:LookupPicker Placeholder="حساب العميل" IsArabic="True" ItemsSource="{Binding CustomerAccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftCustomerAccountId}" IsReadOnly="{Binding IsCustomerAccountReadOnly}" IsEnabled="{Binding IsEditing}" ToolTip="{Binding CustomerAccountHint}"/>
        </DockPanel>
        <DockPanel Grid.Row="3" Grid.Column="0" Margin="0,2,0,2">
          <TextBlock Text="البيان" Width="70" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <TextBox Height="24" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1" Text="{Binding DraftNotes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}"/>
        </DockPanel>
        <DockPanel Grid.Row="3" Grid.Column="2" Margin="0,2,0,2">
          <TextBlock Text="مركز الكلفة" Width="75" Style="{StaticResource Am.Label}" DockPanel.Dock="Right" TextAlignment="Right"/>
          <ux:LookupPicker Placeholder="🔍  مركز الكلفة..." IsArabic="True" ItemsSource="{Binding CostCenterLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftCostCenterId}" IsEnabled="{Binding IsEditing}"/>
        </DockPanel>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Bottom">
      
      <Border Background="{DynamicResource Surface.Secondary}" Padding="8,4">
        <DockPanel LastChildFill="False">
          <ux:DocumentCommandBar DockPanel.Dock="Right" Screen="{Binding}"/>
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
            <Button Style="{StaticResource Am.ActionButton}" ToolTip="معلومات الفاتورة (F8)" Command="{Binding ToggleInvoiceInfoCommand}" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Primary}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="معلومات الفاتورة" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Am.CloseActionButton}" ToolTip="إغلاق النافذة" Click="CloseClicked">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Error}" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="إغلاق" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
    </StackPanel>
    <ux:DocumentTotalsBar DockPanel.Dock="Bottom" GrandTotal="{Binding GrandTotalDisplay}" SubTotal="{Binding SubTotalDisplay}" DiscountTotal="{Binding DiscountTotalDisplay}" TaxTotal="{Binding TaxTotalDisplay}" AdditionsTotal="{Binding AdditionsTotalDisplay}" TotalQuantity="{Binding TotalQuantityDisplay}" CurrencyCode="{Binding DisplayCurrency}" HasSettlement="{Binding HasSettlement}" SettledTotal="{Binding SettledDisplay}" ReturnedTotal="{Binding ReturnedDisplay}" OutstandingTotal="{Binding OutstandingDisplay}"/>
    <Border Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="0,1,0,0">
      <ux:PetraAccountingDataGrid x:Name="LinesGrid" ux:ValidationFocus.Key="lines" EntryMode="True" ShowRowNumbers="True" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="All" GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource Divider}" VerticalGridLinesBrush="{DynamicResource Divider}" RowHeight="25" FontSize="12" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGrowCommand="{Binding AutoGrowCommand}" IsReadOnly="{Binding IsViewMode}">
        <UIElement.InputBindings>
          <KeyBinding Key="Insert" Command="{Binding AddLineCommand}"/>
          <KeyBinding Key="Delete" Modifiers="Control" Command="{Binding RemoveLineCommand}" CommandParameter="{Binding SelectedLine}"/>
        </UIElement.InputBindings>
        <DataGrid.ColumnHeaderStyle>
          <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{DynamicResource App.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
          </Style>
        </DataGrid.ColumnHeaderStyle>
        <DataGrid.RowStyle>
          <Style TargetType="{x:Type DataGridRow}">
            <Setter Property="Background" Value="{DynamicResource Surface.Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Style.Triggers>
              <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                <Setter Property="Background" Value="{DynamicResource Grid.Alternate}"/>
              </Trigger>
              <Trigger Property="DataGridRow.IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grid.Selection}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.RowStyle>
        <DataGrid.RowHeaderStyle>
          <Style TargetType="{x:Type DataGridRowHeader}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Background" Value="{DynamicResource App.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Strong}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
          </Style>
        </DataGrid.RowHeaderStyle>
        <FrameworkElement.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Command="{x:Static ux:GridEntry.CopyPreviousCell}" InputGestureText="F4" Header="{Binding Localization[D_CopyCellAbove]}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
            <MenuItem Header="{Binding Localization[CUR_UseListPrice]}" Command="{Binding UseListPriceCommand}"/>
            <MenuItem InputGestureText="Insert" Header="{Binding Localization[D_AddLine]}" Command="{Binding AddLineCommand}"/>
            <MenuItem Header="إضافة 10 أسطر جديدة" Command="{Binding AutoGrowCommand}"/>
            <MenuItem InputGestureText="Ctrl+Delete" Header="{Binding Localization[D_RemoveLine]}" Command="{Binding RemoveLineCommand}" CommandParameter="{Binding SelectedLine}"/>
            <Separator/>
            <MenuItem Header="{Binding Localization[D_OpenItem]}" Command="{Binding OpenItemCommand}"/>
          </ContextMenu>
        </FrameworkElement.ContextMenu>
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="المادة" Width="*">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ux:LookupPicker Placeholder="🔍 اختر المادة..." IsArabic="True" ItemsSource="{Binding DataContext.ItemLookups, Converter={StaticResource EntryLookups}, RelativeSource={RelativeSource AncestorType=UserControl}}" AsyncSearchProvider="{Binding DataContext.SearchItemsAsync, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedId="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTemplateColumn Header="الوحدة" Width="82" ux:GridEntry.SkipOnEnter="True">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <ux:LookupPicker Placeholder="الوحدة" IsArabic="True" ItemsSource="{Binding UnitOptions}" SelectedId="{Binding UnitId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="الكمية" Width="95" ux:GridEntry.CopyPath="Quantity" Binding="{Binding Quantity, Converter={StaticResource Number}, ConverterParameter=quantity, UpdateSourceTrigger=PropertyChanged}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="الإفرادي" Width="110" ux:GridEntry.CopyPath="UnitPrice" Binding="{Binding UnitPrice, Converter={StaticResource Number}, UpdateSourceTrigger=PropertyChanged}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="البيان" Width="140" ux:GridEntry.CopyPath="Notes" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="الإجمالي" Width="120" IsReadOnly="True" Binding="{Binding LineTotal, Converter={StaticResource Number}}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="FontWeight" Value="Bold"/>
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
          <DataGridTextColumn Header="القيمة المضافة" Width="120" ux:GridEntry.CopyPath="TaxAmount" Binding="{Binding TaxAmount, Converter={StaticResource Number}, UpdateSourceTrigger=PropertyChanged}">
            <DataGridBoundColumn.ElementStyle>
              <Style TargetType="{x:Type TextBlock}">
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="6,0"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Style>
            </DataGridBoundColumn.ElementStyle>
          </DataGridTextColumn>
        </DataGrid.Columns>
      </ux:PetraAccountingDataGrid>
    </Border>
  </DockPanel>

  <!-- Al-Ameen 10 Invoice Information Flyout Drawer -->
  <Border Visibility="{Binding IsInvoiceInfoOpen, Converter={StaticResource Visible}}"
          HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="360"
          Background="{DynamicResource Surface.Raised}" BorderBrush="{DynamicResource Border.Strong}" BorderThickness="0,0,1,0"
          Effect="{StaticResource Elevation.2}">
    <DockPanel Margin="12">
      <!-- Drawer Header with Pop-Out and Close -->
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Icon}" Content="&#xE8A7;" FontSize="12" Margin="0,0,4,0"
                  Command="{Binding PopOutInvoiceInfoCommand}" ToolTip="فتح في نافذة مستقلة (Pop-out Window)"/>
          <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="11"
                  Command="{Binding ToggleInvoiceInfoCommand}" ToolTip="إغلاق لوحة المعلومات (Esc / F8)"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource Primary}" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <TextBlock Text="معلومات الفاتورة (الأمين 10)" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
      <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,10"/>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <!-- Section 1: Accounting & Audit -->
          <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="التدقيق المحاسبي والحالة" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,0,0,6"/>
              <DockPanel Margin="0,2">
                <TextBlock Text="حالة الفاتورة:" Style="{StaticResource Text.Caption}" Width="85"/>
                <ux:StatusBadge Text="{Binding InvoiceAuditStatusDisplay}" Kind="{Binding DocumentStatusKind}"/>
              </DockPanel>
              <DockPanel Margin="0,6,0,2">
                <TextBlock Text="رقم السند:" Style="{StaticResource Text.Caption}" Width="85" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Subtle}" Content="عرض القيد" Command="{Binding OpenJournalCommand}"
                        Visibility="{Binding HasGeneratedJournal, Converter={StaticResource Visible}}" Padding="6,2" FontSize="{StaticResource Font.Caption}"/>
                <TextBlock Text="{Binding InvoiceJournalNumberDisplay}" FontWeight="SemiBold" FlowDirection="LeftToRight" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Section 2: Profitability & COGS Analysis (مبيعات) -->
          <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,8" Visibility="{Binding HasCostData, Converter={StaticResource Visible}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="تحليل الربحية وتكلفة المبيعات" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
                <TextBlock DockPanel.Dock="Right" Text="تقديري (COGS)" Foreground="{DynamicResource Text.Tertiary}" FontSize="10"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="التكلفة التقديرية:" Style="{StaticResource Text.Caption}" Width="100"/>
                <TextBlock Text="{Binding EstimatedTotalCostDisplay}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="مجمل الربح التقديري:" Style="{StaticResource Text.Caption}" Width="100"/>
                <TextBlock Text="{Binding EstimatedProfitDisplay}" FontWeight="Bold" FontSize="13"
                           Foreground="{DynamicResource Success}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="نسبة هامش الربح:" Style="{StaticResource Text.Caption}" Width="100"/>
                <TextBlock Text="{Binding EstimatedProfitMarginDisplay}" FontWeight="Bold" Foreground="{DynamicResource Primary}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Padding="6,3" Margin="0,4,0,0"
                      Visibility="{Binding HasBelowCostWarning, Converter={StaticResource Visible}}">
                <DockPanel LastChildFill="True">
                  <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#DC2626" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0"/>
                  <TextBlock Text="تحذير: الفاتورة تحوي مواد بأقل من التكلفة!" Foreground="#991B1B" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Section 3: Customer & Credit -->
          <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,8" Visibility="{Binding HasSelectedCustomer, Converter={StaticResource Visible}}">
            <StackPanel>
              <DockPanel Margin="0,0,0,6">
                <TextBlock Text="بيانات العميل والائتمان" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" FontSize="11"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource Button.Subtle}" Content="كشف حساب" Command="{Binding OpenCustomerStatementCommand}" Padding="4,1" Margin="0,0,4,0" FontSize="10"/>
                  <Button Style="{StaticResource Button.Subtle}" Content="البطاقة" Command="{Binding OpenCustomerCommand}" Padding="4,1" FontSize="10"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="اسم العميل:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding SelectedCustomer.NameArabic}" FontWeight="SemiBold"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="الرصيد قبل الفاتورة:" Style="{StaticResource Text.Caption}" Width="105"/>
                <TextBlock Text="{Binding CustomerBalanceBeforeDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="الرصيد بعد الفاتورة:" Style="{StaticResource Text.Caption}" Width="105"/>
                <TextBlock Text="{Binding CustomerBalanceAfterDisplay}" FontWeight="Bold" Foreground="{DynamicResource Primary}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2" Visibility="{Binding HasCustomerCreditLimit, Converter={StaticResource Visible}}">
                <TextBlock Text="سقف الائتمان:" Style="{StaticResource Text.Caption}" Width="105"/>
                <TextBlock Text="{Binding CustomerCreditLimitDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2" Visibility="{Binding HasCustomerCreditLimit, Converter={StaticResource Visible}}">
                <TextBlock Text="نسبة استهلاك السقف:" Style="{StaticResource Text.Caption}" Width="105"/>
                <TextBlock Text="{Binding CustomerCreditUtilizationDisplay}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
              </DockPanel>
              <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}" Padding="6,3" Margin="0,4,0,0"
                      Visibility="{Binding IsCreditExceeded, Converter={StaticResource Visible}}">
                <TextBlock Text="⚠️ تجاوز سقف الائتمان المسموح!" Foreground="#991B1B" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
              <Border Background="{DynamicResource Error}" Padding="4,2" CornerRadius="2" Margin="0,4,0,0" Visibility="{Binding IsCustomerCreditBlocked, Converter={StaticResource Visible}}">
                <TextBlock Text="حساب موقوف ائتمانياً" FontSize="{StaticResource Font.Caption}" Foreground="{DynamicResource Text.OnAccent}" FontWeight="Bold" HorizontalAlignment="Center"/>
              </Border>
            </StackPanel>
          </Border>

          <!-- Section 4: Operational Attribution -->
          <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="التنسيب والترحيل التشغيلي" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,0,0,6"/>
              <DockPanel Margin="0,2">
                <TextBlock Text="نمط الفاتورة:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding DraftPatternNameDisplay}" FontWeight="SemiBold"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="المستودع:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding DraftWarehouseNameDisplay}"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="مركز الكلفة:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding DraftCostCenterNameDisplay}"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="الحساب المالي:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding DraftFinancialAccountDisplay}" Foreground="{DynamicResource Text.Secondary}"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="طريقة الدفع:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding PaymentMethodDisplay}"/>
              </DockPanel>
              <DockPanel Margin="0,2" Visibility="{Binding ShowDueDate, Converter={StaticResource Visible}}">
                <TextBlock Text="تاريخ الاستحقاق:" Style="{StaticResource Text.Caption}" Width="85"/>
                <TextBlock Text="{Binding DueDateDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource Warning}" FlowDirection="LeftToRight"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Section 5: Totals & Items Count -->
          <Border Style="{StaticResource Panel.Card}" Padding="10" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="ملخص الأقلام والمبالغ" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" FontSize="11" Margin="0,0,0,6"/>
              <DockPanel Margin="0,2">
                <TextBlock Text="عدد الأسطر (الأقلام):" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding FilledLinesCount}" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="إجمالي الكميات:" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding TotalQuantityDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="المجموع الجزئي:" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding SubTotalDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="مجموع الحسم:" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding DiscountTotalDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2">
                <TextBlock Text="مجموع الضريبة/الإضافات:" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding TaxTotalDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <Border Height="1" Background="{DynamicResource Divider}" Margin="0,4"/>
              <DockPanel Margin="0,2">
                <TextBlock Text="الصافي الإجمالي:" FontWeight="Bold" Width="110"/>
                <TextBlock Text="{Binding GrandTotalDisplay}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Success}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2" Visibility="{Binding HasSettlement, Converter={StaticResource Visible}}">
                <TextBlock Text="المسدد:" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding SettledDisplay}" FlowDirection="LeftToRight"/>
              </DockPanel>
              <DockPanel Margin="0,2" Visibility="{Binding HasSettlement, Converter={StaticResource Visible}}">
                <TextBlock Text="المتبقي:" Style="{StaticResource Text.Caption}" Width="110"/>
                <TextBlock Text="{Binding OutstandingDisplay}" FontWeight="SemiBold" Foreground="{DynamicResource Error}" FlowDirection="LeftToRight"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
 </Grid>
</UserControl>
<UserControl x:Class="PetraERP.Desktop.Sales.SalesDocumentLinksView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <DockPanel MinHeight="140" MaxHeight="260" Margin="8" Visibility="{Binding IsAvailable, Converter={StaticResource Visible}}">
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
   <TextBlock Text="{Binding Localization[D_LinkedDocuments]}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
   <Button Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}"/>
   <Button Content="{Binding Localization[D_OpenLinkedDocument]}" Command="{Binding OpenCommand}" Margin="8,0"/>
   <Button Content="{Binding Localization[D_Previous]}" Command="{Binding PreviousCommand}"/>
   <TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center" Margin="8,0"/>
   <Button Content="{Binding Localization[D_Next]}" Command="{Binding NextCommand}"/>
  </WrapPanel>
  <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Binding="{Binding Number}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_LinkNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding DateUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="150"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DateTime], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Description}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Description], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Amount}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Amount], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding CurrencyCode}" Width="70"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Currency], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
    <DataGridTextColumn Binding="{Binding Quantity}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_LinkQuantity], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</UserControl>

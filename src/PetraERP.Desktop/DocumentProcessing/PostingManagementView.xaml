<UserControl x:Class="PetraERP.Desktop.DocumentProcessing.PostingManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <UserControl.InputBindings>
  <KeyBinding Key="F5" Command="{Binding PreviewCommand}"/>
 </UserControl.InputBindings>
 <DockPanel>
  <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[D_PostingManagement]}">
   <ux:PageHeader.Commands>
    <WrapPanel>
     <Button Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE721;" Content="{Binding Localization[D_BulkPreview]}" Command="{Binding PreviewCommand}" ToolTip="F5"/>
     <Button Content="{Binding Localization[D_PostAll]}" Command="{Binding PostAllCommand}" Margin="8,0,0,0" ToolTip="{Binding Localization[D_PostAllHint]}"/>
     <Button Content="{Binding Localization[D_PostSelected]}" Command="{Binding PostSelectedCommand}" Margin="8,0,0,0"/>
     <Button Content="{Binding Localization[D_BulkResume]}" Command="{Binding ResumeCommand}" Margin="8,0,0,0"/>
     <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[D_BulkRefreshResults]}" Command="{Binding RefreshResultsCommand}" Margin="8,0,0,0"/>
    </WrapPanel>
   </ux:PageHeader.Commands>
  </ux:PageHeader>

  <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_PostingManagementHelp]}" Style="{StaticResource Text.Caption}" Margin="4,0,4,8" TextWrapping="Wrap"/>

  <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Card}" Margin="0,0,0,8" Padding="10">
   <StackPanel>
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding Localization[D_BulkDocumentTypes]}" Style="{StaticResource Text.Label}" Margin="0,0,10,0" VerticalAlignment="Center"/>
     <CheckBox Content="فاتورة مبيعات" IsChecked="{Binding IncludeSales}" Margin="0,0,10,0"/>
     <CheckBox Content="فاتورة شراء" IsChecked="{Binding IncludePurchases}" Margin="0,0,10,0"/>
     <CheckBox Content="سند" IsChecked="{Binding IncludeVouchers}" Margin="0,0,10,0"/>
     <CheckBox Content="قيد" IsChecked="{Binding IncludeJournals}" Margin="0,0,10,0"/>
     <CheckBox Content="مستند مخزون" IsChecked="{Binding IncludeInventory}" Margin="0,0,16,0"/>
     <ux:PetraDatePicker Width="130" SelectedDate="{Binding FromDate}" Margin="0,0,8,0" ToolTip="{Binding Localization[D_FromDate]}" AutomationProperties.Name="{Binding Localization[D_FromDate]}"/>
     <ux:PetraDatePicker Width="130" SelectedDate="{Binding ToDate}" Margin="0,0,12,0" ToolTip="{Binding Localization[D_ToDate]}" AutomationProperties.Name="{Binding Localization[D_ToDate]}"/>
     <ux:PetraSearchBox Placeholder="{Binding Localization[D_Search]}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="220"/>
    </WrapPanel>
    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding Localization[D_BulkReason]}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" Width="420" VerticalAlignment="Center"/>
     <CheckBox Content="{Binding Localization[D_BulkRetryFailed]}" IsChecked="{Binding RetryFailed}" Margin="16,0,0,0" VerticalAlignment="Center"/>
    </WrapPanel>
    <Border Margin="0,10,0,0" Padding="8,6" Background="{DynamicResource SubtleWarningBackground}" CornerRadius="{DynamicResource Radius.Small}">
     <CheckBox IsChecked="{Binding IsConfirmed}" FontWeight="SemiBold">
      <TextBlock Text="{Binding Localization[D_BulkConfirm]}" TextWrapping="Wrap"/>
     </CheckBox>
    </Border>
    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
     <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" MaxWidth="900" VerticalAlignment="Center"/>
     <TextBlock Text="{Binding Localization[D_BulkUncertainWarning]}" Foreground="{DynamicResource Warning}" Margin="12,0,8,0"
                Visibility="{Binding IsUncertain, Converter={StaticResource Show}}" VerticalAlignment="Center"/>
     <Button Content="{Binding Localization[D_BulkDiscardPending]}" Command="{Binding DiscardPendingCommand}"
             Visibility="{Binding IsUncertain, Converter={StaticResource Show}}"/>
    </WrapPanel>
   </StackPanel>
  </Border>

  <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Summary}" Margin="0,0,0,8"
          Visibility="{Binding HasBatch, Converter={StaticResource Show}}">
   <StackPanel Margin="10,6">
    <WrapPanel>
     <TextBlock Text="{Binding Localization[D_BulkBatchStatus]}" Style="{StaticResource Text.Label}" Margin="0,0,6,0"/>
     <TextBlock Text="{Binding LastBatchStatus}" FontWeight="SemiBold" Margin="0,0,16,0"/>
     <TextBlock Text="{Binding TotalsText}" FontWeight="SemiBold"/>
    </WrapPanel>
    <TextBlock Text="{Binding BatchMessage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
   </StackPanel>
  </Border>

  <TabControl>
   <TabItem Header="{Binding Localization[D_BulkPreview]}">
    <DockPanel Margin="0,8,0,0">
     <DockPanel DockPanel.Dock="Top" Margin="2,0,2,6">
      <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding PreviewSummaryText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
     </DockPanel>
     <Border Style="{StaticResource Panel.Flat}">
      <DataGrid ItemsSource="{Binding PreviewItems}" IsReadOnly="True" SelectionUnit="FullRow" CanUserSortColumns="True" BorderThickness="0"
                AutomationProperties.Name="{Binding Localization[D_BulkPreview]}">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="36">
         <DataGridTemplateColumn.CellTemplate>
          <DataTemplate>
           <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Postable}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </DataTemplate>
         </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="110" SortMemberPath="DocumentType"/>
        <DataGridTextColumn Header="الرقم" Binding="{Binding NumberDisplay}" Width="120" SortMemberPath="DocumentNumber"/>
        <DataGridTextColumn Header="التاريخ" Binding="{Binding DateDisplay}" Width="95" SortMemberPath="DocumentDateUtc"/>
        <DataGridTextColumn Header="الجهة / الحساب" Binding="{Binding PartyDisplay}" Width="180" SortMemberPath="PartyName"/>
        <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountDisplay}" Width="130" SortMemberPath="Amount" ElementStyle="{StaticResource Text.Numeric}"/>
        <DataGridTextColumn Header="الحالة الحالية" Binding="{Binding CurrentStatus}" Width="100" SortMemberPath="CurrentStatus"/>
        <DataGridTextColumn Header="التصنيف" Binding="{Binding ClassificationDisplay}" Width="160" SortMemberPath="Classification"/>
        <DataGridTextColumn Header="السبب / التفسير" Binding="{Binding Reason}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
    </DockPanel>
   </TabItem>

   <TabItem Header="{Binding Localization[D_BulkResults]}">
    <DockPanel Margin="0,8,0,0">
     <WrapPanel DockPanel.Dock="Top" Margin="2,0,2,6">
      <Button Content="{Binding Localization[D_BulkExportExcel]}" Click="ExportClicked" IsEnabled="{Binding HasResults}" ux:Icon.Glyph="&#xE896;"/>
      <Button Content="{Binding Localization[D_BulkPrint]}" Click="PrintClicked" IsEnabled="{Binding HasResults}" ux:Icon.Glyph="&#xE749;" Margin="8,0,0,0"/>
      <TextBlock Text="{Binding ResultsTotal, StringFormat='عدد النتائج: {0}'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="16,0,0,0"/>
     </WrapPanel>
     <Border Style="{StaticResource Panel.Flat}">
      <DataGrid ItemsSource="{Binding Results}" IsReadOnly="True" SelectionUnit="FullRow" CanUserSortColumns="True" BorderThickness="0"
                AutomationProperties.Name="{Binding Localization[D_BulkResults]}">
       <DataGrid.Columns>
        <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="110" SortMemberPath="DocumentType"/>
        <DataGridTextColumn Header="الرقم" Binding="{Binding NumberDisplay}" Width="120" SortMemberPath="DocumentNumber"/>
        <DataGridTextColumn Header="التاريخ" Binding="{Binding DateDisplay}" Width="95" SortMemberPath="DocumentDateUtc"/>
        <DataGridTextColumn Header="الجهة / الحساب" Binding="{Binding PartyDisplay}" Width="170" SortMemberPath="PartyName"/>
        <DataGridTextColumn Header="المبلغ والعملة" Binding="{Binding AmountDisplay}" Width="130" SortMemberPath="Amount" ElementStyle="{StaticResource Text.Numeric}"/>
        <DataGridTextColumn Header="الحالة السابقة" Binding="{Binding PreviousStatus}" Width="95" SortMemberPath="PreviousStatus"/>
        <DataGridTextColumn Header="الحالة الجديدة" Binding="{Binding NewStatus}" Width="95" SortMemberPath="NewStatus"/>
        <DataGridTextColumn Header="القيد" Binding="{Binding JournalDisplay}" Width="95" SortMemberPath="JournalEntryId"/>
        <DataGridTextColumn Header="رقم الترحيل" Binding="{Binding PostingNumberDisplay}" Width="110" SortMemberPath="PostingNumber"/>
        <DataGridTextColumn Header="النتيجة" Binding="{Binding StatusDisplay}" Width="95" SortMemberPath="Status"/>
        <DataGridTextColumn Header="التصنيف" Binding="{Binding ClassificationDisplay}" Width="140" SortMemberPath="Classification"/>
        <DataGridTextColumn Header="السبب" Binding="{Binding Reason}" Width="*"/>
        <DataGridTextColumn Header="الرمز" Binding="{Binding FailureCode}" Width="90" SortMemberPath="FailureCode"/>
        <DataGridTextColumn Header="المحاولات" Binding="{Binding AttemptCount}" Width="70" SortMemberPath="AttemptCount" ElementStyle="{StaticResource Text.Numeric}"/>
       </DataGrid.Columns>
      </DataGrid>
     </Border>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</UserControl>

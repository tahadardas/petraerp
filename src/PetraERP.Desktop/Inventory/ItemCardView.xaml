<UserControl x:Class="PetraERP.Desktop.Inventory.ItemCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:links="clr-namespace:PetraERP.Desktop.Sales"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             ux:ValidationFocus.Target="{Binding ValidationFocusTarget}" ux:ValidationFocus.Request="{Binding ValidationFocusRequest}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <!-- Esc leaves the edit (asks before discarding changes); a lookup popup or grid that uses Esc handles it first. -->
        <KeyBinding Key="Escape" Command="{Binding CancelCardCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding BeginEditCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCardCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding BeginNewCommand}"/>
        <KeyBinding Key="Home" Modifiers="Control" Command="{Binding FirstItemCommand}"/>
        <KeyBinding Key="PageUp" Modifiers="Control" Command="{Binding PreviousItemCommand}"/>
        <KeyBinding Key="PageDown" Modifiers="Control" Command="{Binding NextItemCommand}"/>
        <KeyBinding Key="End" Modifiers="Control" Command="{Binding LastItemCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <!-- Al-Ameen item card: compact label / field rows. -->
        <Style x:Key="Am.Label" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,3"/></Style>
        <Style x:Key="Am.Check" TargetType="CheckBox"><Setter Property="Margin" Value="4,3"/></Style>
        <Style x:Key="Am.Radio" TargetType="RadioButton"><Setter Property="Margin" Value="8,2,4,2"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    </UserControl.Resources>
    <DockPanel Margin="6">
        <!-- Bottom button bar (Al-Ameen order, right to left): add, new, edit, accounts, close / cancel -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="إضافة" Command="{Binding SaveCardCommand}" Visibility="{Binding IsNewMode, Converter={StaticResource Visible}}" Style="{StaticResource Button.Primary}" MinWidth="76" Margin="0,0,6,0" ToolTip="Ctrl+S"/>
                <Button Content="جديد" Command="{Binding BeginNewCommand}" MinWidth="76" Margin="0,0,6,0"/>
                <Button MinWidth="76" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="تعديل"/>
                            <Setter Property="Command" Value="{Binding BeginEditCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Content" Value="حفظ"/>
                                    <Setter Property="Command" Value="{Binding SaveCardCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="حذف" Command="{Binding DeleteItemCommand}" MinWidth="76" Margin="0,0,6,0" ToolTip="لا يمكن حذف مادة عليها حركة"/>
                <Button Content="حسابات..." Click="AccountsClicked" MinWidth="76" Margin="0,0,6,0"/>
                <Button Content="إلغاء الأمر" Command="{Binding CancelCardCommand}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" MinWidth="76" Margin="0,0,6,0" ToolTip="Esc"/>
                <Button Content="إغلاق" Click="CloseClicked" Visibility="{Binding IsViewMode, Converter={StaticResource Visible}}" MinWidth="76" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
        </Border>

        <!-- Validation summary -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleErrorBackground}" BorderBrush="{DynamicResource ErrorSurface}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="8,4" Margin="0,6,0,0"
                Visibility="{Binding HasValidationErrors, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorSurface}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorSurface}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Record navigation: saved records only (disabled while a draft is open) -->
        <ux:RecordNavigator DockPanel.Dock="Top" Margin="0,0,0,6" RecordNumber="{Binding RecordCode}" StatusText="{Binding StatusText}"
                            FirstCommand="{Binding FirstItemCommand}" PreviousCommand="{Binding PreviousItemCommand}"
                            NextCommand="{Binding NextItemCommand}" LastCommand="{Binding LastItemCommand}"/>

        <!-- Header: code, names -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="150"/><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="رمز المادة *" Style="{StaticResource Am.Label}"/>
            <TextBox ux:ValidationFocus.Key="code" Grid.Column="1" Text="{Binding DraftCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCodeReadOnly}" FlowDirection="LeftToRight" Margin="0,2"/>
            <TextBlock Grid.Column="2" Text="اسم المادة *" Style="{StaticResource Am.Label}"/>
            <TextBox ux:ValidationFocus.Key="name-ar" Grid.Column="3" Text="{Binding DraftNameArabic, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="الاسم اللاتيني" Style="{StaticResource Am.Label}"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding DraftNameEnglish, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
        </Grid>

        <!-- Body: page list on the reading side (right), page content beside it -->
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="NavList" SelectedIndex="0" MinWidth="124" AutomationProperties.Name="{Binding Title}">
          <ListBoxItem Content="عام"/>
          <ListBoxItem Content="وحدات"/>
          <ListBoxItem Content="أسعار"/>
          <ListBoxItem Content="خيارات"/>
          <ListBoxItem Content="المكافآت" IsEnabled="False" Visibility="Collapsed"/>
          <ListBoxItem Content="أهداف الفترات" IsEnabled="False" Visibility="Collapsed"/>
          <ListBoxItem Content="كميات المستودعات"/>
          <ListBoxItem Content="ملخص الحركة"/>
          <ListBoxItem Content="مادة تجميعية"/>
          <ListBoxItem Content="حقول مخصصة" IsEnabled="False" Visibility="Collapsed"/>
          <ListBoxItem Content="الحسابات المحاسبية"/>
          <ListBoxItem Content="الباركودات"/>
          <ListBoxItem Content="أسعار خاصة"/>
          <ListBoxItem Content="تحويلات الوحدات"/>
          <ListBoxItem Content="الفواتير المرتبطة"/>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
                <Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="المجموعة" Style="{StaticResource Am.Label}" VerticalAlignment="Top" Margin="6,8,6,3"/>
            <ux:LookupPicker Grid.Column="1" ItemsSource="{Binding GroupLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftGroupId}" IsEnabled="{Binding IsEditing}" IsArabic="{Binding Localization.IsRightToLeft}" Margin="0,4,0,2" VerticalAlignment="Top"/>
            <TextBlock Grid.Row="1" Text="المواصفات" Style="{StaticResource Am.Label}" VerticalAlignment="Top" Margin="6,8,6,3"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftSpecifications, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Margin="0,2,0,2" MinHeight="150" MaxLength="2000"/>
            <Grid Grid.RowSpan="2" Grid.Column="3" Grid.ColumnSpan="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="القياس" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Column="1" Text="{Binding DraftMeasure, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="1" Text="المصدر" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftSource, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="2" Text="مكان التواجد" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftLocation, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="3" Text="الشركة المصنعة" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DraftManufacturer, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="4" Text="اللون" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DraftColor, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="5" Text="بلد المنشأ" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DraftOriginCountry, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="6" Text="النوعية" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DraftQuality, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
              <TextBlock Grid.Row="7" Text="الطراز" Style="{StaticResource Am.Label}"/>
              <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DraftModel, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" MaxLength="100" Margin="0,2"/>
            </Grid>
          </Grid>
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
              <StackPanel>
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,2,0,4" Margin="0,0,0,4">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="الوحدة 1" Style="{StaticResource Am.Label}"/>
                <ux:LookupPicker ux:ValidationFocus.Key="base-unit" Grid.Column="1" ItemsSource="{Binding UnitLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftBaseUnitId}" IsEnabled="{Binding IsEditing}" IsArabic="{Binding Localization.IsRightToLeft}" Margin="0,2"/>
                <RadioButton Grid.Column="2" GroupName="DefaultUnit" Content="افتراضية" IsChecked="{Binding IsUnit1Default}" IsEnabled="{Binding IsEditing}" Style="{StaticResource Am.Radio}"/>
                <TextBlock Grid.Row="2" Text="رمز الباركود" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftUnit1Barcode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsEditing}" FlowDirection="LeftToRight" Margin="0,2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="..." MinWidth="26" Margin="4,2,0,2" Click="MoreBarcodesClicked" ToolTip="كل الباركودات"/>
              </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,2,0,4" Margin="0,0,0,4">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="الوحدة 2" Style="{StaticResource Am.Label}"/>
                <ux:LookupPicker Grid.Column="1" ItemsSource="{Binding UnitLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftUnit2Id}" IsEnabled="{Binding IsEditing}" IsArabic="{Binding Localization.IsRightToLeft}" Margin="0,2"/>
                <RadioButton Grid.Column="2" GroupName="DefaultUnit" Content="افتراضية" IsChecked="{Binding IsUnit2Default}" IsEnabled="{Binding CanEditUnit2}" Style="{StaticResource Am.Radio}"/>
            <TextBlock Grid.Row="1" Text="عامل التحويل" Style="{StaticResource Am.Label}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftUnit2Factor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUnit2}" FlowDirection="LeftToRight" Margin="0,2"/>
            <CheckBox Grid.Row="1" Grid.Column="2" Content="غير ثابت" IsChecked="{Binding DraftUnit2Variable}" IsEnabled="{Binding CanEditUnit2}" Style="{StaticResource Am.Check}"/>
                <TextBlock Grid.Row="2" Text="رمز الباركود" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftUnit2Barcode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUnit2}" FlowDirection="LeftToRight" Margin="0,2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="..." MinWidth="26" Margin="4,2,0,2" Click="MoreBarcodesClicked" ToolTip="كل الباركودات"/>
              </Grid>
            </Border>
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="0,2,0,4" Margin="0,0,0,4">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="الوحدة 3" Style="{StaticResource Am.Label}"/>
                <ux:LookupPicker Grid.Column="1" ItemsSource="{Binding UnitLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftUnit3Id}" IsEnabled="{Binding IsEditing}" IsArabic="{Binding Localization.IsRightToLeft}" Margin="0,2"/>
                <RadioButton Grid.Column="2" GroupName="DefaultUnit" Content="افتراضية" IsChecked="{Binding IsUnit3Default}" IsEnabled="{Binding CanEditUnit3}" Style="{StaticResource Am.Radio}"/>
            <TextBlock Grid.Row="1" Text="عامل التحويل" Style="{StaticResource Am.Label}"/>
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftUnit3Factor, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUnit3}" FlowDirection="LeftToRight" Margin="0,2"/>
            <CheckBox Grid.Row="1" Grid.Column="2" Content="غير ثابت" IsChecked="{Binding DraftUnit3Variable}" IsEnabled="{Binding CanEditUnit3}" Style="{StaticResource Am.Check}"/>
                <TextBlock Grid.Row="2" Text="رمز الباركود" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftUnit3Barcode, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditUnit3}" FlowDirection="LeftToRight" Margin="0,2"/>
                <Button Grid.Row="2" Grid.Column="2" Content="..." MinWidth="26" Margin="4,2,0,2" Click="MoreBarcodesClicked" ToolTip="كل الباركودات"/>
              </Grid>
            </Border>
              </StackPanel>
              <Grid Grid.Column="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="الحد الأعلى" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Column="1" Text="{Binding DraftMaxStock, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="حد الطلب" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftReorderPoint, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
                <TextBlock Grid.Row="2" Text="الحد الأدنى" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftMinStock, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
                <TextBlock Grid.Row="3" Text="الكمية الحالية" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CurrentQuantityDisplay, Mode=OneWay}" IsReadOnly="True" FlowDirection="LeftToRight" Margin="0,2"/>
                <Border Grid.Row="4" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Margin="0,8,0,6"/>
                <TextBlock Grid.Row="5" Text="هدية" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DraftGiftQuantity, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
                <TextBlock Grid.Row="6" Text="لكل" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DraftGiftPerQuantity, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="8">
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="الوحدة الأولى" HorizontalAlignment="Center" Style="{StaticResource Am.Label}"/>
                <TextBlock Grid.Column="2" Text="الوحدة الثانية" HorizontalAlignment="Center" Style="{StaticResource Am.Label}"/>
                <TextBlock Grid.Column="3" Text="الوحدة الثالثة" HorizontalAlignment="Center" Style="{StaticResource Am.Label}"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding PriceMatrix}" KeyboardNavigation.TabNavigation="Local">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,1">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Caption}" Style="{StaticResource Am.Label}"/>
                    <TextBox Grid.Column="1" Text="{Binding Unit1, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="2,1">
                      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditPriceMatrix, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Style.Triggers></Style.Triggers>
                      </Style></TextBox.Style>
                    </TextBox>
                    <TextBox Grid.Column="2" Text="{Binding Unit2, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="2,1">
                      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditPriceMatrix, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.HasUnit2, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                      </Style></TextBox.Style>
                    </TextBox>
                    <TextBox Grid.Column="3" Text="{Binding Unit3, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Margin="2,1">
                      <TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="IsEnabled" Value="{Binding DataContext.CanEditPriceMatrix, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.HasUnit3, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                      </Style></TextBox.Style>
                    </TextBox>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="90"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="العملة" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Column="1" Text="{Binding DraftPriceCurrency, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditPriceMatrix}" CharacterCasing="Upper" MaxLength="3" FlowDirection="LeftToRight" Margin="0,2"/>
                <TextBlock Grid.Column="3" Text="سياسة التسعير" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Column="4" Text="حقيقي" IsReadOnly="True" Margin="0,2"/>
                <TextBlock Grid.Row="1" Text="تعادل آخر شراء" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftLastPurchaseRate, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid Grid.ColumnSpan="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <TextBlock Text="نوع المادة" Style="{StaticResource Am.Label}"/>
                <TextBox Grid.Column="1" Text="مستودعية" IsReadOnly="True" Margin="0,2"/>
              </Grid>
              <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Divider}" BorderThickness="1" Padding="6,2,6,6" Margin="0,0,0,6">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <CheckBox Content="مادة تجميعية" IsChecked="{Binding DraftIsAssembly}" IsEnabled="{Binding IsEditing}" Style="{StaticResource Am.Check}"/>
                    <CheckBox Content="حساب الأسعار من المكونات" IsChecked="{Binding DraftComponentPricing}" IsEnabled="{Binding CanEditComponentPricing}" Style="{StaticResource Am.Check}"/>
                    <CheckBox Content="رقم تسلسلي" IsChecked="{Binding DraftTracksSerial}" IsEnabled="{Binding IsEditing}" Style="{StaticResource Am.Check}"/>
                    <CheckBox Content="فرض عند الإدخال" IsChecked="{Binding DraftEnforceSerialOnReceipt}" IsEnabled="{Binding CanEditSerialEnforcement}" Margin="18,3,4,3"/>
                    <CheckBox Content="فرض عند الإخراج" IsChecked="{Binding DraftEnforceSerialOnIssue}" IsEnabled="{Binding CanEditSerialEnforcement}" Margin="18,3,4,3"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <CheckBox Content="تاريخ إنتاج" IsChecked="{Binding DraftTracksProductionDate}" IsEnabled="{Binding IsEditing}" Style="{StaticResource Am.Check}"/>
                    <CheckBox Content="تاريخ صلاحية" IsChecked="{Binding DraftTracksExpiryDate}" IsEnabled="{Binding IsEditing}" Style="{StaticResource Am.Check}"/>
                    <CheckBox Content="فرض عند الإدخال" IsChecked="{Binding DraftEnforceDatesOnReceipt}" IsEnabled="{Binding CanEditDateEnforcement}" Margin="18,3,4,3"/>
                    <CheckBox Content="فرض عند الإخراج" IsChecked="{Binding DraftEnforceDatesOnIssue}" IsEnabled="{Binding CanEditDateEnforcement}" Margin="18,3,4,3"/>
                  </StackPanel>
                </Grid>
              </Border>
              <CheckBox Grid.Row="2" Grid.ColumnSpan="2" Content="إخفاء في نافذة البحث" IsChecked="{Binding DraftHideInSearch}" IsEnabled="{Binding IsEditing}" Style="{StaticResource Am.Check}"/>

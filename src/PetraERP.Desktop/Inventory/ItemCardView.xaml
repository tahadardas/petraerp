                                <ux:LookupPicker ItemsSource="{Binding PricePatternLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding NewPricePatternId}" Width="160" Margin="0,0,8,0" Placeholder="{Binding Localization[CUR_AnyPattern]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                                <ux:PetraDatePicker SelectedDate="{Binding NewPriceValidFrom}" Width="130" Margin="0,0,8,0" ToolTip="{Binding Localization[CUR_ValidFrom]}" AutomationProperties.Name="{Binding Localization[CUR_ValidFrom]}"/>
                                <ux:PetraDatePicker SelectedDate="{Binding NewPriceValidTo}" Width="130" Margin="0,0,8,0" ToolTip="{Binding Localization[CUR_ValidTo]}" AutomationProperties.Name="{Binding Localization[CUR_ValidTo]}"/>
                                <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[D_AddPrice]}" Command="{Binding AddPriceCommand}"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding Localization[CUR_PriceHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid ux:GridRowNumbers.Enabled="True" ItemsSource="{Binding Prices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="قائمة السعر" Binding="{Binding PriceListCode}" Width="140"/>
                            <DataGridTextColumn Header="السعر" Binding="{Binding Price, Converter={StaticResource Number}}" Width="130" ElementStyle="{StaticResource Text.Numeric}"/>
                            <DataGridTextColumn Header="العملة" Binding="{Binding CurrencyCode}" Width="80"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitCode}" Width="90"/>
                            <DataGridTextColumn Header="الحد الأدنى للكمية" Binding="{Binding MinQuantity}" Width="120"/>
                            <DataGridTextColumn Header="من تاريخ" Binding="{Binding ValidFrom, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="إلى تاريخ" Binding="{Binding ValidTo, StringFormat=yyyy-MM-dd}" Width="100"/>
                            <DataGridTextColumn Header="الزبون (معرف)" Binding="{Binding PartyId}" Width="110"/>
                            <DataGridTextColumn Header="النمط (معرف)" Binding="{Binding PatternId}" Width="110"/>
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="حذف" Style="{StaticResource Button.Subtle}"
                                                Command="{Binding DataContext.RemovePriceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding DataContext.CanEditPrices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Visible}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="13"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="معاملات تحويل الوحدات المرتبطة بهذه المادة" Style="{StaticResource Text.Subheading}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Conversions}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="من وحدة" Binding="{Binding FromUnitCode}" Width="120"/>
                            <DataGridTextColumn Header="إلى وحدة" Binding="{Binding ToUnitCode}" Width="120"/>
                            <DataGridTextColumn Header="معامل التحويل" Binding="{Binding Factor, Converter={StaticResource Number}, ConverterParameter=rate}" Width="160" ElementStyle="{StaticResource Text.Numeric}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="14"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
                <DockPanel>
                 <WrapPanel DockPanel.Dock="Top"><Button Content="{Binding Localization[D_LinkedSalesInvoices]}" Command="{Binding ViewItemInvoicesCommand}"/><Button Content="{Binding Localization[D_OpenLinkedDocument]}" Command="{Binding OpenMovementSourceCommand}" Margin="8,0"/></WrapPanel>
                 <links:SalesDocumentLinksView DataContext="{Binding DocumentLinks}"/>
                </DockPanel>
            
        </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

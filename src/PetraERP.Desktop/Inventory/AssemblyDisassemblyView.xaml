<UserControl x:Class="PetraERP.Desktop.Inventory.AssemblyDisassemblyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             xmlns:inv="clr-namespace:PetraERP.Desktop.Inventory"
             Background="{DynamicResource Surface.Secondary}">

    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding EditCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PrintCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F6" Command="{Binding ExplodeBOMCommand}"/>
    </UserControl.InputBindings>

    <DockPanel LastChildFill="True">
        <!-- 1. Page Header with Title and Modern Status Badge -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ux:StatusBadge Text="{Binding StatusBadgeText}" Kind="{Binding StatusBadgeKind}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Header Actions & Pattern Shortcuts -->
                <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Manage Patterns Button (إدارة الأنماط) -->
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE713;" Content="{Binding Localization[D_PM_Title]}" Command="{Binding ManagePatternsCommand}" ToolTip="إدارة أنماط التجميع والتفكيك" Margin="0,0,8,0" Visibility="{Binding CanViewPatterns, Converter={StaticResource Visible}}"/>

                    <!-- Action Buttons -->
                    <Button Style="{StaticResource Am.PrimaryActionButton}" Content="{Binding Localization[D_Save]}" Command="{Binding SaveCommand}" ToolTip="Ctrl+S" Margin="0,0,4,0" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}"/>
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="{Binding Localization[D_New]}" Command="{Binding NewCommand}" ToolTip="Ctrl+N" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE70F;" Content="{Binding Localization[D_Edit]}" Command="{Binding EditCommand}" ToolTip="Ctrl+E" Margin="0,0,4,0" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}"/>
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE8FB;" Content="ترحيل" Command="{Binding PostCommand}" Margin="0,0,4,0" Visibility="{Binding IsReadOnly, Converter={StaticResource Visible}}"/>
                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE749;" Content="{Binding Localization[D_Print]}" Command="{Binding PrintCommand}" ToolTip="Ctrl+P" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource Am.CloseActionButton}" Content="{Binding Localization[D_Cancel]}" Command="{Binding CancelCommand}" Margin="0,0,4,0" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}"/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- 2. Pattern Quick Switcher Bar (Al-Ameen Fast Patterns Strip) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="8,4">
            <DockPanel LastChildFill="True">
                <!-- Mode Switcher (تجميع vs تفكيك) -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="4,0,16,0">
                    <TextBlock Text="نوع العملية:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <RadioButton Content="تجميع مواد (Assembly)" IsChecked="{Binding IsAssemblyMode, Mode=OneWay}" Command="{Binding ToggleModeCommand}" IsEnabled="{Binding IsEditing}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4" Margin="0,0,4,0"/>
                    <RadioButton Content="تفكيك مواد (Disassembly)" IsChecked="{Binding IsDisassemblyMode, Mode=OneWay}" Command="{Binding ToggleModeCommand}" IsEnabled="{Binding IsEditing}" Style="{StaticResource {x:Type ToggleButton}}" Padding="12,4"/>
                </StackPanel>

                <!-- Runnable Patterns List -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding AssemblyPatterns}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Command}" Margin="4,0" Padding="8,3" Content="{Binding Name}" Command="{Binding DataContext.NewByPatternCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 3. Bottom Summary & Arabic Tafqeet Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Arabic Tafqeet verbalization -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="التفقيط المالي العربي:" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Text.Secondary}"/>
                    <TextBlock Text="{Binding TafqeetText}" FontWeight="Bold" FontSize="{StaticResource Font.Body}" Foreground="{DynamicResource Accent.Primary}" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Financial Totals Block -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Localization[D_TotalMaterialCost]}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding TotalMaterialCost, StringFormat='{}{0:N2}'}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Localization[D_TotalExpenses]}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding TotalOperatingExpenses, StringFormat='{}{0:N2}'}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Localization[D_GrandCostTotal]}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding GrandCostTotal, StringFormat='{}{0:N2}'}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Accent.Primary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Localization[D_UnitProducedCost]}" Style="{StaticResource Text.Caption}"/>
                            <TextBlock Text="{Binding UnitProducedCost, StringFormat='{}{0:N4}'}" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Main Body: Top Header Form & Tabbed Grids -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12,8">
                <!-- Header Information Card -->
                <Border Style="{StaticResource Panel.Card}" Padding="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 0: Document Number, Date, Assembled Item, Quantity -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="4,2">
                            <TextBlock Text="{Binding Localization[D_Number]}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource Am.TextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,2">
                            <TextBlock Text="{Binding Localization[D_Date]}" Style="{StaticResource Text.Label}"/>
                            <DatePicker SelectedDate="{Binding DocumentDate, Mode=TwoWay}" IsEnabled="{Binding IsEditing}" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="4,2">
                            <TextBlock Text="{Binding Localization[D_AssembledItem]}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding AssembledItemLookups}" SelectedValue="{Binding AssembledItemId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding IsEditing}" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="3" Margin="4,2">
                            <TextBlock Text="{Binding Localization[D_Quantity]}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding AssembledQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource Am.TextBox}" FlowDirection="LeftToRight"/>
                        </StackPanel>

                        <!-- Row 1: Source Warehouse, Target Warehouse, Cost Center, Operating Account -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="4,6,4,2">
                            <TextBlock Text="{Binding Localization[D_SourceWarehouse]}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding WarehouseLookups}" SelectedValue="{Binding SourceWarehouseId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding IsEditing}" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,6,4,2">
                            <TextBlock Text="{Binding Localization[D_TargetWarehouse]}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding WarehouseLookups}" SelectedValue="{Binding TargetWarehouseId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding IsEditing}" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="4,6,4,2">
                            <TextBlock Text="{Binding Localization[D_CostCenter]}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding CostCenterLookups}" SelectedValue="{Binding CostCenterId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding IsEditing}" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="3" Margin="4,6,4,2">
                            <TextBlock Text="{Binding Localization[D_Role_OperatingAccount]}" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding AccountLookups}" SelectedValue="{Binding OperatingAccountId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="NameArabic" IsEnabled="{Binding IsEditing}" Height="28"/>
                        </StackPanel>

                        <!-- Row 2: Notes -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Margin="4,6,4,2">
                            <TextBlock Text="{Binding Localization[D_Notes]}" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsReadOnly}" Style="{StaticResource Am.TextBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabbed Operations: 1. Components (BOM), 2. Operating Expenses -->
                <TabControl Height="360" Background="{DynamicResource Surface.Primary}">
                    <!-- Tab 1: Components Grid (BOM Explosion) -->
                    <TabItem Header="مكونات المادة الأولية (المواد المستهلكة/الناتجة)">
                        <DockPanel Margin="6">
                            <!-- Toolstrip for Components -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="إضافة مكون" Command="{Binding AddComponentLineCommand}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="تفريغ المكونات المعيارية (F6)" Command="{Binding ExplodeBOMCommand}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" ToolTip="إعادة سحب المكونات المعيارية من بطاقة المادة (F6)" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE8D4;" Content="توزيع نسب التكلفة آلياً" Command="{Binding DistributeDisassemblyCostsCommand}" Visibility="{Binding IsDisassemblyMode, Converter={StaticResource Visible}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="اضغط F6 لإعادة سحب المكونات المعيارية، أو عدّل الكميات والتكاليف مباشرة في الجدول." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </WrapPanel>
                            </Border>

                            <!-- Components DataGrid -->
                            <DataGrid ItemsSource="{Binding ComponentLines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="{Binding IsReadOnly}" SelectionUnit="FullRow"
                                      GridLinesVisibility="All" AlternatingRowBackground="{DynamicResource Grid.Alternate}" RowBackground="{DynamicResource Surface.Primary}"
                                      RowHeight="28" ColumnHeaderHeight="30" BorderThickness="1" BorderBrush="{DynamicResource Border.Normal}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTextColumn Header="رمز المادة" Binding="{Binding ItemCode}" Width="110" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="اسم المادة المكونة" Binding="{Binding ItemName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="الكمية المعيارية" Binding="{Binding StandardQuantity, StringFormat='{}{0:F2}'}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTextColumn Header="الكمية الإجمالية" Binding="{Binding TotalQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}" Width="110" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="70" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="التكلفة الإفرادية" Binding="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" Width="110" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTextColumn Header="التكلفة الإجمالية" Binding="{Binding TotalCost, StringFormat='{}{0:N2}'}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridCheckBoxColumn Header="مرنة" Binding="{Binding IsFlexible}" Width="60"/>
                                    <DataGridCheckBoxColumn Header="إجبارية" Binding="{Binding IsMandatory}" Width="65" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="نسبة التكلفة %" Binding="{Binding CostPercentage, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}%'}" Width="95" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Status.Error}"
                                                        Command="{Binding DataContext.RemoveComponentLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="حذف المكون"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <!-- Tab 2: Operating & Conversion Expenses -->
                    <TabItem Header="مصاريف التشغيل والتحويل (Operating Expenses)">
                        <DockPanel Margin="6">
                            <!-- Toolstrip for Expenses -->
                            <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Secondary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,6">
                                <WrapPanel VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="إضافة مصروف تشغيلي" Command="{Binding AddExpenseLineCommand}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" Margin="0,0,6,0"/>
                                    <TextBlock Text="يتم تحميل مصاريف التشغيل (أجور، كهرباء، استهلاك) مباشرة على تكلفة البضاعة المجمعة المنتجة." Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </WrapPanel>
                            </Border>

                            <!-- Expenses DataGrid -->
                            <DataGrid ItemsSource="{Binding ExpenseLines}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      IsReadOnly="{Binding IsReadOnly}" SelectionUnit="FullRow"
                                      GridLinesVisibility="All" AlternatingRowBackground="{DynamicResource Grid.Alternate}" RowBackground="{DynamicResource Surface.Primary}"
                                      RowHeight="28" ColumnHeaderHeight="30" BorderThickness="1" BorderBrush="{DynamicResource Border.Normal}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTextColumn Header="رمز الحساب" Binding="{Binding AccountCode}" Width="120" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="اسم حساب المصروف" Binding="{Binding AccountName}" Width="250" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:N2}'}" Width="130" ElementStyle="{StaticResource Text.Numeric}"/>
                                    <DataGridTextColumn Header="البيان / ملاحظات" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Status.Error}"
                                                        Command="{Binding DataContext.RemoveExpenseLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" IsEnabled="{Binding DataContext.IsEditing, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="حذف المصروف"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

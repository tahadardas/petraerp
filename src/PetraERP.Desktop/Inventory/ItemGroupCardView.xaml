<UserControl x:Class="PetraERP.Desktop.Inventory.ItemGroupCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             ux:ValidationFocus.Target="{Binding ValidationFocusTarget}" ux:ValidationFocus.Request="{Binding ValidationFocusRequest}">
    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCardCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding BeginEditCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCardCommand}"/>
    </UserControl.InputBindings>
    <UserControl.Resources>
        <Style x:Key="Am.Label" TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="6,3"/></Style>
    </UserControl.Resources>
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="إضافة" Command="{Binding SaveCardCommand}" Visibility="{Binding IsNewMode, Converter={StaticResource Visible}}" Style="{StaticResource Button.Primary}" MinWidth="76" Margin="0,0,6,0" ToolTip="Ctrl+S"/>
                <Button Content="جديد" Command="{Binding BeginNewCommand}" MinWidth="76" Margin="0,0,6,0"/>
                <Button MinWidth="76" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="تعديل"/>
                            <Setter Property="Command" Value="{Binding BeginEditCommand}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Content" Value="حفظ"/>
                                    <Setter Property="Command" Value="{Binding SaveCardCommand}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="حذف" Command="{Binding DeleteCommand}" MinWidth="76" Margin="0,0,6,0" ToolTip="لا تُحذف مجموعة فيها مواد أو مجموعات فرعية"/>
                <Button Content="حسابات..." Click="AccountsClicked" MinWidth="76" Margin="0,0,6,0"/>
                <Button Content="إلغاء الأمر" Command="{Binding CancelCardCommand}" Visibility="{Binding IsEditing, Converter={StaticResource Visible}}" MinWidth="76" Margin="0,0,6,0" ToolTip="Esc"/>
                <Button Content="إغلاق" Click="CloseClicked" Visibility="{Binding IsViewMode, Converter={StaticResource Visible}}" MinWidth="76" Margin="0,0,6,0"/>
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SubtleErrorBackground}" BorderBrush="{DynamicResource ErrorSurface}"
                BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="8,4" Margin="0,6,0,0"
                Visibility="{Binding HasValidationErrors, Converter={StaticResource Visible}}">
            <DockPanel>
                <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource ErrorSurface}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="{DynamicResource ErrorSurface}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ux:RecordNavigator DockPanel.Dock="Top" Margin="0,0,0,6" RecordNumber="{Binding RecordCode}" StatusText="{Binding StatusText}"
                            FirstCommand="{Binding FirstGroupCommand}" PreviousCommand="{Binding PreviousGroupCommand}"
                            NextCommand="{Binding NextGroupCommand}" LastCommand="{Binding LastGroupCommand}"/>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="150"/><ColumnDefinition Width="82"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="الرمز *" Style="{StaticResource Am.Label}"/>
            <TextBox ux:ValidationFocus.Key="code" Grid.Column="1" Text="{Binding DraftCode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsCodeReadOnly}" FlowDirection="LeftToRight" Margin="0,2"/>
            <TextBlock Grid.Column="2" Text="الاسم *" Style="{StaticResource Am.Label}"/>
            <TextBox ux:ValidationFocus.Key="name-ar" Grid.Column="3" Text="{Binding DraftNameArabic, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" Margin="0,2"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="الاسم اللاتيني" Style="{StaticResource Am.Label}"/>
            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding DraftNameEnglish, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsViewMode}" FlowDirection="LeftToRight" Margin="0,2"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ListBox x:Name="NavList" SelectedIndex="0" MinWidth="124" AutomationProperties.Name="{Binding Title}">
          <ListBoxItem Content="عام"/>
          <ListBoxItem Content="الحسابات"/>
          <ListBoxItem Content="المجموعات الفرعية"/>
          <ListBoxItem Content="المواد"/>
          <ListBoxItem Content="حقول مخصصة" IsEnabled="False" Visibility="Collapsed"/>
            </ListBox>
            <Border Grid.Column="2" Style="{StaticResource Panel.Card}" Padding="0">
                <Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
          <Grid Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="نوع المجموعة" Style="{StaticResource Am.Label}"/>
            <TextBox Grid.Column="1" Text="عادية" IsReadOnly="True" Width="130" HorizontalAlignment="Left" Margin="0,2"/>
            <TextBlock Grid.Row="1" Text="المجموعة الرئيسية" Style="{StaticResource Am.Label}"/>
            <ux:LookupPicker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ParentGroupLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding DraftParentId}" IsEnabled="{Binding IsEditing}" IsArabic="{Binding Localization.IsRightToLeft}" Margin="0,2"/>
            <TextBlock Grid.Row="2" Text="ملاحظات" Style="{StaticResource Am.Label}" VerticalAlignment="Top" Margin="6,8,6,3"/>
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftDescription, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MinHeight="120" IsReadOnly="{Binding IsViewMode}" Margin="0,2"/>
          </Grid>
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="780" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding Localization[D_GroupAccountingHelp]}" Style="{StaticResource Text.Caption}" Margin="0,0,0,16"/>

                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource Field}" Width="360" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Localization[D_RevenueAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding RevenueAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource Field}" Width="360">
                                <TextBlock Text="{Binding Localization[D_InventoryAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding InventoryAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource Field}" Width="360" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Localization[D_CogsAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding CogsAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource Field}" Width="360">
                                <TextBlock Text="{Binding Localization[D_PurchaseAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding PurchaseAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource Field}" Width="360" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Localization[D_SalesDiscountAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding SalesDiscountAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource Field}" Width="360">
                                <TextBlock Text="{Binding Localization[D_PurchaseDiscountAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding PurchaseDiscountAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,0,0,12">
                            <StackPanel Style="{StaticResource Field}" Width="360" Margin="0,0,16,0">
                                <TextBlock Text="{Binding Localization[D_SalesTaxAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding SalesTaxAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>

                            <StackPanel Style="{StaticResource Field}" Width="360">
                                <TextBlock Text="{Binding Localization[D_PurchaseTaxAccount]}" Style="{StaticResource Text.Label}"/>
                                <ux:LookupPicker ItemsSource="{Binding AccountLookups, Converter={StaticResource EntryLookups}}" SelectedId="{Binding PurchaseTaxAccountId}" IsEnabled="{Binding IsEditing}" Placeholder="{Binding Localization[D_SelectAccount]}" IsArabic="{Binding Localization.IsRightToLeft}"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_DirectSubgroups]}" Style="{StaticResource Text.Subheading}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding Subgroups}" IsReadOnly="True" SelectionUnit="FullRow" AutoGenerateColumns="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_Code], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding Code}" Width="140"/>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_ArabicName], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding NameArabic}" Width="*"/>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_EnglishName], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding NameEnglish}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            
        </Grid>
        <Grid>
          <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=NavList}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
          </Style></Grid.Style>
                <DockPanel Margin="16">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_ItemsInThisGroup]}" Style="{StaticResource Text.Subheading}" Margin="0,0,0,8"/>
                    <DataGrid ItemsSource="{Binding ItemsInGroup}" IsReadOnly="True" SelectionUnit="FullRow" AutoGenerateColumns="False" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_Code], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding Code}" Width="120"/>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_Name], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding NameArabic}" Width="*"/>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_BaseUnit], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding BaseUnitSymbol}" Width="80"/>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_CurrentStock], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding CurrentStock}" Width="110"/>
                            <DataGridTextColumn Header="{Binding DataContext.Localization[D_CostMethod], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding CostMethodDisplay}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            
        </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

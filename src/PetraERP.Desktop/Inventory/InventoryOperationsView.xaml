<UserControl x:Class="PetraERP.Desktop.Inventory.InventoryOperationsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ux="clr-namespace:PetraERP.Desktop.Controls" xmlns:inv="clr-namespace:PetraERP.Desktop.Inventory">
 <UserControl.Resources><inv:InventoryEnumCaptionConverter x:Key="InventoryCaption"/></UserControl.Resources>
 <UserControl.InputBindings><KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}"/><KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}"/><KeyBinding Key="E" Modifiers="Control" Command="{Binding EditCommand}"/><KeyBinding Key="F5" Command="{Binding RefreshCommand}"/><KeyBinding Key="Escape" Command="{Binding CancelCommand}"/></UserControl.InputBindings>
 <DockPanel>
  <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[INV_Title]}">
   <ux:PageHeader.Status><ux:StatusBadge Text="{Binding DocumentStatusText}" Kind="{Binding DocumentStatusKind}" Visibility="{Binding HasDocumentStatus, Converter={StaticResource Visible}}"/></ux:PageHeader.Status>
   <ux:PageHeader.Commands><ux:DocumentCommandBar Screen="{Binding}"/></ux:PageHeader.Commands>
  </ux:PageHeader>
  <WrapPanel DockPanel.Dock="Top" Margin="4"><TextBlock Text="{Binding Localization[INV_FindItem]}" VerticalAlignment="Center"/><TextBox Text="{Binding ItemSearch, UpdateSourceTrigger=PropertyChanged}" Width="220"/><Button Content="{Binding Localization[D_Search]}" Command="{Binding SearchItemsCommand}"/><TextBlock Text="{Binding Localization[INV_FindItemHelp]}" TextWrapping="Wrap" MaxWidth="480"/></WrapPanel>
  <TabControl SelectedIndex="{Binding WorkspaceTab}">
   <TabItem Header="{Binding Localization[INV_Documents]}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Visibility="{Binding ShowDocumentList, Converter={StaticResource Visible}}"><ux:PetraSearchBox Placeholder="{Binding Localization[D_Search]}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
      <Button Style="{StaticResource Am.ActionButton}" Content="{Binding Localization[D_Search]}" Command="{Binding RefreshCommand}"/><Button Style="{StaticResource Am.ActionButton}" Content="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}"/>
      <Button Style="{StaticResource Am.ActionButton}" MinWidth="32" Content="←" Command="{Binding PreviousCommand}"/><TextBlock Text="{Binding PageStatus}" VerticalAlignment="Center"/><Button Style="{StaticResource Am.ActionButton}" MinWidth="32" Content="→" Command="{Binding NextCommand}"/>
     </WrapPanel>
     <ux:PetraAccountingDataGrid Grid.Row="1" Height="160" Visibility="{Binding ShowDocumentList, Converter={StaticResource Visible}}" ux:GridRowContext.Enabled="True" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" ux:GridRowNumbers.Enabled="True">
      <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{Binding Localization[D_Open]}" Command="{Binding OpenCommand}"/></ContextMenu></DataGrid.ContextMenu>
      <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenCommand}"/></DataGrid.InputBindings>
      <DataGrid.Columns>
       <DataGridTextColumn Binding="{Binding Number}" Width="200"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Number], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding Kind, Converter={StaticResource InventoryCaption}, ConverterParameter=INV_Kind_}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_Kind], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding State, Converter={StaticResource InventoryCaption}, ConverterParameter=INV_State_}" Width="100"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Status], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding DateUtc, StringFormat=yyyy-MM-dd}" Width="110"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Date], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       <DataGridTextColumn Binding="{Binding Reason}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Reason], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      </DataGrid.Columns>
     </ux:PetraAccountingDataGrid>
     <WrapPanel Grid.Row="2" Margin="0,6"><Button Style="{StaticResource Am.ActionButton}" Content="{Binding Localization[D_BackToList]}" Command="{Binding BackToListCommand}"/><TextBlock Text="{Binding NumberDisplay}" FontWeight="Bold" VerticalAlignment="Center" Margin="8"/>
      <TextBlock Text="{Binding Localization[INV_ActionReason]}" VerticalAlignment="Center"/><TextBox Text="{Binding ActionReason, UpdateSourceTrigger=PropertyChanged}" Width="240" MaxLength="500"/>
     </WrapPanel>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
      <WrapPanel IsEnabled="{Binding IsEditing}">
       <StackPanel Margin="4"><TextBlock Text="{Binding Localization[INV_KindRequired]}"/><ComboBox Width="180" ItemsSource="{Binding KindOptions}" DisplayMemberPath="Label" SelectedValuePath="Kind" SelectedValue="{Binding Kind}" IsEnabled="{Binding CanChangeKind}"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="{Binding Localization[INV_DateRequired]}"/><ux:PetraDatePicker SelectedDate="{Binding Date}" Width="140"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="{Binding Localization[INV_WarehouseRequired]}"/><ux:LookupPicker Width="220" ItemsSource="{Binding Warehouses}" SelectedId="{Binding WarehouseId}" IsArabic="{Binding Localization.IsRightToLeft}"/></StackPanel>
       <StackPanel Margin="4" Visibility="{Binding IsTransfer, Converter={StaticResource Visible}}"><TextBlock Text="{Binding Localization[INV_TargetRequired]}"/><ux:LookupPicker Width="220" ItemsSource="{Binding Warehouses}" SelectedId="{Binding TargetWarehouseId}" IsArabic="{Binding Localization.IsRightToLeft}"/></StackPanel>
       <Expander Margin="4" Header="{Binding Localization[INV_Center]}" IsExpanded="{Binding IsCostCenterRequired, Mode=OneWay}"><ux:LookupPicker Width="220" ItemsSource="{Binding CostCenters}" SelectedId="{Binding CostCenterId}" IsArabic="{Binding Localization.IsRightToLeft}"/></Expander>
      </WrapPanel>
      <WrapPanel IsEnabled="{Binding IsEditing}" Visibility="{Binding RequiresAccounts, Converter={StaticResource Visible}}">
       <StackPanel Margin="4"><TextBlock Text="{Binding Localization[INV_InventoryAccountRequired]}"/><ux:LookupPicker Width="260" ItemsSource="{Binding Accounts}" SelectedId="{Binding InventoryAccountId}" IsArabic="{Binding Localization.IsRightToLeft}"/></StackPanel>
       <StackPanel Margin="4"><TextBlock Text="{Binding Localization[INV_OffsetRequired]}"/><ux:LookupPicker Width="260" ItemsSource="{Binding Accounts}" SelectedId="{Binding OffsetAccountId}" IsArabic="{Binding Localization.IsRightToLeft}"/></StackPanel>
      </WrapPanel>
      <StackPanel Margin="4" IsEnabled="{Binding IsEditing}"><TextBlock Text="{Binding Localization[INV_ReasonRequired]}"/><TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"/></StackPanel>
      <TextBlock Text="{Binding Localization[INV_LegacyReadOnly]}" Visibility="{Binding Current.IsLegacy, Converter={StaticResource Visible}, FallbackValue=Collapsed}" TextWrapping="Wrap"/><TextBlock Text="{Binding Current.ReverseReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding Current.PostReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding Localization[INV_CountHelp]}" TextWrapping="Wrap" Margin="4"/>
      <WrapPanel><Button Content="{Binding Localization[D_AddLine]}" Command="{Binding AddLineCommand}"/><Button Content="{Binding Localization[D_RemoveLine]}" Command="{Binding RemoveLineCommand}"/></WrapPanel>
      <ux:PetraAccountingDataGrid ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
        IsReadOnly="{Binding IsEntryReadOnly}" MinHeight="150" ux:GridRowNumbers.Enabled="True" ux:GridEntry.Enabled="True" ux:GridRowContext.Enabled="True">
       <DataGrid.InputBindings><KeyBinding Key="Insert" Command="{Binding AddLineCommand}"/><KeyBinding Key="Delete" Modifiers="Control" Command="{Binding RemoveLineCommand}"/></DataGrid.InputBindings>
       <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{Binding Localization[D_AddLine]}" Command="{Binding AddLineCommand}"/><MenuItem Header="{Binding Localization[D_RemoveLine]}" Command="{Binding RemoveLineCommand}"/><MenuItem Header="{Binding Localization[D_CopyCellAbove]}" Command="{x:Static ux:GridEntry.CopyPreviousCell}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></DataGrid.ContextMenu>
       <DataGrid.Columns>
        <DataGridTemplateColumn Width="260"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_ItemRequired], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><ux:LookupPicker ItemsSource="{Binding DataContext.Items, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedId="{Binding ItemId}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}" IsReadOnly="{Binding DataContext.IsEntryReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTemplateColumn Width="160"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_UnitRequired], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><ux:LookupPicker ItemsSource="{Binding DataContext.Units, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedId="{Binding UnitId}" IsArabic="{Binding DataContext.Localization.IsRightToLeft, RelativeSource={RelativeSource AncestorType=UserControl}}" IsReadOnly="{Binding DataContext.IsEntryReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="140"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_QuantityRequired], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="ux:GridEntry.CopyPath" Value="Quantity"/></Style></DataGridTextColumn.ElementStyle><DataGridTextColumn.EditingElementStyle><Style TargetType="TextBox"><Setter Property="ux:GridEntry.CopyPath" Value="Quantity"/></Style></DataGridTextColumn.EditingElementStyle></DataGridTextColumn>
        <DataGridTemplateColumn Width="180"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_OpeningCost], RelativeSource={RelativeSource AncestorType=UserControl}}" TextWrapping="Wrap"/></DataGridTemplateColumn.Header><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding OpeningUnitCost, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding DataContext.IsOpeningCostReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding SnapshotQuantity}" IsReadOnly="True" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_Snapshot], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTextColumn Binding="{Binding Cost}" IsReadOnly="True" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[INV_Cost], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       </DataGrid.Columns>
      </ux:PetraAccountingDataGrid>
     </StackPanel></ScrollViewer>
    </Grid>
   </TabItem>
   <TabItem Header="{Binding Localization[INV_Movements]}">
    <DockPanel>
     <WrapPanel DockPanel.Dock="Top"><ux:LookupPicker Width="220" ItemsSource="{Binding Warehouses}" SelectedId="{Binding FilterWarehouseId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="{Binding Localization[INV_WarehouseRequired]}"/>
      <ux:LookupPicker Width="240" ItemsSource="{Binding Items}" SelectedId="{Binding FilterItemId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="{Binding Localization[INV_ItemRequired]}"/>
      <ux:PetraDatePicker SelectedDate="{Binding FromDate}" Width="130"/><ux:PetraDatePicker SelectedDate="{Binding ToDate}" Width="130"/>
      <Button Content="{Binding Localization[D_Search]}" Command="{Binding LoadMovementsCommand}"/><Button Content="{Binding Localization[INV_OpenSource]}" Command="{Binding OpenSourceCommand}"/>
      <Button Content="←" Command="{Binding PreviousMovementCommand}"/><TextBlock Text="{Binding MovementPageStatus}" VerticalAlignment="Center"/><Button Content="→" Command="{Binding NextMovementCommand}"/>
     </WrapPanel>
     <TextBlock DockPanel.Dock="Bottom" Text="{Binding Localization[INV_LegacyAuditHelp]}" TextWrapping="Wrap"/>
     <ux:PetraAccountingDataGrid ux:GridRowContext.Enabled="True" ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement}" IsReadOnly="True" AutoGenerateColumns="True" AutoGeneratingColumn="AuditColumn" CanUserAddRows="False" ux:GridRowNumbers.Enabled="True"><DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="{Binding Localization[INV_OpenSource]}" Command="{Binding OpenSourceCommand}"/></ContextMenu></DataGrid.ContextMenu><DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenSourceCommand}"/></DataGrid.InputBindings></ux:PetraAccountingDataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="{Binding Localization[INV_Balances]}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="{Binding Localization[INV_BalanceHelp]}" TextWrapping="Wrap"/><ux:PetraAccountingDataGrid ItemsSource="{Binding Balances}" IsReadOnly="True" AutoGenerateColumns="True" AutoGeneratingColumn="AuditColumn" CanUserAddRows="False"/></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>

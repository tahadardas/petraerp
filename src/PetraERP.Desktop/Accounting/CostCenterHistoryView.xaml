<UserControl x:Class="PetraERP.Desktop.Accounting.CostCenterHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <DataTemplate x:Key="HistoryHeader"><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource EnumLabel}" ConverterParameter="D_"><Binding/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=Window}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate>
 </UserControl.Resources>
 <DockPanel Margin="4">
  <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_CostCenterAuditHelp]}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
  <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
   <Button Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource Button.Command}"/>
   <Button Content="{Binding Localization[D_Previous]}" Command="{Binding PreviousHistoryCommand}" Style="{StaticResource Button.Command}"/>
   <Button Content="{Binding Localization[D_Next]}" Command="{Binding NextHistoryCommand}" Style="{StaticResource Button.Command}"/>
   <TextBlock Text="{Binding HistoryPageStatus}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="4"/>
  </WrapPanel>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DataGrid x:Name="CostCenterHistoryGrid" ItemsSource="{Binding History}" SelectedItem="{Binding SelectedHistory}" IsReadOnly="True" CanUserSortColumns="False" SelectionUnit="FullRow" AutomationProperties.Name="{Binding Localization[D_AuditTrail]}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="DateTime" HeaderTemplate="{StaticResource HistoryHeader}" Binding="{Binding OccurredAtUtc, Converter={StaticResource DateText}, ConverterParameter=time}" Width="140"/>
     <DataGridTemplateColumn Header="Action" HeaderTemplate="{StaticResource HistoryHeader}" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource EnumLabel}" ConverterParameter="D_AccountAuditAction_"><Binding Path="Action"/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="UserName" HeaderTemplate="{StaticResource HistoryHeader}" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock ToolTip="{Binding ActorUserId}"><TextBlock.Text><MultiBinding Converter="{StaticResource NameLabel}"><Binding Path="ActorNameArabic"/><Binding Path="ActorNameEnglish"/><Binding Path="DataContext.Localization.IsRightToLeft" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns>
   </DataGrid>
   <StackPanel Grid.Row="1" Margin="0,4">
    <TextBlock Text="{Binding HistoryActor}" Style="{StaticResource Text.Caption}"/>
    <Expander Header="{Binding Localization[D_TechnicalDetails]}"><StackPanel>
     <TextBlock Text="{Binding SelectedHistory.ActorUserId}"/><TextBlock Text="{Binding SelectedHistory.WorkingBranchId}"/>
     <TextBlock Text="{Binding SelectedHistory.EventId}"/><TextBlock Text="{Binding SelectedHistory.CorrelationId}"/>
    </StackPanel></Expander>
   </StackPanel>
   <DataGrid x:Name="CostCenterHistoryFieldsGrid" Grid.Row="2" ItemsSource="{Binding HistoryFields}" IsReadOnly="True" CanUserSortColumns="False" AutomationProperties.Name="{Binding Localization[D_AuditChanges]}">
    <DataGrid.Columns>
     <DataGridTextColumn Header="AuditField" HeaderTemplate="{StaticResource HistoryHeader}" Binding="{Binding Field}" Width="100"/>
     <DataGridTextColumn Header="AuditBefore" HeaderTemplate="{StaticResource HistoryHeader}" Binding="{Binding Before}" Width="*"/>
     <DataGridTextColumn Header="AuditAfter" HeaderTemplate="{StaticResource HistoryHeader}" Binding="{Binding After}" Width="*"/>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
 </DockPanel>
</UserControl>

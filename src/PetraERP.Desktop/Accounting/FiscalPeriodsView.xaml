<UserControl x:Class="PetraERP.Desktop.Accounting.FiscalPeriodsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel>
  <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[D_FiscalPeriods]}">
   <ux:PageHeader.Commands><WrapPanel>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE710;" Content="{Binding Localization[D_NewFiscalYear]}" Command="{Binding StartCreateYearCommand}" Visibility="{Binding CanManage, Converter={StaticResource Visible}}"/>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}"/>
   </WrapPanel></ux:PageHeader.Commands>
  </ux:PageHeader>

  <!-- New fiscal year (monthly periods generated by the server rules) -->
  <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Filter}" Visibility="{Binding IsCreatingYear, Converter={StaticResource Visible}}">
   <WrapPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Localization[D_Code]}" Style="{StaticResource Text.Label}"/><TextBox Width="140" Text="{Binding NewYearCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" FlowDirection="LeftToRight" AutomationProperties.Name="{Binding Localization[D_Code]}"/></StackPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Localization[D_From]}" Style="{StaticResource Text.Label}"/><ux:PetraDatePicker Width="150" SelectedDate="{Binding NewYearStart}" AutomationProperties.Name="{Binding Localization[D_From]}"/></StackPanel>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="{Binding Localization[D_To]}" Style="{StaticResource Text.Label}"/><ux:PetraDatePicker Width="150" SelectedDate="{Binding NewYearEnd}" AutomationProperties.Name="{Binding Localization[D_To]}"/></StackPanel>
    <Button Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE74E;" Content="{Binding Localization[D_CreateFiscalYear]}" Command="{Binding CreateYearCommand}" VerticalAlignment="Bottom"/>
    <Button Style="{StaticResource Button.Command}" Content="{Binding Localization[D_Cancel]}" Command="{Binding CancelCreateYearCommand}" VerticalAlignment="Bottom"/>
    <TextBlock Text="{Binding Localization[D_MonthlyPeriodsHelp]}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
    <TextBlock Text="{Binding NewYearError}" Style="{StaticResource Text.Error}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
   </WrapPanel>
  </Border>

  <ux:AdaptivePaneGrid>
   <ux:AdaptivePaneGrid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="180"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*" MinWidth="360"/><ColumnDefinition Width="8"/><ColumnDefinition Width="380" MinWidth="300"/></ux:AdaptivePaneGrid.ColumnDefinitions>
   <Border ux:AdaptivePaneGrid.Label="{Binding Localization[D_FiscalYears]}" Style="{StaticResource Panel.Flat}"><DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[D_FiscalYears]}" Style="{StaticResource Text.Label}" Margin="10,8,10,4"/>
    <ListBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" AutomationProperties.Name="{Binding Localization[D_FiscalYears]}">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,3">
      <TextBlock Text="{Binding Code}" FontWeight="SemiBold"/>
      <TextBlock Style="{StaticResource Text.Caption}" FlowDirection="LeftToRight" HorizontalAlignment="Left"><Run Text="{Binding RangeStart, Converter={StaticResource DateText}, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding RangeEnd, Converter={StaticResource DateText}, Mode=OneWay}"/></TextBlock>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel></Border>

   <Border ux:AdaptivePaneGrid.Label="{Binding Localization[D_Periods]}" Grid.Column="2" Style="{StaticResource Panel.Flat}">
    <DataGrid ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" IsReadOnly="True" SelectionUnit="FullRow" CanUserSortColumns="False" BorderThickness="0"
              ux:GridLayouts.Key="ledger.periods" ux:GridLayouts.Store="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Localization[D_Periods]}">
     <DataGrid.ContextMenu>
      <ContextMenu>
       <MenuItem Header="{Binding Localization[D_TrialBalance]}" Command="{Binding OpenTrialBalanceCommand}" Visibility="{Binding CanViewTrialBalance, Converter={StaticResource Visible}}"/>
      </ContextMenu>
     </DataGrid.ContextMenu>
     <DataGrid.Columns>
      <DataGridTemplateColumn SortMemberPath="Code" Width="*">
       <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Period], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Number, StringFormat='{}{0:00}'}" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,8,0" FlowDirection="LeftToRight"/>
        <TextBlock Text="{Binding Period.Code}" FontWeight="SemiBold"/>
        <TextBlock Text="●" Foreground="{DynamicResource Accent}" Margin="6,0,0,0" Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}" ToolTip="{Binding DataContext.Localization[D_CurrentPeriod], RelativeSource={RelativeSource AncestorType=UserControl}}"/>
       </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Binding="{Binding Period.RangeStart, Converter={StaticResource DateText}}" SortMemberPath="Start" Width="110"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_From], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding Period.RangeEnd, Converter={StaticResource DateText}}" SortMemberPath="End" Width="110"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_To], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTemplateColumn SortMemberPath="State" Width="140">
       <DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[UX_Status], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><ux:StatusBadge Text="{Binding StateLabel}" Kind="{Binding Kind}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Border>

   <Border ux:AdaptivePaneGrid.Label="{Binding Localization[D_PeriodAudit]}" Grid.Column="4" Style="{StaticResource Panel.Card}">
    <Grid>
     <ux:EmptyState Glyph="&#xE787;" Title="{Binding Localization[D_SelectPeriod]}" Message="{Binding Localization[D_SelectPeriodHelp]}" Visibility="{Binding SelectedPeriod, Converter={StaticResource Show}, ConverterParameter=invert}"/>
     <DockPanel Visibility="{Binding SelectedPeriod, Converter={StaticResource Show}}">
      <StackPanel DockPanel.Dock="Top">
       <DockPanel Margin="0,0,0,10">
        <ux:StatusBadge DockPanel.Dock="Right" Text="{Binding SelectedPeriod.StateLabel}" Kind="{Binding SelectedPeriod.Kind}"/>
        <Button DockPanel.Dock="Right" Margin="8,0" Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE8A5;" Content="{Binding Localization[D_TrialBalance]}" Command="{Binding OpenTrialBalanceCommand}" Visibility="{Binding CanViewTrialBalance, Converter={StaticResource Visible}}"/>
        <TextBlock Text="{Binding SelectedPeriod.Period.Code}" Style="{StaticResource Text.Section}" Margin="0"/>
       </DockPanel>
       <StackPanel Visibility="{Binding HasActions, Converter={StaticResource Visible}}">
        <StackPanel Style="{StaticResource Field}"><TextBlock Text="{Binding Localization[D_ReasonRequired]}" Style="{StaticResource Text.Label}"/>
         <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" TextWrapping="Wrap" MinHeight="48" AutomationProperties.Name="{Binding Localization[D_ReasonRequired]}"/></StackPanel>
        <WrapPanel Margin="0,0,0,10">
         <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72E;" Content="{Binding Localization[D_SoftClosePeriod]}" Command="{Binding SoftCloseCommand}" Visibility="{Binding CanSoftClose, Converter={StaticResource Visible}}"/>
         <Button Style="{StaticResource Button.Danger}" ux:Icon.Glyph="&#xE72E;" Content="{Binding Localization[D_ClosePeriod]}" Command="{Binding CloseCommand}" Visibility="{Binding CanClose, Converter={StaticResource Visible}}"/>
         <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE785;" Content="{Binding Localization[D_ReopenPeriod]}" Command="{Binding ReopenCommand}" Visibility="{Binding CanReopen, Converter={StaticResource Visible}}"/>
        </WrapPanel>
       </StackPanel>
       <TextBlock Text="{Binding Localization[D_PeriodAudit]}" Style="{StaticResource Text.Label}"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Audit}" IsReadOnly="True" CanUserSortColumns="False" SelectionUnit="FullRow" AutomationProperties.Name="{Binding Localization[D_PeriodAudit]}">
       <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding OccurredAtUtc, Converter={StaticResource DateText}, ConverterParameter=time}" Width="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_DateTime], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
        <DataGridTemplateColumn Width="110"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Change], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
         <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock><TextBlock.Text><MultiBinding Converter="{StaticResource EnumLabel}" ConverterParameter="D_PeriodState_"><Binding Path="NewState"/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        <DataGridTextColumn Binding="{Binding Reason}" Width="*"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Reason], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </Grid>
   </Border>
  </ux:AdaptivePaneGrid>
 </DockPanel>
</UserControl>

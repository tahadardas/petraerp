<UserControl x:Class="PetraERP.Desktop.Accounting.GeneralJournalView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
 <DockPanel>
  <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[D_GeneralJournal]}" Subtitle="{Binding Localization[D_GeneralJournalHelp]}"/>
  <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Filter}">
   <WrapPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Localization[D_From]}" Style="{StaticResource Text.Label}"/><ux:PetraDatePicker Width="130" SelectedDate="{Binding FromDate}" AutomationProperties.Name="{Binding Localization[D_From]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Localization[D_To]}" Style="{StaticResource Text.Label}"/><ux:PetraDatePicker Width="130" SelectedDate="{Binding ToDate}" AutomationProperties.Name="{Binding Localization[D_To]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0" Width="230"><TextBlock Text="{Binding Localization[D_Account]}" Style="{StaticResource Text.Label}"/><ux:PetraAccountPicker ItemsSource="{Binding Lookups.Accounts}" SelectedId="{Binding AccountId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="{Binding Localization[D_LookupHint]}" AutomationProperties.Name="{Binding Localization[D_Account]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0" Width="190"><TextBlock Text="{Binding Localization[D_CostCenter]}" Style="{StaticResource Text.Label}"/><ux:LookupPicker ItemsSource="{Binding Lookups.CostCenters}" SelectedId="{Binding CostCenterId}" IsArabic="{Binding Localization.IsRightToLeft}" Placeholder="{Binding Localization[D_LookupHint]}" AutomationProperties.Name="{Binding Localization[D_CostCenter]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Localization[D_JournalState]}" Style="{StaticResource Text.Label}"/><ComboBox Width="130" ItemsSource="{Binding States}" DisplayMemberPath="Label" SelectedItem="{Binding State}" AutomationProperties.Name="{Binding Localization[D_JournalState]}"/></StackPanel>
    <StackPanel Margin="0,0,8,0"><TextBlock Text="{Binding Localization[D_SearchReference]}" Style="{StaticResource Text.Label}"/>
     <ux:PetraSearchBox Width="190" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Placeholder="{Binding Localization[D_SearchReference]}" AutomationProperties.Name="{Binding Localization[D_SearchReference]}"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RunCommand}"/></TextBox.InputBindings></ux:PetraSearchBox></StackPanel>
    <CheckBox Content="{Binding Localization[D_AllBranches]}" IsChecked="{Binding Consolidated}" VerticalAlignment="Bottom" Margin="0,0,10,6" ToolTip="{Binding Localization[D_AllBranchesHelp]}"/>
    <Button Style="{StaticResource Button.Primary}" ux:Icon.Glyph="&#xE768;" Content="{Binding Localization[D_RunReport]}" Command="{Binding RunCommand}" VerticalAlignment="Bottom"/>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE734;" Content="{Binding Localization[UI_SaveFilter]}" Command="{Binding SaveFilterCommand}" VerticalAlignment="Bottom" ToolTip="{Binding Localization[UI_SaveFilterHelp]}"/>
    <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE894;" Content="{Binding Localization[D_ClearFilters]}" Command="{Binding ClearFiltersCommand}" VerticalAlignment="Bottom"/>
   </WrapPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Summary}" Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource Visible}}">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" Command="{Binding PreviousPageCommand}" AutomationProperties.Name="{Binding Localization[D_Previous]}"/>
     <TextBlock Text="{Binding PageStatus}" Style="{StaticResource Text.Caption}" Margin="8,0"/>
     <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" Command="{Binding NextPageCommand}" AutomationProperties.Name="{Binding Localization[D_Next]}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <TextBlock Text="{Binding Localization[D_TotalDebit]}" Style="{StaticResource Text.Label}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalDebit}" Style="{StaticResource Text.NumericTotal}" Margin="0,0,16,0"/>
     <TextBlock Text="{Binding Localization[D_TotalCredit]}" Style="{StaticResource Text.Label}" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding TotalCredit}" Style="{StaticResource Text.NumericTotal}" Margin="0,0,10,0"/>
     <TextBlock Text="{Binding BaseCurrency}" Style="{StaticResource Text.Caption}"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Border Style="{StaticResource Panel.Flat}">
   <Grid>
    <ux:EmptyState Glyph="&#xE8A5;" Title="{Binding Localization[D_NoRows]}" Message="{Binding Localization[D_NoRowsHelp]}" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}"/>
    <ux:EmptyState Glyph="&#xE768;" Title="{Binding Localization[D_RunReportPrompt]}" Visibility="{Binding HasResult, Converter={StaticResource Show}, ConverterParameter=invert}"/>
    <ux:PetraAccountingDataGrid ux:GridRowNumbers.Enabled="True" ItemsSource="{Binding Lines}" SelectedItem="{Binding SelectedLine}" IsReadOnly="True" SelectionUnit="FullRow" CanUserSortColumns="False" BorderThickness="0" MouseDoubleClick="RowOpened"
              Visibility="{Binding Lines.Count, Converter={StaticResource Show}}" ux:GridLayouts.Key="ledger.general-journal" ux:GridLayouts.Store="{Binding DataContext.Workspace, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding Localization[D_GeneralJournal]}">
     <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenJournalCommand}"/></DataGrid.InputBindings>
     <DataGrid.Columns>
      <DataGridTextColumn Binding="{Binding AccountingDate, Converter={StaticResource DateText}}" SortMemberPath="Date" Width="95"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_AccountingDate], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding PostingSequence}" SortMemberPath="Number" Width="70"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_JournalNumber], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding AccountCode}" SortMemberPath="Account" Width="90"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Account], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTemplateColumn SortMemberPath="AccountName" Width="180"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_AccountName], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource NameLabel}"><Binding Path="AccountNameArabic"/><Binding Path="AccountNameEnglish"/><Binding Path="DataContext.Localization.IsRightToLeft" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      <DataGridTextColumn Binding="{Binding LineDescription}" SortMemberPath="Description" Width="*" MinWidth="120"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Description], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding CostCenterCode}" SortMemberPath="CostCenter" Width="90"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_CostCenter], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding BaseDebit, Converter={StaticResource MoneyBlank}}" SortMemberPath="Debit" Width="110" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Debit], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTextColumn Binding="{Binding BaseCredit, Converter={StaticResource MoneyBlank}}" SortMemberPath="Credit" Width="110" ElementStyle="{StaticResource Text.Numeric}"><DataGridTextColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_Credit], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTextColumn.Header></DataGridTextColumn>
      <DataGridTemplateColumn SortMemberPath="State" Width="100"><DataGridTemplateColumn.Header><TextBlock Text="{Binding DataContext.Localization[D_JournalState], RelativeSource={RelativeSource AncestorType=UserControl}}"/></DataGridTemplateColumn.Header>
       <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><TextBlock.Text><MultiBinding Converter="{StaticResource EnumLabel}" ConverterParameter="D_State_"><Binding Path="State"/><Binding Path="DataContext.Localization.Language" RelativeSource="{RelativeSource AncestorType=UserControl}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </ux:PetraAccountingDataGrid>
   </Grid>
  </Border>
 </DockPanel>
</UserControl>

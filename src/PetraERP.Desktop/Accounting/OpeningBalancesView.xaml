<UserControl x:Class="PetraERP.Desktop.Accounting.OpeningBalancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls">
  <DockPanel>
    <ux:PageHeader DockPanel.Dock="Top" Title="{Binding Localization[ACC_OpeningBalances]}">
      <ux:PageHeader.Commands>
        <WrapPanel>
          <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE72C;" Content="{Binding Localization[D_Refresh]}" Command="{Binding RefreshCommand}"/>
          <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE73E;" Content="{Binding Localization[D_Validate]}" Command="{Binding ValidateCommand}" Visibility="{Binding CanValidate, Converter={StaticResource Visible}}"/>
          <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE73E;" Content="{Binding Localization[D_Approve]}" Command="{Binding ApproveCommand}" Visibility="{Binding CanApprove, Converter={StaticResource Visible}}"/>
          <Button Style="{StaticResource Button.Financial}" ux:Icon.Glyph="&#xE74E;" Content="{Binding Localization[D_Post]}" Command="{Binding PostCommand}" Visibility="{Binding CanPost, Converter={StaticResource Visible}}"/>
          <Button Style="{StaticResource Button.Command}" ux:Icon.Glyph="&#xE7A7;" Content="{Binding Localization[D_Reverse]}" Command="{Binding ReverseCommand}" Visibility="{Binding CanReverse, Converter={StaticResource Visible}}"/>
        </WrapPanel>
      </ux:PageHeader.Commands>
    </ux:PageHeader>

    <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Filter}">
      <WrapPanel>
        <StackPanel Margin="0,0,10,0">
          <TextBlock Text="{Binding Localization[D_Reason]}" Style="{StaticResource Text.Label}"/>
          <TextBox Width="260" Text="{Binding ActionReason, UpdateSourceTrigger=PropertyChanged}" MaxLength="200"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Caption}" VerticalAlignment="Bottom" Margin="10,0,0,6"/>
      </WrapPanel>
    </Border>

    <ux:AdaptivePaneGrid>
      <ux:AdaptivePaneGrid.ColumnDefinitions>
        <ColumnDefinition Width="280" MinWidth="220"/>
        <ColumnDefinition Width="8"/>
        <ColumnDefinition Width="*" MinWidth="400"/>
      </ux:AdaptivePaneGrid.ColumnDefinitions>

      <!-- Batches List -->
      <Border ux:AdaptivePaneGrid.Label="{Binding Localization[ACC_OpeningBatches]}" Style="{StaticResource Panel.Flat}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{Binding Localization[ACC_OpeningBatches]}" Style="{StaticResource Text.Label}" Margin="10,8,10,4"/>
          <ListBox ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="4,4">
                  <TextBlock Text="{Binding SourceReference, TargetNullValue='Manual'}" FontWeight="SemiBold"/>
                  <TextBlock Style="{StaticResource Text.Caption}">
                    <Run Text="{Binding OpeningDate, Mode=OneWay}"/>
                    <Run Text=" — "/>
                    <Run Text="{Binding SourceType}"/>
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="{Binding TotalDebitBase}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding BaseCurrency}" Style="{StaticResource Text.Caption}"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Batch Lines Details -->
      <Border ux:AdaptivePaneGrid.Label="{Binding Localization[D_Lines]}" Grid.Column="2" Style="{StaticResource Panel.Flat}">
        <DockPanel>
          <!-- Summary header -->
          <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Summary}" Margin="0,0,0,8" Visibility="{Binding HasSelectedBatch, Converter={StaticResource Visible}}">
            <WrapPanel>
              <StackPanel Margin="0,0,16,4">
                <TextBlock Text="{Binding Localization[D_TotalDebit]}" Style="{StaticResource Text.Label}"/>
                <TextBlock Text="{Binding SelectedBatch.TotalDebitBase}" Style="{StaticResource Text.NumericTotal}"/>
              </StackPanel>
              <StackPanel Margin="0,0,16,4">
                <TextBlock Text="{Binding Localization[D_TotalCredit]}" Style="{StaticResource Text.Label}"/>
                <TextBlock Text="{Binding SelectedBatch.TotalCreditBase}" Style="{StaticResource Text.NumericTotal}"/>
              </StackPanel>
              <StackPanel Margin="0,0,16,4">
                <TextBlock Text="{Binding Localization[D_Status]}" Style="{StaticResource Text.Label}"/>
                <TextBlock Text="{Binding SelectedBatch.ApprovalState}" FontWeight="SemiBold"/>
              </StackPanel>
            </WrapPanel>
          </Border>

          <DataGrid ItemsSource="{Binding SelectedBatch.Lines}" IsReadOnly="True" SelectionUnit="FullRow" CanUserSortColumns="False" BorderThickness="0">
            <DataGrid.Columns>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_Account], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding AccountCode}" Width="100"/>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_Name], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding AccountNameArabic}" Width="*"/>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_Currency], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding CurrencyCode}" Width="60"/>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_DebitOriginal], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding DebitOriginal}" Width="100" ElementStyle="{StaticResource Text.Numeric}"/>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_CreditOriginal], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding CreditOriginal}" Width="100" ElementStyle="{StaticResource Text.Numeric}"/>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_DebitBase], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding DebitBase}" Width="100" ElementStyle="{StaticResource Text.Numeric}"/>
              <DataGridTextColumn Header="{Binding DataContext.Localization[D_CreditBase], RelativeSource={RelativeSource AncestorType=UserControl}}" Binding="{Binding CreditBase}" Width="100" ElementStyle="{StaticResource Text.Numeric}"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </ux:AdaptivePaneGrid>
  </DockPanel>
</UserControl>

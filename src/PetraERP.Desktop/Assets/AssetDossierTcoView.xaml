<UserControl x:Class="PetraERP.Desktop.Assets.AssetDossierTcoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             xmlns:ast="clr-namespace:PetraERP.Desktop.Assets"
             Background="{DynamicResource Surface.Secondary}">

    <DockPanel LastChildFill="True">
        <!-- 1. Header & Asset Selector -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="تقرير ملف الآلية الشامل وتكلفة الامتلاك (TCO)" Style="{StaticResource Text.Title}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="اختر الأصل / الآلية:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="260" Height="28" ItemsSource="{Binding AssetsList}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="NameArabic" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Command}" Content="تحديث البيانات" Command="{Binding RefreshReportCommand}" ux:Icon.Glyph="&#xE72C;"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <!-- 2. Four Key Financial Cards -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Capital & Purchase -->
                    <Border Grid.Column="0" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="1. التكلفة الرأسمالية للشراء" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DossierReport.TotalCapitalCost, StringFormat={}{0:N2} ر.س}" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding DossierReport.PurchaseDate, StringFormat={}تاريخ الشراء: {0:yyyy/MM/dd}}" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Depreciation & Book Value -->
                    <Border Grid.Column="2" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="2. صافي القيمة الدفترية" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DossierReport.CurrentNetBookValue, StringFormat={}{0:N2} ر.س}" FontSize="20" FontWeight="Bold" Foreground="#0284C7" Margin="0,6,0,4"/>
                            <TextBlock Text="{Binding DossierReport.AccumulatedDepreciation, StringFormat={}مجمع الاهتلاك: ({0:N0})}" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Total Maintenance & Operating Expenses -->
                    <Border Grid.Column="4" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="3. إجمالي الصيانة والتشغيل" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DossierReport.TotalOperatingCost, StringFormat={}{0:N2} ر.س}" FontSize="20" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,4"/>
                            <TextBlock Text="زيوت + صيانة + قطع + مازوت" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 4: Grand TCO -->
                    <Border Grid.Column="6" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="4. إجمالي تكلفة الامتلاك (TCO)" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DossierReport.GrandTotalCostOfOwnership, StringFormat={}{0:N2} ر.س}" FontSize="20" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,4"/>
                            <TextBlock Text="شراء + كافة مصاريف التشغيل" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Operational & Efficiency KPIs -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="العداد الكلي المسجل:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding DossierReport.TotalMeterRecorded, StringFormat={}{0:N0} وحدة}" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="معدل تكلفة ساعة/كم التشغيل:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding DossierReport.OperatingCostPerUnit, StringFormat={}{0:N2} ر.س / وحدة}" FontSize="16" FontWeight="Bold" Foreground="#059669" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="أيام التوقف عن العمل (Downtime):" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding DossierReport.TotalDowntimeDays, StringFormat={}{0} أيام}" FontSize="16" FontWeight="Bold" Foreground="#DC2626" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="موعد الصيانة الدورية القادم:" Foreground="#64748B" FontSize="12"/>
                            <TextBlock Text="{Binding DossierReport.MeterRemainingToService, StringFormat={}باقي {0:N0} وحدة}" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4. Expense Breakdown Table -->
                <Border Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="تحليل وتفصيل كافة المصروفات التشغيلية للآلية" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding ExpenseCategories}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Style="{StaticResource {x:Type DataGrid}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="فئة المصروف والتشغيل" Binding="{Binding CategoryName}" Width="280"/>
                                <DataGridTextColumn Header="عدد الحركات" Binding="{Binding TransactionCount}" Width="120"/>
                                <DataGridTextColumn Header="المبلغ الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ر.س}" Width="180"/>
                                <DataGridTextColumn Header="النسبة من التشغيل" Binding="{Binding PercentageOfOperatingCost, StringFormat={}{0:N1} %}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

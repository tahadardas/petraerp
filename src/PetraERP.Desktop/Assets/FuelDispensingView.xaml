<UserControl x:Class="PetraERP.Desktop.Assets.FuelDispensingView"
             x:Name="rootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             xmlns:ast="clr-namespace:PetraERP.Desktop.Assets"
             Background="{DynamicResource Surface.Secondary}">

    <UserControl.InputBindings>
        <KeyBinding Key="Insert" Command="{Binding AddRowCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveVoucherCommand}"/>
    </UserControl.InputBindings>

    <DockPanel LastChildFill="True">
        <!-- 1. Header & Actions -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="سند صرف وتوزيع مازوت ووقود للآليات" Style="{StaticResource Text.Title}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ux:StatusBadge Text="حسم آلي من الخزان بالتكلفة الوسطية" Kind="Success" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Command}" Content="إضافة آلية (Insert)" Command="{Binding AddRowCommand}" Margin="0,0,6,0" ux:Icon.Glyph="&#xE710;"/>
                    <Button Style="{StaticResource Am.PrimaryActionButton}" Content="حفظ وصرف من المخزون (Ctrl+S)" Command="{Binding SaveVoucherCommand}" Margin="0,0,6,0" ux:Icon.Glyph="&#xE74E;"/>
                    <Button Style="{StaticResource Am.CloseActionButton}" Content="تفريغ" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Tank / Fuel Warehouse Selector Bar -->
        <Border DockPanel.Dock="Top" Background="#F8FAFC" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="مستودع / خزان الوقود:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding FuelWarehouses}" SelectedItem="{Binding SelectedWarehouse}" DisplayMemberPath="Name" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <!-- Live Tank Stock & Moving Average Cost Pills -->
                <Border Grid.Column="2" Background="#E0F2FE" CornerRadius="4" Padding="10,4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الرصيد المتوفر بالخزان: " Foreground="#0369A1" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentWarehouseStockLiters, StringFormat={}{0:N0} لتر}" FontWeight="Bold" Foreground="#0284C7"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#FEF3C7" CornerRadius="4" Padding="10,4" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="السعر الوسطي المتحرك: " Foreground="#B45309" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding MovingAverageCost, StringFormat={}{0:N2} / لتر}" FontWeight="Bold" Foreground="#D97706"/>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Column="4" Text="رقم السند:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="5" Text="{Binding VoucherNumber}" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="6" Text="مسؤول التعبئة:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="7" Text="{Binding DispenserName}" Height="28" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. Totals and Arabic Tafqeet Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="القيمة الإجمالية تفقيطاً: " Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GrandTotalCostWords}" Foreground="#0F172A" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="إجمالي اللترات المصروفة: " Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalLitersIssued, StringFormat={}{0:N1} لتر}" FontSize="16" FontWeight="Bold" Foreground="#0284C7"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي التكلفة المخزنية: " Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding GrandTotalCost, StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#059669"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Dispensing Rows Grid -->
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Margin="8" Style="{StaticResource {x:Type DataGrid}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="الآلية / المعدة *"
                                        ItemsSource="{Binding Source={x:Reference Name=rootControl}, Path=DataContext.MachineryAssets}"
                                        SelectedItemBinding="{Binding Asset}"
                                        DisplayMemberPath="NameArabic"
                                        Width="220"/>
                <DataGridTextColumn Header="السائق / المشغّل" Binding="{Binding DriverOrOperator}" Width="140"/>
                <DataGridTextColumn Header="العداد السابق" Binding="{Binding PreviousMeterReading, StringFormat={}{0:N0}}" Width="95" IsReadOnly="True"/>
                <DataGridTextColumn Header="العداد الحالي *" Binding="{Binding CurrentMeterReading, StringFormat={}{0:N0}, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                <DataGridTextColumn Header="الكمية (لتر) *" Binding="{Binding LitersIssued, StringFormat={}{0:N1}, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="سعر اللتر (تلقائي)" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="معدل الاستهلاك" Binding="{Binding ConsumptionRate, StringFormat={}{0:N2}}" Width="110" IsReadOnly="True"/>
                <DataGridCheckBoxColumn Header="تنبيه هدر/سرقة" Binding="{Binding HasExcessAlert}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="200"/>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="حذف" Style="{StaticResource Am.CloseActionButton}" Padding="4,2"
                                    Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Assets.AssetCustodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             xmlns:ast="clr-namespace:PetraERP.Desktop.Assets"
             Background="{DynamicResource Surface.Secondary}">

    <DockPanel LastChildFill="True">
        <!-- 1. Header & Actions -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="محاضر ومذكرات استلام وتسليم العهد" Style="{StaticResource Text.Title}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ux:StatusBadge Text="نموذج قانوني وفني موحد" Kind="Info" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Command}" Content="معاينة وطباعة المحضر" Command="{Binding GenerateCertificateCommand}" Margin="0,0,6,0" ux:Icon.Glyph="&#xE749;"/>
                    <Button Style="{StaticResource Am.PrimaryActionButton}" Content="حفظ واعتماد العهدة" Command="{Binding SaveVoucherCommand}" Margin="0,0,6,0" ux:Icon.Glyph="&#xE74E;"/>
                    <Button Style="{StaticResource Am.CloseActionButton}" Content="تفريغ" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Two Column Layout: Left Form, Right Preview/History -->
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Handover Details Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Border Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="16">
                    <StackPanel>
                        <TextBlock Text="بيانات السند والحركة" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم السند:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding VoucherNumber}" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="التاريخ:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding TransactionDate}" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نوع الحركة:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding HandoverType, Mode=TwoWay}" Height="28" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="تسليم عهدة جديد" Tag="{x:Static ast:CustodyHandoverType.NewAssignment}" IsSelected="True"/>
                                <ComboBoxItem Content="نقل عهدة من موظف لآخر" Tag="{x:Static ast:CustodyHandoverType.CustodyTransfer}"/>
                                <ComboBoxItem Content="استرداد عهدة للمستودع (براءة ذمة)" Tag="{x:Static ast:CustodyHandoverType.ReturnToWarehouse}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="0,8,0,12"/>
                        <TextBlock Text="الأصل المسلّم" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اختر الأصل:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MovableAssets}" SelectedItem="{Binding SelectedAsset}" DisplayMemberPath="NameArabic" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="السيريال / اللوحة:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding SerialNumber}" Height="28" VerticalContentAlignment="Center" IsReadOnly="True" Background="#F8FAFC"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الحالة الفنية:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" SelectedValuePath="Tag" SelectedValue="{Binding Condition, Mode=TwoWay}" Height="28" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="جديد تماماً (Brand New)" Tag="{x:Static ast:AssetConditionRating.BrandNew}" IsSelected="True"/>
                                <ComboBoxItem Content="ممتاز (Excellent)" Tag="{x:Static ast:AssetConditionRating.Excellent}"/>
                                <ComboBoxItem Content="جيد (Good)" Tag="{x:Static ast:AssetConditionRating.Good}"/>
                                <ComboBoxItem Content="يحتاج صيانة (Needs Maintenance)" Tag="{x:Static ast:AssetConditionRating.NeedsMaintenance}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Margin="0,8,0,12"/>
                        <TextBlock Text="بيانات المستلم وبراءة الذمة" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="اسم المستلم *:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CustodianName, UpdateSourceTrigger=PropertyChanged}" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الرقم الوظيفي:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding EmployeeCode}" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="القسم / الموقع:" Style="{StaticResource Text.Label}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DepartmentOrSite}" Height="28" VerticalContentAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الملحقات:" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" Text="{Binding AccessoriesChecklist}" Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الإقرار القانوني:" Style="{StaticResource Text.Label}" VerticalAlignment="Top" Margin="0,4,0,0"/>
                            <TextBox Grid.Column="1" Text="{Binding LegalDeclarationText}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Background="#FFFBEB"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Right: Preview of Universal Handover Certificate / History -->
            <Border Grid.Column="2" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="1" CornerRadius="6" Padding="14">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="معاينة محضر الاستلام والتسليم الرسمي الشامل" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox Text="{Binding GeneratedCertificateText}" IsReadOnly="True" FontFamily="Consolas, Courier New" FontSize="12" Background="#F8FAFC" Padding="14" BorderThickness="1" BorderBrush="#CBD5E1"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="PetraERP.Desktop.Assets.FleetExpenseJournalView"
             x:Name="rootControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ux="clr-namespace:PetraERP.Desktop.Controls"
             xmlns:ast="clr-namespace:PetraERP.Desktop.Assets"
             Background="{DynamicResource Surface.Secondary}">

    <UserControl.InputBindings>
        <KeyBinding Key="Insert" Command="{Binding AddRowCommand}"/>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveBatchCommand}"/>
    </UserControl.InputBindings>

    <DockPanel LastChildFill="True">
        <!-- 1. Header & Actions -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="دفتر يومية مصاريف وصيانة الآليات والمركبات" Style="{StaticResource Text.Title}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ux:StatusBadge Text="سريع بنمط دفتر القيد" Kind="Info" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Command}" Content="إضافة سطر جديد (Insert)" Command="{Binding AddRowCommand}" Margin="0,0,6,0" ux:Icon.Glyph="&#xE710;"/>
                    <Button Style="{StaticResource Am.PrimaryActionButton}" Content="حفظ وترحيل القيد (Ctrl+S)" Command="{Binding SaveBatchCommand}" Margin="0,0,6,0" ux:Icon.Glyph="&#xE74E;"/>
                    <Button Style="{StaticResource Am.CloseActionButton}" Content="تفريغ" Command="{Binding ClearCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Document Header Info -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="رقم السند:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" Text="{Binding VoucherNumber}" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="2" Text="التاريخ:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker Grid.Column="3" SelectedDate="{Binding TransactionDate}" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0"/>

                <TextBlock Grid.Column="4" Text="حساب الدفع الافتراضي:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="5" ItemsSource="{Binding PaymentAccounts}" SelectedItem="{Binding SelectedDefaultAccount}" DisplayMemberPath="Name" Height="28" VerticalContentAlignment="Center" Margin="0,0,16,0" ToolTip="العهدة النقدية أو الصندوق الافتراضي لتخريج المصاريف"/>

                <TextBlock Grid.Column="6" Text="البيان العام:" Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="7" Text="{Binding Notes}" Height="28" VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 3. Totals and Arabic Tafqeet Bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface.Primary}" BorderBrush="{DynamicResource Border.Normal}" BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="المبلغ تفقيطاً: " Foreground="#64748B" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalAmountWords}" Foreground="#0F172A" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إجمالي المصروفات: " Style="{StaticResource Text.Label}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N2} ر.س}" FontSize="18" FontWeight="Bold" Foreground="#059669"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. Fast Entry DataGrid -->
        <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" Margin="8" Style="{StaticResource {x:Type DataGrid}}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="40" IsReadOnly="True"/>
                <DataGridComboBoxColumn Header="الآلية / الأصل *"
                                        ItemsSource="{Binding Source={x:Reference Name=rootControl}, Path=DataContext.AvailableAssets}"
                                        SelectedItemBinding="{Binding Asset}"
                                        DisplayMemberPath="NameArabic"
                                        Width="200"/>
                <DataGridTextColumn Header="المبلغ *" Binding="{Binding Amount, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                <DataGridTextColumn Header="قراءة العداد" Binding="{Binding CurrentMeterReading, StringFormat={}{0:N0}}" Width="100"/>
                <DataGridTextColumn Header="البيان والتفاصيل *" Binding="{Binding Description}" Width="250"/>
                <DataGridTextColumn Header="حساب الدفع المحدد" Binding="{Binding PaymentAccountName}" Width="160"/>
                <DataGridTextColumn Header="رقم الفاتورة / الورشة" Binding="{Binding InvoiceRef}" Width="130"/>
                <DataGridCheckBoxColumn Header="رسملة للأصل" Binding="{Binding IsCapitalized}" Width="85"/>
                <DataGridTemplateColumn Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="حذف" Style="{StaticResource Am.CloseActionButton}" Padding="4,2"
                                    Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Loads a read-only Al-Ameen CSV export (DB_xxxx\DATA\dbo__*.csv.gz) into a SQL Server database so the
    Al-Ameen import engine can read it exactly as it would read a restored Al-Ameen database.
    Standalone on purpose (see the empty Directory.Build.props / Directory.Packages.props next to it).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AlAmeenCsvLoader</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
  </ItemGroup>
</Project>
